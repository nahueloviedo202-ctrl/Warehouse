    "review_slider_aCRFCD": {
      "type": "review-slider",
      "blocks": {
        "review_4QyrdN": {
          "type": "review",
          "settings": {
            "text": "\"I used to spend at least $7 every morning at local coffee shops in downtown Toronto. The Ninja Luxe Mini paid for itself in under two months. The espresso pulls have an incredible golden crema layer, and the Barista Assist made dialing in the right extraction effortless.\"",
            "avatar": "shopify://shop_images/31.jpg",
            "author": "Liam T. — Toronto, ON",
            "rating": 5
          }
        },
        "review_LiEdAc": {
          "type": "review",
          "settings": {
            "text": "\"Having smooth cold brew ready in less than 3 minutes without soaking grounds overnight has completely upgraded our afternoons. We go from morning double espressos to iced drinks in seconds with zero mess on the counter.\"",
            "avatar": "shopify://shop_images/90.jpg",
            "author": "Marcus K. — Vancouver, BC",
            "rating": 5
          }
        },
        "review_itcKff": {
          "type": "review",
          "settings": {
            "text": "\"The automated milk frother is genuinely impressive. I strictly use oat milk, and most home steam wands just scorch it. This machine creates silky, microfoam texture that holds up for latte art every single time. It also tucks neatly under low kitchen cabinets.\"",
            "avatar": "shopify://shop_images/95.jpg",
            "author": "Sophie B. — Montreal, QC",
            "rating": 5
          }
        },
        "review_BWnikE": {
          "type": "review",
          "settings": {
            "text": "\"Counter space in our condo is tight, so the compact footprint was the biggest selling point. Setup took five minutes, it plugs right into standard wall outlets, and cleaning the portafilter takes seconds. Essential gear for Canadian winters.\"",
            "avatar": "shopify://shop_images/18.jpg",
            "author": "Chloe R. — Calgary, AB",
            "rating": 5
          }
        }
      },
      "block_order": [
        "review_4QyrdN",
