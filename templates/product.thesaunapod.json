    "cambios_reales_jtNb4Q": {
      "type": "cambios-reales",
      "blocks": {
        "review_AJff48": {
          "type": "review",
          "settings": {
            "image": "shopify://shop_images/Screenshot_2025-09-03_at_19.52.54.webp",
            "text": "\"After training for a half-marathon, contrast therapy has become my secret weapon. The Sauna Pod's consistent 85°C dry heat is perfect, and the instant cold plunge in the FREE Ice Pod is exactly what my muscles need to bounce back. The bundled value is absolutely incredible.\"",
            "author": "Chloe R. — Montreal, QC[cite: 26]",
            "rating": 5
          }
        },
        "review_c3nXpd": {
          "type": "review",
          "settings": {
            "image": "shopify://shop_images/bhJT-SAwS_mid.webp",
            "text": "\"I do intense gym workouts and hockey 4 times a week. The Sauna Pod heats up to a blazing 85°C faster than I expected, and stepping straight into the Ice Pod afterward has completely eliminated my next-day soreness. Best recovery investment I've made.\"",
            "author": "Marc D. — Calgary, AB",
            "rating": 5
          }
        },
        "review_BfDVY4": {
          "type": "review",
          "settings": {
            "image": "shopify://shop_images/2yi32fozr_mid.webp",
            "text": "\"Was nervous about setting it up in my garage during an Ontario winter, but the 1500W heater holds high heat easily without issues. Zero plastic smells right out of the box thanks to the thick cotton canvas. Getting the Ice Pod for free made this deal unbeatable.\"",
            "author": "Sarah P. — Toronto, ON",
            "rating": 5
          }
        },
        "review_7zD7gm": {
          "type": "review",
          "settings": {
            "image": "shopify://shop_images/xWHOFZfDx_mid.webp",
            "text": "\"I'm 6'4\" (193 cm) and fit comfortably on the folding chair with head clearance to spare. Doing 20 minutes in the dry heat with the red light on, followed by a 2-minute plunge, knocked my stress levels down and gave me the best sleep of my life.\"",
            "author": "David M. — Vancouver, BC",
            "rating": 5
          }
        }
      },
