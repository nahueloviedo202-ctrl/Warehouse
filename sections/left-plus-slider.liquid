{{ 'section-left-plus-slider.css' | asset_url | stylesheet_tag }}
<link rel="stylesheet" href="{{ 'component-slider.css' | asset_url }}" media="print" onload="this.media='all'">
<noscript>{{ 'component-slider.css' | asset_url | stylesheet_tag }}</noscript>

{%- liquid
  assign slide_blocks   = section.blocks | where: 'type', 'slide'
  assign feature_blocks = section.blocks | where: 'type', 'feature'

  if section.settings.layout == 'text_right'
    assign layout_class = 'lps-grid--text-right'
  else
    assign layout_class = 'lps-grid--text-left'
  endif

  case section.settings.image_ratio
    when 'square'
      assign slide_ratio = '1 / 1'
    when 'portrait'
      assign slide_ratio = '3 / 4'
    when 'landscape'
      assign slide_ratio = '4 / 3'
    when 'tall'
      assign slide_ratio = '2 / 3'
    else
      assign slide_ratio = '4 / 5'
  endcase
-%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  #shopify-section-{{ section.id }} {
    --lps-arrow-color: {{ section.settings.arrow_color }};
    --lps-dot-active-color: {{ section.settings.dot_color }};
    --lps-gap: {{ section.settings.columns_gap }}px;
    --lps-slide-gap: {{ section.settings.slide_gap }}px;
    --lps-slide-radius: {{ section.settings.slide_radius }}px;
    --lps-slide-ratio: {{ slide_ratio }};
    --lps-features-gap: {{ section.settings.features_gap }}px;
    --lps-icon-size: {{ section.settings.icon_size }}px;
    --lps-left-ratio: {{ section.settings.left_column_width }}%;
    --lps-slides-visible: {{ section.settings.slides_mobile }};
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} {
      --lps-slides-visible: {{ section.settings.slides_tablet }};
    }
  }

  @media screen and (min-width: 990px) {
    #shopify-section-{{ section.id }} {
      --lps-slides-visible: {{ section.settings.slides_desktop }};
    }
  }

  .section-{{ section.id }}-eyebrow {
    font-size: {{ section.settings.eyebrow_font_size_mobile }}px;
  }

  .section-{{ section.id }}-heading {
    font-size: {{ section.settings.heading_font_size_mobile }}px;
  }

  .section-{{ section.id }}-description {
    font-size: {{ section.settings.description_font_size_mobile }}px;
  }

  @media screen and (min-width: 990px) {
    .section-{{ section.id }}-eyebrow {
      font-size: {{ section.settings.eyebrow_font_size_desktop }}px;
    }

    .section-{{ section.id }}-heading {
      font-size: {{ section.settings.heading_font_size_desktop }}px;
    }

    .section-{{ section.id }}-description {
      font-size: {{ section.settings.description_font_size_desktop }}px;
    }
  }
{%- endstyle -%}

<div
  class="lps-section color-{{ section.settings.color_scheme }} gradient"
  {% if section.settings.background_color != blank %}
    style="background-color: {{ section.settings.background_color }};"
  {% endif %}
>
  <div class="page-width section-{{ section.id }}-padding">
    <div class="lps-grid {{ layout_class }}">

      {%- comment -%} ── Content column ── {%- endcomment -%}
      <div class="lps-content">

        {%- if section.settings.eyebrow != blank -%}
          <p
            class="lps-eyebrow section-{{ section.id }}-eyebrow"
            style="
              {%- if section.settings.eyebrow_color != blank -%}color: {{ section.settings.eyebrow_color }};{%- endif -%}
              {%- if section.settings.eyebrow_font_weight != blank -%}font-weight: {{ section.settings.eyebrow_font_weight }};{%- endif -%}
            "
          >
            {{ section.settings.eyebrow | escape }}
          </p>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h2
            class="lps-heading {{ section.settings.heading_size }} section-{{ section.id }}-heading"
            style="
              {%- if section.settings.heading_color != blank -%}color: {{ section.settings.heading_color }};{%- endif -%}
              {%- if section.settings.heading_font_weight != blank -%}font-weight: {{ section.settings.heading_font_weight }};{%- endif -%}
            "
          >
            {{ section.settings.heading | escape }}
          </h2>
        {%- endif -%}

        {%- if section.settings.description != blank -%}
          <div
            class="lps-description rte section-{{ section.id }}-description"
            style="
              {%- if section.settings.description_color != blank -%}color: {{ section.settings.description_color }};{%- endif -%}
              {%- if section.settings.description_font_weight != blank -%}font-weight: {{ section.settings.description_font_weight }};{%- endif -%}
            "
          >
            {{ section.settings.description }}
          </div>
        {%- endif -%}

        {%- if feature_blocks.size > 0 -%}
          <ul class="lps-features" role="list">
            {%- for block in feature_blocks -%}
              {%- style -%}
                .block-{{ block.id }}-title { font-size: {{ block.settings.heading_font_size_mobile }}px; }
                .block-{{ block.id }}-desc  { font-size: {{ block.settings.text_font_size_mobile }}px; }
                @media screen and (min-width: 990px) {
                  .block-{{ block.id }}-title { font-size: {{ block.settings.heading_font_size_desktop }}px; }
                  .block-{{ block.id }}-desc  { font-size: {{ block.settings.text_font_size_desktop }}px; }
                }
              {%- endstyle -%}
              <li class="lps-feature" {{ block.shopify_attributes }}>
                {%- if block.settings.icon != 'none' or block.settings.icon_image != blank -%}
                  <span
                    class="lps-feature__icon"
                    aria-hidden="true"
                    style="
                      {%- if block.settings.icon_color != blank -%}
                        color: {{ block.settings.icon_color }};
                      {%- elsif section.settings.icon_color != blank -%}
                        color: {{ section.settings.icon_color }};
                      {%- endif -%}
                    "
                  >
                    {%- if block.settings.icon_image != blank -%}
                      {{
                        block.settings.icon_image
                        | image_url: width: 96
                        | image_tag: loading: 'lazy', width: '24', height: '24'
                      }}
                    {%- else -%}
                      {%- render 'icon-accordion', icon: block.settings.icon -%}
                    {%- endif -%}
                  </span>
                {%- endif -%}
                <div class="lps-feature__text">
                  {%- if block.settings.heading != blank -%}
                    <p
                      class="lps-feature__title block-{{ block.id }}-title"
                      style="
                        {%- if block.settings.heading_color != blank -%}color: {{ block.settings.heading_color }};{%- endif -%}
                        {%- if block.settings.heading_font_weight != blank -%}font-weight: {{ block.settings.heading_font_weight }};{%- endif -%}
                      "
                    >
                      {{ block.settings.heading | escape }}
                    </p>
                  {%- endif -%}
                  {%- if block.settings.text != blank -%}
                    <p
                      class="lps-feature__desc block-{{ block.id }}-desc"
                      style="
                        {%- if block.settings.text_color != blank -%}color: {{ block.settings.text_color }};{%- endif -%}
                        {%- if block.settings.text_font_weight != blank -%}font-weight: {{ block.settings.text_font_weight }};{%- endif -%}
                      "
                    >
                      {{ block.settings.text | escape }}
                    </p>
                  {%- endif -%}
                </div>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}

        {%- if section.settings.button_label != blank -%}
          <div class="lps-button-wrapper">
            <a
              href="{{ section.settings.button_link | default: '#' }}"
              class="button{% if section.settings.button_style == 'secondary' %} button--secondary{% elsif section.settings.button_style == 'tertiary' %} button--tertiary{% endif %}"
              {% if section.settings.button_link == blank %}
                role="link" aria-disabled="true"
              {% endif %}
            >
              {{ section.settings.button_label | escape }}
            </a>
          </div>
        {%- endif -%}

      </div>

      {%- comment -%} ── Slider column ── {%- endcomment -%}
      <div class="lps-slider-col">
        <slider-component
          class="lps-slider-component"
          id="lps-component-{{ section.id }}"
        >

          {%- if section.settings.show_arrows -%}
            <button
              type="button"
              class="slider-button slider-button--prev"
              name="previous"
              aria-label="{{ 'general.slider.previous_slide' | t }}"
              aria-controls="Slider-{{ section.id }}"
            >
              {%- render 'icon-caret' -%}
            </button>
          {%- endif -%}

          <ul
            id="Slider-{{ section.id }}"
            class="lps-slider-list slider slider--everywhere"
            role="list"
          >
            {%- for block in slide_blocks -%}
              <li
                id="Slide-{{ section.id }}-{{ forloop.index }}"
                class="lps-slide slider__slide"
                role="group"
                aria-roledescription="{{ 'sections.slideshow.slide' | t }}"
                aria-label="{{ forloop.index }} {{ 'general.slider.of' | t }} {{ forloop.length }}"
                {{ block.shopify_attributes }}
              >
                <div class="lps-slide__media">
                  {%- if block.settings.image != blank -%}
                    {{
                      block.settings.image
                      | image_url: width: 1100
                      | image_tag:
                        loading: 'lazy',
                        sizes: '(min-width: 990px) 50vw, 90vw',
                        widths: '375, 550, 750, 900, 1100',
                        alt: block.settings.image.alt | escape
                    }}
                  {%- else -%}
                    {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                  {%- endif -%}
                </div>
                {%- if block.settings.label != blank -%}
                  <p
                    class="lps-slide__label"
                    style="{%- if block.settings.label_color != blank -%}color: {{ block.settings.label_color }};{%- endif -%}"
                  >
                    {{ block.settings.label | escape }}
                  </p>
                {%- endif -%}
              </li>
            {%- else -%}
              <li class="lps-slide slider__slide">
                <div class="lps-slide__media">
                  {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                </div>
              </li>
              <li class="lps-slide slider__slide">
                <div class="lps-slide__media">
                  {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                </div>
              </li>
            {%- endfor -%}
          </ul>

          {%- if section.settings.show_arrows -%}
            <button
              type="button"
              class="slider-button slider-button--next"
              name="next"
              aria-label="{{ 'general.slider.next_slide' | t }}"
              aria-controls="Slider-{{ section.id }}"
            >
              {%- render 'icon-caret' -%}
            </button>
          {%- endif -%}

        </slider-component>

        {%- if section.settings.show_dots and slide_blocks.size > 1 -%}
          <div
            class="lps-dots"
            id="lps-dots-{{ section.id }}"
            aria-hidden="true"
          >
            {%- for block in slide_blocks -%}
              <button
                class="lps-dot{% if forloop.first %} lps-dot--active{% endif %}"
                data-index="{{ forloop.index0 }}"
                tabindex="-1"
              ></button>
            {%- endfor -%}
          </div>
        {%- endif -%}

      </div>
    </div>
  </div>
</div>

{%- if section.settings.show_dots and slide_blocks.size > 1 -%}
  <script>
    (function () {
      var slider = document.getElementById('Slider-{{ section.id }}');
      var dotsEl = document.getElementById('lps-dots-{{ section.id }}');
      if (!slider || !dotsEl) return;
      var dots   = Array.from(dotsEl.querySelectorAll('.lps-dot'));
      var slides = Array.from(slider.querySelectorAll('.lps-slide'));

      function updateDots () {
        var center = slider.scrollLeft + slider.offsetWidth / 2;
        var active = 0;
        slides.forEach(function (slide, i) {
          if (slide.offsetLeft + slide.offsetWidth / 2 <= center) active = i;
        });
        dots.forEach(function (dot, i) {
          dot.classList.toggle('lps-dot--active', i === active);
        });
      }

      slider.addEventListener('scroll', updateDots, { passive: true });

      dots.forEach(function (dot, i) {
        dot.addEventListener('click', function () {
          var target = slides[i];
          if (!target) return;
          slider.scrollTo({ left: target.offsetLeft, behavior: 'smooth' });
        });
      });
    })();
  </script>
{%- endif -%}

{%- if section.settings.autoplay and slide_blocks.size > 1 -%}
  <script>
    (function () {
      var sectionEl = document.getElementById('shopify-section-{{ section.id }}');
      if (!sectionEl) return;
      var speed = {{ section.settings.autoplay_speed | times: 1000 }};
      var paused = false;

      function advance () {
        if (paused) return;
        var btn = sectionEl.querySelector('.slider-button--next');
        if (btn && !btn.disabled) {
          btn.click();
        } else {
          var first = sectionEl.querySelector('.slider-button--prev');
          if (first) {
            var slider = sectionEl.querySelector('.lps-slider-list');
            if (slider) slider.scrollTo({ left: 0, behavior: 'smooth' });
          }
        }
      }

      var timer = setInterval(advance, speed);
      sectionEl.addEventListener('mouseenter', function () { paused = true; });
      sectionEl.addEventListener('mouseleave', function () { paused = false; });
      sectionEl.addEventListener('focusin',    function () { paused = true; });
      sectionEl.addEventListener('focusout',   function () { paused = false; });
    })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Texto + Slider",
  "class": "section",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Texto destacado (eyebrow)"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Texto destacado",
      "default": "Por qué elegirnos"
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Color del texto destacado"
    },
    {
      "type": "select",
      "id": "eyebrow_font_weight",
      "label": "Peso del texto destacado",
      "options": [
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semibold" },
        { "value": "700", "label": "Bold" }
      ],
      "default": "600"
    },
    {
      "type": "range",
      "id": "eyebrow_font_size_desktop",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Tamaño escritorio",
      "default": 13
    },
    {
      "type": "range",
      "id": "eyebrow_font_size_mobile",
      "min": 10,
      "max": 18,
      "step": 1,
      "unit": "px",
      "label": "Tamaño móvil",
      "default": 12
    },
    {
      "type": "header",
      "content": "Encabezado"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Resultados que se ven y se sienten"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "h2", "label": "t:sections.all.heading_size.options__1.label" },
        { "value": "h1", "label": "t:sections.all.heading_size.options__2.label" },
        { "value": "h0", "label": "t:sections.all.heading_size.options__3.label" }
      ],
      "default": "h1",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Color del título"
    },
    {
      "type": "range",
      "id": "heading_font_size_desktop",
      "min": 16,
      "max": 64,
      "step": 1,
      "unit": "px",
      "label": "Tamaño escritorio",
      "default": 40
    },
    {
      "type": "range",
      "id": "heading_font_size_mobile",
      "min": 16,
      "max": 52,
      "step": 1,
      "unit": "px",
      "label": "Tamaño móvil",
      "default": 28
    },
    {
      "type": "select",
      "id": "heading_font_weight",
      "label": "Peso del título",
      "options": [
        { "value": "300", "label": "Light" },
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semibold" },
        { "value": "700", "label": "Bold" },
        { "value": "800", "label": "Extrabold" }
      ],
      "default": "700"
    },
    {
      "type": "header",
      "content": "Descripción"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Descripción",
      "default": "<p>Fórmulas diseñadas para realzar tu piel y aportar resultados visibles día tras día.</p>"
    },
    {
      "type": "color",
      "id": "description_color",
      "label": "Color de la descripción"
    },
    {
      "type": "range",
      "id": "description_font_size_desktop",
      "min": 12,
      "max": 28,
      "step": 1,
      "unit": "px",
      "label": "Tamaño escritorio",
      "default": 16
    },
    {
      "type": "range",
      "id": "description_font_size_mobile",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Tamaño móvil",
      "default": 14
    },
    {
      "type": "select",
      "id": "description_font_weight",
      "label": "Peso de la descripción",
      "options": [
        { "value": "300", "label": "Light" },
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semibold" }
      ],
      "default": "400"
    },
    {
      "type": "header",
      "content": "Botón"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Texto del botón",
      "default": "Descubrir más"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Enlace del botón"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Estilo del botón",
      "options": [
        { "value": "primary",   "label": "Primario" },
        { "value": "secondary", "label": "Secundario" },
        { "value": "tertiary",  "label": "Terciario" }
      ],
      "default": "primary"
    },
    {
      "type": "header",
      "content": "Íconos de la lista"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Color de íconos (predeterminado)"
    },
    {
      "type": "range",
      "id": "icon_size",
      "min": 16,
      "max": 48,
      "step": 2,
      "unit": "px",
      "label": "Tamaño del ícono",
      "default": 24
    },
    {
      "type": "range",
      "id": "features_gap",
      "min": 4,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Espacio entre elementos de la lista",
      "default": 16
    },
    {
      "type": "header",
      "content": "Slider — Navegación"
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Mostrar flechas",
      "default": true
    },
    {
      "type": "color",
      "id": "arrow_color",
      "label": "Color de las flechas",
      "default": "#111111"
    },
    {
      "type": "checkbox",
      "id": "show_dots",
      "label": "Mostrar puntos de navegación",
      "default": true
    },
    {
      "type": "color",
      "id": "dot_color",
      "label": "Color del punto activo",
      "default": "#111111"
    },
    {
      "type": "header",
      "content": "Slider — Autoplay"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Activar reproducción automática",
      "default": false
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "min": 2,
      "max": 10,
      "step": 1,
      "unit": "seg",
      "label": "Velocidad del autoplay",
      "default": 4
    },
    {
      "type": "header",
      "content": "Slider — Slides visibles"
    },
    {
      "type": "range",
      "id": "slides_desktop",
      "min": 1,
      "max": 3,
      "step": 1,
      "label": "Slides visibles en escritorio",
      "default": 1
    },
    {
      "type": "range",
      "id": "slides_tablet",
      "min": 1,
      "max": 3,
      "step": 1,
      "label": "Slides visibles en tablet",
      "default": 1
    },
    {
      "type": "range",
      "id": "slides_mobile",
      "min": 1,
      "max": 3,
      "step": 1,
      "label": "Slides visibles en móvil",
      "default": 1
    },
    {
      "type": "header",
      "content": "Slider — Diseño"
    },
    {
      "type": "range",
      "id": "slide_gap",
      "min": 0,
      "max": 40,
      "step": 4,
      "unit": "px",
      "label": "Espacio entre slides",
      "default": 16
    },
    {
      "type": "range",
      "id": "slide_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Radio de esquinas de la imagen",
      "default": 12
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Proporción de la imagen",
      "options": [
        { "value": "square",    "label": "Cuadrada (1:1)" },
        { "value": "portrait",  "label": "Retrato (3:4)" },
        { "value": "standard",  "label": "Estándar (4:5)" },
        { "value": "tall",      "label": "Alta (2:3)" },
        { "value": "landscape", "label": "Paisaje (4:3)" }
      ],
      "default": "portrait"
    },
    {
      "type": "header",
      "content": "Diseño de la sección"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Posición del texto (escritorio)",
      "options": [
        { "value": "text_left",  "label": "Texto a la izquierda" },
        { "value": "text_right", "label": "Texto a la derecha" }
      ],
      "default": "text_left"
    },
    {
      "type": "range",
      "id": "left_column_width",
      "min": 30,
      "max": 60,
      "step": 5,
      "unit": "%",
      "label": "Ancho de la columna de texto",
      "default": 45
    },
    {
      "type": "range",
      "id": "columns_gap",
      "min": 20,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Espacio entre columnas",
      "default": 64
    },
    {
      "type": "header",
      "content": "Colores de la sección"
    },
    {
      "type": "select",
      "id": "color_scheme",
