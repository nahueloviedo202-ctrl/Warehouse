{{ 'section-faq-accordion.css' | asset_url | stylesheet_tag }}
{{ 'component-rte.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }

  #shopify-section-{{ section.id }} {
    --faq-item-radius: {{ section.settings.item_radius }}px;
    --faq-item-spacing: {{ section.settings.item_spacing }}px;
    --faq-item-background: {{ section.settings.item_background }};
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .section-{{ section.id }}-heading {
    font-size: {{ section.settings.heading_font_size_mobile }}px;
  }
  .section-{{ section.id }}-caption {
    font-size: {{ section.settings.caption_font_size_mobile }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-heading {
      font-size: {{ section.settings.heading_font_size_desktop }}px;
    }
    .section-{{ section.id }}-caption {
      font-size: {{ section.settings.caption_font_size_desktop }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign accent_class = 'color-foreground-' | append: section.settings.accent_color_scheme
  assign question_blocks = section.blocks | where: 'type', 'question'
-%}

<div class="color-{{ section.settings.color_scheme }} gradient"{% if section.settings.background_color != blank %} style="background-color: {{ section.settings.background_color }};"{% endif %}>
  <div class="faq-accordion page-width page-width--narrow section-{{ section.id }}-padding">
    {%- if section.settings.caption != blank -%}
      <p class="faq-accordion__caption caption-with-letter-spacing {{ accent_class }} section-{{ section.id }}-caption" style="{% if section.settings.caption_color != blank %}color: {{ section.settings.caption_color }};{% endif %}{% if section.settings.caption_font_weight != blank %}font-weight: {{ section.settings.caption_font_weight }};{% endif %}">{{ section.settings.caption | escape }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="faq-accordion__heading {{ section.settings.heading_size }} {{ accent_class }}{% if section.settings.heading_italic %} faq-accordion__heading--italic{% endif %} section-{{ section.id }}-heading" style="{% if section.settings.heading_color != blank %}color: {{ section.settings.heading_color }};{% endif %}{% if section.settings.heading_font_weight != blank %}font-weight: {{ section.settings.heading_font_weight }};{% endif %}">
        {{ section.settings.heading | escape }}
      </h2>
    {%- endif -%}

    {%- if question_blocks.size > 0 -%}
      <div class="faq-accordion__list">
        {%- for block in question_blocks -%}
          {%- style -%}
            .block-{{ block.id }}-question { font-size: {{ block.settings.question_font_size_mobile }}px; }
            .block-{{ block.id }}-answer { font-size: {{ block.settings.answer_font_size_mobile }}px; }
            @media screen and (min-width: 750px) {
              .block-{{ block.id }}-question { font-size: {{ block.settings.question_font_size_desktop }}px; }
              .block-{{ block.id }}-answer { font-size: {{ block.settings.answer_font_size_desktop }}px; }
            }
          {%- endstyle -%}
          <details
            class="faq-accordion__item"
            id="FaqAccordion-{{ block.id }}"
            {% if section.settings.open_first_question and forloop.first %}
              open
            {% endif %}
            {{ block.shopify_attributes }}
          >
            <summary class="faq-accordion__summary" id="FaqSummary-{{ block.id }}">
              <span class="faq-accordion__question block-{{ block.id }}-question" style="{% if block.settings.question_color != blank %}color: {{ block.settings.question_color }};{% endif %}{% if block.settings.question_font_weight != blank %}font-weight: {{ block.settings.question_font_weight }};{% endif %}">{{ block.settings.question | escape }}</span>
              <span class="faq-accordion__icon" aria-hidden="true">
                <span class="faq-accordion__icon-line faq-accordion__icon-line--v"></span>
                <span class="faq-accordion__icon-line faq-accordion__icon-line--h"></span>
              </span>
            </summary>
            <div
              class="faq-accordion__answer rte block-{{ block.id }}-answer"
              id="FaqAnswer-{{ block.id }}"
              role="region"
              aria-labelledby="FaqSummary-{{ block.id }}"
              style="{% if block.settings.answer_color != blank %}color: {{ block.settings.answer_color }};{% endif %}{% if block.settings.answer_font_weight != blank %}font-weight: {{ block.settings.answer_font_weight }};{% endif %}"
            >
              {{ block.settings.answer }}
            </div>
          </details>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

