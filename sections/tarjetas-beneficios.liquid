{{ 'section-tarjetas-beneficios.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }

  #shopify-section-{{ section.id }} {
    --tben-bg: {{ section.settings.bg_color }};
    --tben-card-bg: {{ section.settings.card_bg_color }};
    --tben-card-radius: {{ section.settings.card_radius }}px;
    --tben-card-gap: {{ section.settings.card_gap }}px;
    --tben-layout-gap-mobile: {{ section.settings.layout_gap_mobile }}px;
    --tben-layout-gap: {{ section.settings.layout_gap_desktop }}px;
    --tben-card-text-color: {{ section.settings.card_text_color }};
    --tben-button-bg: {{ section.settings.button_bg_color }};
    --tben-button-color: {{ section.settings.button_text_color }};
    --tben-button-radius: {{ section.settings.button_radius }}px;
    --tben-subtitle-color: {{ section.settings.subtitle_color }};
    --tben-heading-color: {{ section.settings.heading_color }};
    --tben-text-gap-mobile: {{ section.settings.text_gap_mobile }}px;
    --tben-text-gap-desktop: {{ section.settings.text_gap_desktop }}px;
  }

  .section-{{ section.id }}-subtitle {
    font-size: {{ section.settings.subtitle_size_mobile }}px;
  }
  .section-{{ section.id }}-heading {
    font-size: {{ section.settings.heading_size_mobile }}px;
  }
  .section-{{ section.id }}-btn-label {
    font-size: {{ section.settings.button_font_size_mobile }}px;
  }
  .section-{{ section.id }}-card-text {
    font-size: {{ section.settings.card_text_size_mobile }}px;
  }
  .section-{{ section.id }}-card-icon {
    width: {{ section.settings.icon_size_mobile }}px;
    height: {{ section.settings.icon_size_mobile }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
    .section-{{ section.id }}-subtitle {
      font-size: {{ section.settings.subtitle_size_desktop }}px;
    }
    .section-{{ section.id }}-heading {
      font-size: {{ section.settings.heading_size_desktop }}px;
    }
    .section-{{ section.id }}-btn-label {
      font-size: {{ section.settings.button_font_size_desktop }}px;
    }
    .section-{{ section.id }}-card-text {
      font-size: {{ section.settings.card_text_size_desktop }}px;
    }
    .section-{{ section.id }}-card-icon {
      width: {{ section.settings.icon_size_desktop }}px;
      height: {{ section.settings.icon_size_desktop }}px;
    }
  }
{%- endstyle -%}

<div class="tben" style="background-color: var(--tben-bg);">
  <div class="tben__layout page-width section-{{ section.id }}-padding">

    {%- comment -%} ── Columna de texto ── {%- endcomment -%}
    <div class="tben__text">
      {%- unless section.settings.subtitle == blank -%}
        <p class="tben__subtitle section-{{ section.id }}-subtitle">
          {{ section.settings.subtitle | escape }}
        </p>
      {%- endunless -%}

      {%- unless section.settings.heading == blank -%}
        <h2 class="tben__heading section-{{ section.id }}-heading">
          {{ section.settings.heading | escape }}
        </h2>
      {%- endunless -%}
    </div>

    {%- comment -%} ── Grilla de tarjetas ── {%- endcomment -%}
    <div class="tben__cards">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          {%- assign _icon_class = 'tben__card-icon section-' | append: section.id | append: '-card-icon' -%}
          {%- assign _alt = block.settings.text | escape -%}
          <div class="tben__card" {{ block.shopify_attributes }}>
            {%- if block.settings.icon != blank -%}
              {{
                block.settings.icon
                | image_url: width: 80
                | image_tag:
                  class: _icon_class,
                  loading: 'lazy',
                  widths: '40, 60, 80',
                  alt: _alt
              }}
            {%- else -%}
              <div class="tben__card-icon tben__card-icon--placeholder section-{{ section.id }}-card-icon" aria-hidden="true">
                <svg viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <circle cx="20" cy="20" r="18" stroke="currentColor" stroke-width="1.5" opacity="0.3"/>
                </svg>
              </div>
            {%- endif -%}

            {%- unless block.settings.text == blank -%}
              <p class="tben__card-text section-{{ section.id }}-card-text">
                {{ block.settings.text | escape }}
              </p>
            {%- endunless -%}
          </div>
        {%- endfor -%}
      {%- else -%}
        {%- comment -%} Estado vacío en el editor {%- endcomment -%}
        {%- for i in (1..4) -%}
          <div class="tben__card tben__card--placeholder">
            <div class="tben__card-icon tben__card-icon--placeholder section-{{ section.id }}-card-icon" aria-hidden="true">
              <svg viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
                <circle cx="20" cy="20" r="18" stroke="currentColor" stroke-width="1.5" opacity="0.3"/>
              </svg>
            </div>
            <p class="tben__card-text section-{{ section.id }}-card-text">Beneficio del producto</p>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>

    {%- comment -%} ── Botón (va después de las cards en mobile) ── {%- endcomment -%}
    {%- unless section.settings.button_label == blank -%}
      <div class="tben__btn-wrapper">
        <a
          href="{{ section.settings.button_url }}"
          class="tben__button section-{{ section.id }}-btn-label"
        >
          {{ section.settings.button_label | escape }}
        </a>
      </div>
    {%- endunless -%}

  </div>
</div>

<script>
(function () {
  var btn = document.querySelector('#shopify-section-{{ section.id }} .tben__button');
  if (!btn) return;

  btn.addEventListener('click', function (e) {
    var href = btn.getAttribute('href');
    if (!href || !href.startsWith('#')) return;

    var target = document.querySelector(href);
    if (!target) return;

    e.preventDefault();

    var startY = window.scrollY;
    var endY = target.getBoundingClientRect().top + window.scrollY;
    var duration = 750;
    var startTime = null;

    function easeInOutQuart(t) {
      return t < 0.5 ? 8 * t * t * t * t : 1 - Math.pow(-2 * t + 2, 4) / 2;
    }

    function step(ts) {
      if (!startTime) startTime = ts;
      var elapsed = ts - startTime;
      var progress = Math.min(elapsed / duration, 1);
      window.scrollTo(0, startY + (endY - startY) * easeInOutQuart(progress));
      if (progress < 1) requestAnimationFrame(step);
    }

    requestAnimationFrame(step);
  });
})();
</script>

