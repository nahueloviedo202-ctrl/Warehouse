          "min": 10,
          "max": 64,
          "step": 1,
          "unit": "px",
          "label": "Tamaño escritorio (px)",
          "default": 20
        },
        {
          "type": "range",
          "id": "heading_font_size_mobile",
          "min": 10,
          "max": 60,
          "step": 1,
          "unit": "px",
          "label": "Tamaño móvil (px)",
          "default": 17
        },
        {
          "type": "select",
          "id": "heading_font_weight",
          "label": "Peso",
          "options": [
            { "value": "300", "label": "Light" },
            { "value": "400", "label": "Regular" },
            { "value": "500", "label": "Medium" },
            { "value": "600", "label": "Semibold" },
            { "value": "700", "label": "Bold" },
            { "value": "800", "label": "Extrabold" }
          ],
          "default": "700"
        },
        {
          "type": "header",
          "content": "Tipografía — Texto del beneficio"
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "Color"
        },
        {
          "type": "range",
          "id": "text_font_size_desktop",
          "min": 10,
