{{ 'section-image-banner.css' | asset_url | stylesheet_tag }}
{{ 'component-slider.css' | asset_url | stylesheet_tag }}
{{ 'component-slideshow.css' | asset_url | stylesheet_tag }}
{{ 'component-hero-bubbles.css' | asset_url | stylesheet_tag }}

{%- assign slide_blocks = section.blocks | where: 'type', 'slide' -%}
{%- assign bubble_blocks = section.blocks | where: 'type', 'bubble' -%}

{%- comment -%} Espacio reservado para que el texto nunca se superponga con la franja de burbujas {%- endcomment -%}
{%- assign bubble_label_line_mobile = section.settings.bubbles_label_font_size_mobile | times: 1.3 | round -%}
{%- assign bubble_zone_mobile = section.settings.bubbles_diameter_mobile | plus: bubble_label_line_mobile | plus: 10 | plus: section.settings.bubbles_padding_top_mobile | plus: section.settings.bubbles_padding_bottom_mobile -%}
{%- assign bubble_label_line_desktop = section.settings.bubbles_label_font_size_desktop | times: 1.3 | round -%}
{%- assign bubble_zone_desktop = section.settings.bubbles_diameter_desktop | plus: bubble_label_line_desktop | plus: 10 | plus: section.settings.bubbles_padding_top_desktop | plus: section.settings.bubbles_padding_bottom_desktop -%}

{%- style -%}
  #shopify-section-{{ section.id }} {
    position: relative;
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }
  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top_desktop }}px;
      padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
    }
  }
  #Slider-{{ section.id }} {
    max-height: {{ section.settings.max_height_mobile_vh }}vh;
  }
  #Slider-{{ section.id }} .banner__media {
    max-height: {{ section.settings.max_height_mobile_vh }}vh;
    border-radius: {{ section.settings.image_border_radius_mobile }}px;
    overflow: hidden;
  }
  @media screen and (min-width: 750px) {
    #Slider-{{ section.id }} {
      max-height: {{ section.settings.max_height_desktop_vh }}vh;
    }
    #Slider-{{ section.id }} .banner__media {
      max-height: {{ section.settings.max_height_desktop_vh }}vh;
      border-radius: {{ section.settings.image_border_radius_desktop }}px;
    }
  }
  @media screen and (max-width: 749px) {
    #Slider-{{ section.id }} {
      height: {{ section.settings.max_height_mobile_vh }}vh;
      max-height: {{ section.settings.max_height_mobile_vh }}vh;
      overflow: hidden;
    }
    #Slider-{{ section.id }} .slideshow__slide {
      height: 100%;
      max-height: {{ section.settings.max_height_mobile_vh }}vh;
    }
    #Slider-{{ section.id }} .banner__content {
      min-height: 0;
      height: 100%;
      max-height: 100%;
    }
    #Slider-{{ section.id }} .banner__media {
      height: 100%;
      max-height: 100%;
    }
  }
  @media screen and (max-width: 749px) {
    #Slider-{{ section.id }} .banner__content.banner__content-mobile--top-left { align-items: flex-start; justify-content: flex-start; }
    #Slider-{{ section.id }} .banner__content.banner__content-mobile--top-center { align-items: flex-start; justify-content: center; }
    #Slider-{{ section.id }} .banner__content.banner__content-mobile--top-right { align-items: flex-start; justify-content: flex-end; }
    #Slider-{{ section.id }} .banner__content.banner__content-mobile--middle-left { align-items: center; justify-content: flex-start; }
    #Slider-{{ section.id }} .banner__content.banner__content-mobile--middle-center { align-items: center; justify-content: center; }
    #Slider-{{ section.id }} .banner__content.banner__content-mobile--middle-right { align-items: center; justify-content: flex-end; }
    #Slider-{{ section.id }} .banner__content.banner__content-mobile--bottom-left { align-items: flex-end; justify-content: flex-start; }
    #Slider-{{ section.id }} .banner__content.banner__content-mobile--bottom-center { align-items: flex-end; justify-content: center; }
    #Slider-{{ section.id }} .banner__content.banner__content-mobile--bottom-right { align-items: flex-end; justify-content: flex-end; }
  }
{%- endstyle -%}

{%- if section.settings.slide_height == 'adapt_image' and slide_blocks.first.settings.image != blank -%}
  {%- assign mobile_aspect_image = slide_blocks.first.settings.image_mobile | default: slide_blocks.first.settings.image -%}
  {%- style -%}
    @media screen and (max-width: 749px) {
      #Slider-{{ section.id }}::before,
      #Slider-{{ section.id }} .media::before,
      #Slider-{{ section.id }}:not(.banner--mobile-bottom) .banner__content::before {
        padding-bottom: {{ 1 | divided_by: mobile_aspect_image.aspect_ratio | times: 100 }}%;
        content: '';
        display: block;
      }
    }
    @media screen and (min-width: 750px) {
      #Slider-{{ section.id }}::before,
      #Slider-{{ section.id }} .media::before {
        padding-bottom: {{ 1 | divided_by: slide_blocks.first.settings.image.aspect_ratio | times: 100 }}%;
        content: '';
        display: block;
      }
    }
  {%- endstyle -%}
{%- endif -%}

{%- if bubble_blocks.size > 0 -%}
  <style>
    #Slider-{{ section.id }} .slideshow__text-wrapper {
      {% if section.settings.bubbles_position == 'top' %}
        padding-top: {{ bubble_zone_mobile }}px;
      {% else %}
        padding-bottom: {{ bubble_zone_mobile }}px;
      {% endif %}
    }
    @media screen and (min-width: 750px) {
      #Slider-{{ section.id }} .slideshow__text-wrapper {
        {% if section.settings.bubbles_position == 'top' %}
          padding-top: {{ bubble_zone_desktop }}px;
        {% else %}
          padding-bottom: {{ bubble_zone_desktop }}px;
        {% endif %}
      }
    }
    #shopify-section-{{ section.id }} slideshow-component {
      display: block;
    }
    #Hero-Bubbles-{{ section.id }} {
      position: absolute;
      left: 0;
      right: 0;
      z-index: 2;
      box-sizing: border-box;
      padding-left: {{ section.settings.bubbles_outer_padding_mobile }}px;
    
      {% if section.settings.bubbles_position == 'bottom' %}
        bottom: {{ section.settings.padding_bottom_mobile }}px;
      {% else %}
        top: {{ section.settings.padding_top_mobile }}px;
      {% endif %}
      --hero-bubbles-diameter-mobile: {{ section.settings.bubbles_diameter_mobile }}px;
      --hero-bubbles-diameter-desktop: {{ section.settings.bubbles_diameter_desktop }}px;
      --hero-bubbles-gap-mobile: {{ section.settings.bubbles_gap_mobile }}px;
      --hero-bubbles-gap-desktop: {{ section.settings.bubbles_gap_desktop }}px;
      --hero-bubbles-border-width: {{ section.settings.bubbles_border_width }}px;
      --hero-bubbles-border-color: {{ section.settings.bubbles_border_color }};
      --hero-bubbles-label-color: {{ section.settings.bubbles_label_color }};
      --hero-bubbles-label-size-mobile: {{ section.settings.bubbles_label_font_size_mobile }}px;
      --hero-bubbles-label-size-desktop: {{ section.settings.bubbles_label_font_size_desktop }}px;
      --hero-bubbles-padding-top-mobile: {{ section.settings.bubbles_padding_top_mobile }}px;
      --hero-bubbles-padding-bottom-mobile: {{ section.settings.bubbles_padding_bottom_mobile }}px;
      --hero-bubbles-padding-top-desktop: {{ section.settings.bubbles_padding_top_desktop }}px;
      --hero-bubbles-padding-bottom-desktop: {{ section.settings.bubbles_padding_bottom_desktop }}px;
      background: {{ section.settings.bubbles_background }};
    }
    @media screen and (min-width: 750px) {
      #Hero-Bubbles-{{ section.id }} {
        padding-left: {{ section.settings.bubbles_outer_padding_desktop }}px;
        {% if section.settings.bubbles_position == 'bottom' %}
          bottom: {{ section.settings.padding_bottom_desktop }}px;
        {% else %}
          top: {{ section.settings.padding_top_desktop }}px;
        {% endif %}
      }
    }
    @media screen and (max-width: 749px) {
      #Hero-Bubbles-{{ section.id }} .hero-bubbles__list {
        width: {{ section.settings.bubbles_list_width_mobile }}px;
        margin-inline: auto;
        padding-left: {{ section.settings.bubbles_padding_horizontal_mobile }}px;
        padding-right: 0;
        justify-content: flex-start;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
      }
      #Hero-Bubbles-{{ section.id }} .hero-bubbles__item-wrapper:first-child {
        margin-left: 0;
      }
      #Hero-Bubbles-{{ section.id }} .hero-bubbles__list::after {
        content: '';
        display: block;
        flex: 0 0 {{ section.settings.bubbles_padding_horizontal_mobile }}px;
        min-width: {{ section.settings.bubbles_padding_horizontal_mobile }}px;
      }
    }
  </style>
{%- endif -%}

<slideshow-component
  class="slider-mobile-gutter{% if section.settings.layout == 'grid' %} page-width{% endif %}{% if section.settings.show_text_below %} mobile-text-below{% endif %}"
  role="region"
  aria-roledescription="{{ 'sections.slideshow.carousel' | t }}"
  aria-label="{{ section.settings.accessibility_info | escape }}"
>
  {%- if section.settings.auto_rotate and slide_blocks.size > 1 -%}
    <div class="slideshow__controls slideshow__controls--top slider-buttons no-js-hidden{% if section.settings.show_text_below %} slideshow__controls--border-radius-mobile{% endif %}">
      <button
        type="button"
        class="slider-button slider-button--prev"
        name="previous"
        aria-label="{{ 'sections.slideshow.previous_slideshow' | t }}"
        aria-controls="Slider-{{ section.id }}"
      >
        {%- render 'icon-caret' -%}
      </button>

      <div class="slider-counter slider-counter--{{ section.settings.slider_visual }}{% if section.settings.slider_visual == 'counter' or section.settings.slider_visual == 'numbers' %} caption{% endif %}">
        {%- if section.settings.slider_visual == 'counter' -%}
          <span class="slider-counter--current">1</span>
          <span aria-hidden="true"> / </span>
          <span class="visually-hidden">{{ 'general.slider.of' | t }}</span>
          <span class="slider-counter--total">{{ slide_blocks.size }}</span>
        {%- else -%}
          <div class="slideshow__control-wrapper">
            {%- for block in slide_blocks -%}
              <button
                class="slider-counter__link slider-counter__link--{{ section.settings.slider_visual }} link"
                aria-label="{{ 'sections.slideshow.load_slide' | t }} {{ forloop.index }} {{ 'general.slider.of' | t }} {{ forloop.length }}"
                aria-controls="Slider-{{ section.id }}"
              >
                {%- if section.settings.slider_visual == 'numbers' -%}
                  {{ forloop.index }}
                {%- else -%}
                  <span class="dot"></span>
                {%- endif -%}
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      <button
        type="button"
        class="slider-button slider-button--next"
        name="next"
        aria-label="{{ 'sections.slideshow.next_slideshow' | t }}"
        aria-controls="Slider-{{ section.id }}"
      >
        {%- render 'icon-caret' -%}
      </button>

      <button
        type="button"
        class="slideshow__autoplay slider-button no-js-hidden"
        aria-label="{{ 'sections.slideshow.pause_slideshow' | t }}"
      >
        {%- render 'icon-pause' -%}
        {%- render 'icon-play' -%}
      </button>
    </div>

    <noscript>
      <div class="slider-buttons">
        <div class="slider-counter">
          {%- for block in slide_blocks -%}
            <a
              href="#Slide-{{ section.id }}-{{ forloop.index }}"
              class="slider-counter__link link"
              aria-label="{{ 'sections.slideshow.load_slide' | t }} {{ forloop.index }} {{ 'general.slider.of' | t }} {{ forloop.length }}"
            >{{ forloop.index }}</a>
          {%- endfor -%}
        </div>
      </div>
    </noscript>
  {%- endif -%}

  <div
    class="slideshow banner banner--{{ section.settings.slide_height }} grid grid--1-col slider slider--everywhere{% if section.settings.show_text_below %} banner--mobile-bottom{% endif %}{% if slide_blocks.first.settings.image == blank %} slideshow--placeholder{% endif %}"
    id="Slider-{{ section.id }}"
    aria-live="polite"
    aria-atomic="true"
    data-autoplay="{{ section.settings.auto_rotate }}"
    data-speed="{{ section.settings.change_slides_speed }}"
  >
    {%- for block in slide_blocks -%}
      <style>
        #Slide-{{ section.id }}-{{ forloop.index }} .banner__media::after {
          opacity: {{ block.settings.image_overlay_opacity | divided_by: 100.0 }};
        }
        .block-{{ block.id }}-heading {
          font-size: {{ block.settings.heading_font_size_mobile }}px;
        }
        .block-{{ block.id }}-subheading {
          font-size: {{ block.settings.subheading_font_size_mobile }}px;
        }
        @media screen and (min-width: 750px) {
          .block-{{ block.id }}-heading {
            font-size: {{ block.settings.heading_font_size_desktop }}px;
          }
          .block-{{ block.id }}-subheading {
            font-size: {{ block.settings.subheading_font_size_desktop }}px;
          }
        }
        .block-{{ block.id }}-btn.button {
          border-radius: {{ block.settings.button_border_radius }}px;
          {% if block.settings.button_bg_color != blank %}background: {{ block.settings.button_bg_color }};{% endif %}
          {% if block.settings.button_text_color != blank %}color: {{ block.settings.button_text_color }};{% endif %}
          {% if block.settings.button_border_color != blank %}border-color: {{ block.settings.button_border_color }};{% endif %}
        }
        .block-{{ block.id }}-btn.button::before {
          border-radius: calc({{ block.settings.button_border_radius }}px + var(--buttons-border-thickness));
        }
        .block-{{ block.id }}-btn.button::after {
          border-radius: {{ block.settings.button_border_radius }}px;
        }
      </style>

      <div
        class="slideshow__slide grid__item grid--1-col slider__slide"
        id="Slide-{{ section.id }}-{{ forloop.index }}"
        {{ block.shopify_attributes }}
        role="group"
        aria-roledescription="{{ 'sections.slideshow.slide' | t }}"
        aria-label="{{ forloop.index }} {{ 'general.slider.of' | t }} {{ forloop.length }}"
        tabindex="-1"
      >
        <div class="slideshow__media banner__media media{% if block.settings.image == blank %} placeholder{% endif %}">
          {%- if block.settings.image -%}
            {%- assign desktop_height = block.settings.image.width | divided_by: block.settings.image.aspect_ratio | round -%}
            <picture>
              {%- if block.settings.image_mobile -%}
                <source
                  media="(max-width: 749px)"
                  srcset="{{ block.settings.image_mobile | image_url: width: 375 }} 375w, {{ block.settings.image_mobile | image_url: width: 550 }} 550w, {{ block.settings.image_mobile | image_url: width: 750 }} 750w"
                  sizes="100vw"
                >
              {%- endif -%}
              {{
                block.settings.image
                | image_url: width: 3840
                | image_tag:
                  loading: 'lazy',
                  height: desktop_height,
                  sizes: '100vw',
                  widths: '375, 550, 750, 1100, 1500, 1780, 2000, 3000, 3840'
              }}
            </picture>
          {%- else -%}
            {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
        </div>

        <div class="slideshow__text-wrapper banner__content banner__content--{{ block.settings.box_align }} banner__content-mobile--{{ block.settings.box_align_mobile }} page-width{% if block.settings.show_text_box == false %} banner--desktop-transparent{% endif %}">
          <div class="slideshow__text banner__box content-container content-container--full-width-mobile color-{{ block.settings.color_scheme }} gradient slideshow__text--{{ block.settings.text_alignment }} slideshow__text-mobile--{{ block.settings.text_alignment_mobile }}">
            {%- if block.settings.heading != blank -%}
              <h2
                class="banner__heading {{ block.settings.heading_size }} block-{{ block.id }}-heading"
                style="{% if block.settings.heading_color != blank %}color: {{ block.settings.heading_color }};{% endif %}{% if block.settings.heading_font_weight != blank %}font-weight: {{ block.settings.heading_font_weight }};{% endif %}"
              >{{ block.settings.heading | escape }}</h2>
            {%- endif -%}

            {%- if block.settings.subheading != blank -%}
              <div class="banner__text">
                <span
                  class="block-{{ block.id }}-subheading"
                  style="{% if block.settings.subheading_color != blank %}color: {{ block.settings.subheading_color }};{% endif %}{% if block.settings.subheading_font_weight != blank %}font-weight: {{ block.settings.subheading_font_weight }};{% endif %}"
                >{{ block.settings.subheading | escape }}</span>
              </div>
            {%- endif -%}

            {%- if block.settings.button_label != blank -%}
              <div class="banner__buttons">
                <a
                  {% if block.settings.link %}href="{{ block.settings.link }}"{% else %}role="link" aria-disabled="true"{% endif %}
                  class="button {% if block.settings.button_style_secondary %}button--secondary{% else %}button--primary{% endif %} block-{{ block.id }}-btn"
                >{{ block.settings.button_label | escape }}</a>
              </div>
            {%- endif -%}
          </div>
        </div>
      </div>
    {%- endfor -%}
  </div>

  {%- if slide_blocks.size > 1 and section.settings.auto_rotate == false -%}
    <div class="slideshow__controls slider-buttons no-js-hidden{% if section.settings.show_text_below %} slideshow__controls--border-radius-mobile{% endif %}">
      <button
        type="button"
        class="slider-button slider-button--prev"
        name="previous"
        aria-label="{{ 'sections.slideshow.previous_slideshow' | t }}"
        aria-controls="Slider-{{ section.id }}"
      >
        {%- render 'icon-caret' -%}
      </button>

      <div class="slider-counter slider-counter--{{ section.settings.slider_visual }}{% if section.settings.slider_visual == 'counter' or section.settings.slider_visual == 'numbers' %} caption{% endif %}">
        {%- if section.settings.slider_visual == 'counter' -%}
          <span class="slider-counter--current">1</span>
          <span aria-hidden="true"> / </span>
          <span class="visually-hidden">{{ 'general.slider.of' | t }}</span>
          <span class="slider-counter--total">{{ slide_blocks.size }}</span>
        {%- else -%}
          <div class="slideshow__control-wrapper">
            {%- for block in slide_blocks -%}
              <button
                class="slider-counter__link slider-counter__link--{{ section.settings.slider_visual }} link"
                aria-label="{{ 'sections.slideshow.load_slide' | t }} {{ forloop.index }} {{ 'general.slider.of' | t }} {{ forloop.length }}"
                aria-controls="Slider-{{ section.id }}"
              >
                {%- if section.settings.slider_visual == 'numbers' -%}
                  {{ forloop.index }}
                {%- else -%}
                  <span class="dot"></span>
                {%- endif -%}
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      <button
        type="button"
        class="slider-button slider-button--next"
        name="next"
        aria-label="{{ 'sections.slideshow.next_slideshow' | t }}"
        aria-controls="Slider-{{ section.id }}"
      >
        {%- render 'icon-caret' -%}
      </button>

      {%- if section.settings.auto_rotate -%}
        <button
          type="button"
          class="slideshow__autoplay slider-button no-js-hidden"
          aria-label="{{ 'sections.slideshow.pause_slideshow' | t }}"
        >
          {%- render 'icon-pause' -%}
          {%- render 'icon-play' -%}
        </button>
      {%- endif -%}
    </div>

    <noscript>
      <div class="slider-buttons">
        <div class="slider-counter">
          {%- for block in slide_blocks -%}
            <a
              href="#Slide-{{ section.id }}-{{ forloop.index }}"
              class="slider-counter__link link"
              aria-label="{{ 'sections.slideshow.load_slide' | t }} {{ forloop.index }} {{ 'general.slider.of' | t }} {{ forloop.length }}"
            >{{ forloop.index }}</a>
          {%- endfor -%}
        </div>
      </div>
    </noscript>
  {%- endif -%}
</slideshow-component>

{%- if bubble_blocks.size > 0 -%}
  <div id="Hero-Bubbles-{{ section.id }}" class="hero-bubbles hero-bubbles--{{ section.settings.bubbles_position }}">
    <ul class="hero-bubbles__list" role="list" aria-label="{{ section.settings.bubbles_aria_label | escape }}">
      {%- for block in bubble_blocks -%}
        {%- assign bubble_image = block.settings.image | default: block.settings.collection.featured_image -%}
        {%- assign bubble_label = block.settings.label | default: block.settings.collection.title -%}
        <li class="hero-bubbles__item-wrapper" {{ block.shopify_attributes }}>
          <a
            class="hero-bubbles__item"
            {% if block.settings.collection != blank %}
              href="{{ block.settings.collection.url }}"
            {% else %}
              role="link" aria-disabled="true"
            {% endif %}
          >
            <span class="hero-bubbles__media-wrap">
              {%- if bubble_image -%}
                {{
                  bubble_image
                  | image_url: width: 300
                  | image_tag: loading: 'lazy', sizes: '160px', widths: '80, 110, 160, 220, 300', class: 'hero-bubbles__media', alt: bubble_label
                }}
              {%- else -%}
                <span class="hero-bubbles__media hero-bubbles__media--ghost"></span>
              {%- endif -%}
            </span>
            {%- if bubble_label != blank -%}
              <span class="hero-bubbles__label">{{ bubble_label }}</span>
            {%- endif -%}
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
{%- endif -%}

{%- if request.design_mode -%}
  <script src="{{ 'theme-editor.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{% schema %}
{
  "name": "Hero slideshow",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "options": [
        { "value": "full_bleed", "label": "Ancho completo" },
        { "value": "grid", "label": "Con márgenes" }
      ],
      "default": "full_bleed",
      "label": "Diseño"
    },
    {
      "type": "select",
      "id": "slide_height",
      "options": [
        { "value": "adapt_image", "label": "Adaptar a la imagen" },
        { "value": "small", "label": "Pequeño" },
        { "value": "medium", "label": "Mediano" },
        { "value": "large", "label": "Grande" }
      ],
      "default": "medium",
      "label": "Altura del slide",
      "info": "Adaptar a la imagen usa las proporciones de la imagen del primer slide."
    },
    {
      "type": "header",
      "content": "Altura máxima"
    },
    {
      "type": "range",
      "id": "max_height_desktop_vh",
      "min": 40,
      "max": 100,
      "step": 5,
      "unit": "vh",
      "label": "Alto máximo escritorio",
      "info": "Limita la altura del slideshow a este porcentaje del alto visible de la pantalla.",
      "default": 100
    },
    {
      "type": "range",
      "id": "max_height_mobile_vh",
      "min": 40,
      "max": 100,
      "step": 5,
      "unit": "vh",
      "label": "Alto máximo móvil",
      "info": "Limita la altura del slideshow a este porcentaje del alto visible de la pantalla.",
      "default": 100
    },
    {
      "type": "header",
      "content": "Slider"
    },
    {
      "type": "select",
      "id": "slider_visual",
      "options": [
        { "value": "dots", "label": "Puntos" },
        { "value": "counter", "label": "Contador (1 / 3)" },
        { "value": "numbers", "label": "Números" }
      ],
      "default": "dots",
      "label": "Estilo de indicador de slides"
    },
    {
      "type": "checkbox",
      "id": "auto_rotate",
      "label": "Activar autoplay",
      "default": false
    },
    {
      "type": "range",
