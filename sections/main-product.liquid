            },
            {
              "value": "center",
              "label": "Center"
            }
          ],
          "default": "left",
          "label": "Title alignment"
        },
        {
          "type": "checkbox",
          "id": "uppercase_title",
          "label": "Uppercase title",
          "default": false
        },
        {
          "type": "color",
          "id": "title_color",
          "label": "Title color"
        },
        {
          "type": "select",
          "id": "font_weight",
          "label": "Font weight",
          "options": [
            { "value": "theme", "label": "Del tema (predeterminado)" },
            { "value": "300", "label": "Light" },
            { "value": "400", "label": "Regular" },
