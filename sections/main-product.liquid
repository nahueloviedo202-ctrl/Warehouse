            {%- when 'sticky_atc' -%}
                {%- if block.settings.display_when == 'after_scroll' -%}
                    {% assign atc_class = "sticky-atc sticky-atc--after-scroll" %}
                {%- else -%}
                    {% assign atc_class = "sticky-atc" %}
                {%- endif -%}
                <div class="{{ atc_class }} color-{{ block.settings.color_scheme }}">
                  <div class='sticky-atc-container page-width'>
                      <div class='sticky-atc__left'>
                          <h4 class='sticky-atc__title'>
                              {{ product.title }}
                          </h4>
                          {%- if block.settings.show_price -%}
                            <div class='sticky-atc__price' id="atc-price-{{ section.id }}">
                              {%- render 'price',
                                  product: product,
                                  use_variant: true,
                                  show_badges: block.settings.show_price_badge,
                                  price_class: '',
                                  hide_currency_code: true
                              -%}
                            </div>
                          {%- endif -%}
                      </div>
                      <div class='sticky-atc__button'>
                          {%- liquid
                              assign check_against_inventory = true
                              if product.selected_or_first_available_variant.inventory_management != 'shopify' or  product.selected_or_first_available_variant.inventory_policy == 'continue'
                              assign check_against_inventory = false
                              endif
                              if product.selected_or_first_available_variant.quantity_rule.min > product.selected_or_first_available_variant.inventory_quantity and check_against_inventory
                              assign quantity_rule_soldout = true
                              endif
                          -%}
                          <button
                              type="submit"
                              name="add"
                              class="button"
                              form="{{ product_form_id }}"
                              {% if product.selected_or_first_available_variant.available == false or quantity_rule_soldout %}
                                disabled
                              {% endif %}
                          >
                              <span>
                                  {%- if product.selected_or_first_available_variant.available == false or quantity_rule_soldout -%}
                                      {{ 'products.product.sold_out' | t }}
                                  {%- else -%}
                                      {{ block.settings.button_label }}
                                  {%- endif -%}
                              </span>
                              <div class="loading-overlay__spinner hidden">
                                  <svg
                                      aria-hidden="true"
                                      focusable="false"
                                      class="spinner"
                                      viewBox="0 0 66 66"
                                      xmlns="http://www.w3.org/2000/svg"
                                  >
                                      <circle class="path" fill="none" stroke-width="6" cx="33" cy="33" r="30"></circle>
                                  </svg>
                              </div>
                          </button>
                      </div>
                  </div>
              </div>

            {%- when 'popup' -%}
              <modal-opener
                class="product-popup-modal__opener no-js-hidden quick-add-hidden"
                data-modal="#PopupModal-{{ block.id }}"
                {{ block.shopify_attributes }}
              >
                <button
                  id="ProductPopup-{{ block.id }}"
                  class="product-popup-modal__button link"
                  type="button"
                  aria-haspopup="dialog"
                >
                  {{ block.settings.text | default: block.settings.page.title }}
                </button>
              </modal-opener>
              <a href="{{ block.settings.page.url }}" class="product-popup-modal__button link no-js">
                {{- block.settings.text -}}
              </a>
            {%- when 'share' -%}
              {% assign share_url = product.selected_variant.url | default: product.url | prepend: request.origin %}
              {% render 'share-button',
                block: block,
                share_link: share_url
              %}

            {%- when 'variant_picker' -%}
              {% render 'product-variant-picker', product: product, block: block, product_form_id: product_form_id %}
            {%- when 'buy_buttons' -%}
              {%- render 'buy-buttons', block: block, product: product, product_form_id: product_form_id, section_id: section.id, show_pickup_availability: true -%}
            {%- when 'reviews' -%}
              {%- render 'reviews', block: block -%}
            {%- when 'rating' -%}
              {%- if product.metafields.reviews.rating.value != blank -%}
                {% liquid
                  assign rating_decimal = 0
                  assign decimal = product.metafields.reviews.rating.value.rating | modulo: 1
                  if decimal >= 0.3 and decimal <= 0.7
                    assign rating_decimal = 0.5
                  elsif decimal > 0.7
                    assign rating_decimal = 1
                  endif
                %}
                <div
                  class="rating"
                  role="img"
                  aria-label="{{ 'accessibility.star_reviews_info' | t: rating_value: product.metafields.reviews.rating.value, rating_max: product.metafields.reviews.rating.value.scale_max }}"
                >
                  <span
                    aria-hidden="true"
                    class="rating-star color-icon-{{ settings.accent_icons }}"
                    style="--rating: {{ product.metafields.reviews.rating.value.rating | floor }}; --rating-max: {{ product.metafields.reviews.rating.value.scale_max }}; --rating-decimal: {{ rating_decimal }};"
                  ></span>
                </div>
                <p class="rating-text caption">
                  <span aria-hidden="true">
                    {{- product.metafields.reviews.rating.value }} /
                    {{ product.metafields.reviews.rating.value.scale_max -}}
                  </span>
                </p>
                <p class="rating-count caption">
                  <span aria-hidden="true">({{ product.metafields.reviews.rating_count }})</span>
                  <span class="visually-hidden">
                    {{- product.metafields.reviews.rating_count }}
                    {{ 'accessibility.total_reviews' | t -}}
                  </span>
                </p>
              {%- endif -%}
            {%- when 'payment_badges' -%}
                <div class='payment-badges-block'>
                    <ul class="payment-badges" role="list">
                        {%- for type in shop.enabled_payment_types -%}
                            <li class="list-payment__item">
                              {{ type | payment_type_svg_tag: class: 'icon icon--full-color' }}
                            </li>
                        {%- endfor -%}
                    </ul>
                </div>
            {% when 'urgency' %}
            {%- liquid
              if section.settings.hide_variants and variant_images.size == product.media.size
                assign single_media_visible = true
              endif
            
              assign media_count = product.media.size
              if section.settings.hide_variants and media_count > 1 and variant_images.size > 0
                assign media_count = media_count | minus: variant_images.size | plus: 1
              endif
            
              if media_count == 1 or single_media_visible
                assign single_media_visible_mobile = true
              endif
            
              if media_count == 0 or single_media_visible_mobile or section.settings.mobile_thumbnails == 'show' or section.settings.mobile_thumbnails == 'columns' and media_count < 3
                assign hide_mobile_slider = true
              endif
            -%}
              <p class="urgency-text color-{{ block.settings.color_scheme }}{% if hide_mobile_slider %} urgency-text--single-image{% endif %}" style="{% if block.settings.urgency_color != blank %}color: {{ block.settings.urgency_color }};{% endif %}{% if block.settings.urgency_font_size > 0 %}font-size: {{ block.settings.urgency_font_size }}px;{% endif %}{% if block.settings.urgency_weight != blank %}font-weight: {{ block.settings.urgency_weight }};{% endif %}">
                <strong>{{ block.settings.urgency }}</strong>
              </p>
            {% when 'emoji_benefits' %}
              <div class='emoji-benefits-container emoji-benefits-{{ block.id }}'
                style="
                  {% if block.settings.font_color != blank %}color: {{ block.settings.font_color }};{% endif %}
                  {% if block.settings.font_weight != blank %}font-weight: {{ block.settings.font_weight }};{% endif %}
                  {% if block.settings.text_align != blank %}text-align: {{ block.settings.text_align }};{% endif %}
                  font-size: {{ block.settings.font_size_mobile }}px;
                "
              >
                {{ block.settings.benefits }}
              </div>
              <style>
                .emoji-benefits-{{ block.id }} p,
                .emoji-benefits-{{ block.id }} li {
                  margin-bottom: {{ block.settings.item_spacing_mobile }}px;
                }
                .emoji-benefits-{{ block.id }} p:last-child,
                .emoji-benefits-{{ block.id }} li:last-child {
                  margin-bottom: 0;
                }
                @media screen and (min-width: 750px) {
                  .emoji-benefits-{{ block.id }} {
                    font-size: {{ block.settings.font_size_desktop }}px !important;
                  }
                  .emoji-benefits-{{ block.id }} p,
                  .emoji-benefits-{{ block.id }} li {
                    margin-bottom: {{ block.settings.item_spacing_desktop }}px;
                  }
                }
              </style>
            {%- when 'icon_badges' -%}
              {% render 'icon-badges', block: block %}
            {% when 'estimated_shipping' %}
              {% render 'estimated-shipping', block: block %}
            {%- when 'complementary' -%}
              <product-recommendations class="complementary-products quick-add-hidden no-js-hidden{% if block.settings.make_collapsible_row %} is-accordion{% endif %}{% if block.settings.enable_quick_add %} complementary-products-contains-quick-add{% endif %}" data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ block.settings.product_list_limit }}&intent=complementary">
                {%- if recommendations.performed and recommendations.products_count > 0 -%}
                  <aside aria-label="{{ 'accessibility.complementary_products' | t }}" {{ block.shopify_attributes }}{% if block.settings.make_collapsible_row %} class="product__accordion accordion"{% endif %}>
                    <div class="complementary-products__container">
                      {%- if block.settings.make_collapsible_row -%}
                        <details id="Details-{{ block.id }}-{{ section.id }}" open>
                          <summary>
                      {%- endif %}
                      <div class="summary__title">
                        {%- if block.settings.make_collapsible_row -%}
                          {% render 'icon-accordion', icon: block.settings.icon %}
                          <h2 class="h4 accordion__title" style="{% if block.settings.heading_color != blank %}color: {{ block.settings.heading_color }};{% endif %}{% if block.settings.heading_font_size > 0 %}font-size: {{ block.settings.heading_font_size }}px;{% endif %}{% if block.settings.heading_weight != blank %}font-weight: {{ block.settings.heading_weight }};{% endif %}">{{ block.settings.block_heading }}</h2>
                        {%- else -%}
                          <h2 class="h3 accordion__title" style="{% if block.settings.heading_color != blank %}color: {{ block.settings.heading_color }};{% endif %}{% if block.settings.heading_font_size > 0 %}font-size: {{ block.settings.heading_font_size }}px;{% endif %}{% if block.settings.heading_weight != blank %}font-weight: {{ block.settings.heading_weight }};{% endif %}">{{ block.settings.block_heading }}</h2>
                        {%- endif -%}
                      </div>
                      {%- if block.settings.make_collapsible_row -%}
                          {% render 'icon-caret' %}
                        </summary>
                      {%- endif -%}
                      <slideshow-component class="slider-mobile-gutter">
                        {%- assign number_of_slides = recommendations.products_count | plus: 0.0 | divided_by: block.settings.products_per_page | ceil -%}
                        <div id="Slider-{{ block.id }}" class="contains-card contains-card--product complementary-slider grid grid--1-col slider slider--everywhere" role="list"{% if number_of_slides > 1 %} aria-label="{{ 'general.slider.name' | t }}"{% endif %}>
                          {%- for i in (1..number_of_slides) -%}
                            {%- assign slide_offset = forloop.index0 | times: block.settings.products_per_page -%}
                            <div id="Slide-{{ block.id }}-{{ forloop.index }}" class="complementary-slide complementary-slide--{{ settings.card_style }} grid__item slider__slide slideshow__slide" tabindex="-1" role="group"{% if number_of_slides > 1 %} aria-roledescription="{{ 'sections.slideshow.slide' | t }}" aria-label="{{ forloop.index }} {{ 'general.slider.of' | t }} {{ forloop.length }}"{% endif %}>
                              <ul class="list-unstyled" role="list">
                                {%- for product in recommendations.products limit: block.settings.products_per_page offset: slide_offset -%}
                                  <li>
                                    {% render 'card-product',
                                      card_product: product,
                                      media_aspect_ratio: block.settings.image_ratio,
                                      show_secondary_image: false,
                                      lazy_load: false,
                                      show_quick_add: block.settings.enable_quick_add,
                                      section_id: section.id,
                                      horizontal_class: true,
                                      horizontal_quick_add: true
                                    %}
                                  </li>
                                {%- endfor -%}
                              </ul>
                            </div>
                          {%- endfor -%}
                        </div>
                        {%- if number_of_slides > 1 -%}
                          <div class="slider-buttons no-js-hidden">
                            <button type="button" class="slider-button slider-button--prev" name="previous" aria-label="{{ 'general.slider.previous_slide' | t }}">{% render 'icon-caret' %}</button>
                            <div class="slider-counter slider-counter--{{ block.settings.pagination_style }}{% if block.settings.pagination_style == 'counter' or block.settings.pagination_style == 'numbers' %} caption{% endif %}">
                              {%- if block.settings.pagination_style == 'counter' -%}
                                <span class="slider-counter--current">1</span>
                                <span aria-hidden="true"> / </span>
                                <span class="visually-hidden">{{ 'general.slider.of' | t }}</span>
                                <span class="slider-counter--total">{{ number_of_slides }}</span>
                              {%- else -%}
                                <div class="slideshow__control-wrapper">
                                  {%- for i in (1..number_of_slides) -%}
                                    <button class="slider-counter__link slider-counter__link--{{ block.settings.pagination_style }} link" aria-label="{{ 'sections.slideshow.load_slide' | t }} {{ forloop.index }} {{ 'general.slider.of' | t }} {{ forloop.length }}" aria-controls="Slider-{{ block.id }}">
                                      {%- if block.settings.pagination_style == 'numbers' -%}{{ forloop.index }}{% else %}<span class="dot"></span>{%- endif -%}
                                    </button>
                                  {%- endfor -%}
                                </div>
                              {%- endif -%}
                            </div>
                            <button type="button" class="slider-button slider-button--next" name="next" aria-label="{{ 'general.slider.next_slide' | t }}">{% render 'icon-caret' %}</button>
                          </div>
                        {%- endif -%}
                      </slideshow-component>
                      {%- if block.settings.make_collapsible_row -%}
                        </details>
                      {%- endif -%}
                    </div>
                  </aside>
                {%- endif -%}
                {{ 'component-card.css' | asset_url | stylesheet_tag }}
                {{ 'component-complementary-products.css' | asset_url | stylesheet_tag }}
                {%- if block.settings.enable_quick_add -%}
                  <link rel="stylesheet" href="{{ 'quick-add.css' | asset_url }}" media="print" onload="this.media='all'">
                  <script src="{{ 'quick-add.js' | asset_url }}" defer="defer"></script>
                {%- endif -%}
              </product-recommendations>
            {%- when 'icon-with-text' -%}
              {% render 'icon-with-text',
                block: block
              %}
            {%- when 'video_carousel' -%}
              {% render 'video-carousel', block: block %}
            {%- when 'trustpilot_bar' -%}
              {%- assign tp_rating = block.settings.rating -%}
              {%- assign tp_full = tp_rating | floor -%}
              {%- assign tp_decimal = tp_rating | modulo: 1 | times: 100 | round -%}
              {%- assign tp_partial = tp_full | plus: 1 -%}
              <div
                class="product-review-bar"
                style="--prb-star:{{ block.settings.star_size }}px;--prb-star-m:{{ block.settings.star_size_mobile }}px;--prb-text:{{ block.settings.text_size }}px;--prb-text-m:{{ block.settings.text_size_mobile }}px;--prb-gap:{{ block.settings.gap }}px;--prb-gap-m:{{ block.settings.gap_mobile }}px;justify-content:{{ block.settings.alignment }};"
                {{ block.shopify_attributes }}
              >
                <div class="product-review-bar__stars" aria-hidden="true" style="display:flex;gap:3px;">
                  {%- for i in (1..5) -%}
                    {%- if i <= tp_full -%}
                      <span class="product-review-bar__star">
                        <svg viewBox="0 0 40 40" xmlns="http://www.w3.org/2000/svg" style="width:100%;height:100%;display:block;">
                          <rect width="40" height="40" fill="{{ block.settings.star_color }}"/>
                          <polygon points="20,4 25,15 38,15 28,23 32,35 20,28 8,35 12,23 2,15 15,15" fill="white"/>
                        </svg>
                      </span>
                    {%- elsif i == tp_partial and tp_decimal > 0 -%}
                      <span class="product-review-bar__star" style="position:relative;">
                        <svg viewBox="0 0 40 40" xmlns="http://www.w3.org/2000/svg" style="width:100%;height:100%;display:block;">
                          <rect width="40" height="40" fill="{{ block.settings.empty_star_color }}"/>
                          <polygon points="20,4 25,15 38,15 28,23 32,35 20,28 8,35 12,23 2,15 15,15" fill="white"/>
                        </svg>
                        <span style="position:absolute;top:0;left:0;width:{{ tp_decimal }}%;height:100%;overflow:hidden;">
                          <svg class="product-review-bar__partial-svg" viewBox="0 0 40 40" xmlns="http://www.w3.org/2000/svg" style="width:var(--prb-star);height:var(--prb-star);display:block;">
                            <rect width="40" height="40" fill="{{ block.settings.star_color }}"/>
                            <polygon points="20,4 25,15 38,15 28,23 32,35 20,28 8,35 12,23 2,15 15,15" fill="white"/>
                          </svg>
                        </span>
                      </span>
                    {%- else -%}
                      <span class="product-review-bar__star">
                        <svg viewBox="0 0 40 40" xmlns="http://www.w3.org/2000/svg" style="width:100%;height:100%;display:block;">
                          <rect width="40" height="40" fill="{{ block.settings.empty_star_color }}"/>
                          <polygon points="20,4 25,15 38,15 28,23 32,35 20,28 8,35 12,23 2,15 15,15" fill="white"/>
                        </svg>
                      </span>
                    {%- endif -%}
                  {%- endfor -%}
                </div>
                <span
                  class="product-review-bar__label"
                  style="{% if block.settings.text_color != blank %}color:{{ block.settings.text_color }};{% endif %}"
                >
                  {%- if block.settings.pre_text != blank -%}{{ block.settings.pre_text }}&nbsp;{%- endif -%}
                  <strong>{{ tp_rating }}/{{ block.settings.max_rating }}</strong>
                  {%- if block.settings.separator_text != blank -%}&nbsp;{{ block.settings.separator_text }}&nbsp;{%- endif -%}
                  {{- block.settings.customer_count -}}
                  {%- if block.settings.suffix_text != blank -%}&nbsp;{{ block.settings.suffix_text }}{%- endif -%}
                </span>
              </div>
            {%- when 'trust_badges' -%}
              {%- style -%}
                .trust-badges--{{ block.id }} .trust-badges__icon {
                  width: {{ block.settings.icon_size }}px;
                  height: {{ block.settings.icon_size }}px;
                }
                .trust-badges--{{ block.id }} .trust-badges__item {
                  gap: {{ block.settings.label_gap }}px;
                }
                @media screen and (max-width: 749px) {
                  .trust-badges--{{ block.id }} {
                    gap: {{ block.settings.items_gap_mobile }}px !important;
                    padding: {{ block.settings.padding_vertical_mobile }}px {{ block.settings.padding_horizontal_mobile }}px !important;
                  }
                  .trust-badges--{{ block.id }} .trust-badges__icon {
                    width: {{ block.settings.icon_size_mobile }}px;
                    height: {{ block.settings.icon_size_mobile }}px;
                  }
                  .trust-badges--{{ block.id }} .trust-badges__label {
                    font-size: {{ block.settings.text_size_mobile }}px;
                  }
                }
              {%- endstyle -%}
              <div
                class="trust-badges trust-badges--{{ block.id }}"
                style="border: {{ block.settings.border_width }}px solid {{ block.settings.border_color }}; border-radius: {{ block.settings.border_radius }}px; background-color: {{ block.settings.background_color }}; padding: {{ block.settings.padding_vertical }}px {{ block.settings.padding_horizontal }}px; gap: {{ block.settings.items_gap }}px; justify-content: {{ block.settings.alignment }};"
                {{ block.shopify_attributes }}
              >
                {%- if block.settings.show_item_1 -%}
                  <div class="trust-badges__item">
                    <span class="trust-badges__icon" style="color: {{ block.settings.icon_color }};">
                      {%- if block.settings.custom_image_1 != blank -%}
                        {{- block.settings.custom_image_1 | image_url: width: 80 | image_tag: loading: 'lazy', widths: '40,60,80', style: 'width:100%;height:100%;object-fit:contain;display:block;' -}}
                      {%- else -%}
                        {%- render 'trust-badge-icon', icon: block.settings.icon_1 -%}
                      {%- endif -%}
                    </span>
                    {%- if block.settings.label_1 != blank -%}
                      <span class="trust-badges__label" style="font-size: {{ block.settings.text_size }}px; color: {{ block.settings.text_color }};">{{ block.settings.label_1 }}</span>
                    {%- endif -%}
                  </div>
                {%- endif -%}
                {%- if block.settings.show_item_2 -%}
                  <div class="trust-badges__item">
                    <span class="trust-badges__icon" style="color: {{ block.settings.icon_color }};">
                      {%- if block.settings.custom_image_2 != blank -%}
                        {{- block.settings.custom_image_2 | image_url: width: 80 | image_tag: loading: 'lazy', widths: '40,60,80', style: 'width:100%;height:100%;object-fit:contain;display:block;' -}}
                      {%- else -%}
                        {%- render 'trust-badge-icon', icon: block.settings.icon_2 -%}
                      {%- endif -%}
                    </span>
                    {%- if block.settings.label_2 != blank -%}
                      <span class="trust-badges__label" style="font-size: {{ block.settings.text_size }}px; color: {{ block.settings.text_color }};">{{ block.settings.label_2 }}</span>
                    {%- endif -%}
                  </div>
                {%- endif -%}
                {%- if block.settings.show_item_3 -%}
                  <div class="trust-badges__item">
                    <span class="trust-badges__icon" style="color: {{ block.settings.icon_color }};">
                      {%- if block.settings.custom_image_3 != blank -%}
                        {{- block.settings.custom_image_3 | image_url: width: 80 | image_tag: loading: 'lazy', widths: '40,60,80', style: 'width:100%;height:100%;object-fit:contain;display:block;' -}}
                      {%- else -%}
                        {%- render 'trust-badge-icon', icon: block.settings.icon_3 -%}
                      {%- endif -%}
                    </span>
                    {%- if block.settings.label_3 != blank -%}
                      <span class="trust-badges__label" style="font-size: {{ block.settings.text_size }}px; color: {{ block.settings.text_color }};">{{ block.settings.label_3 }}</span>
                    {%- endif -%}
                  </div>
                {%- endif -%}
              </div>
            {%- when 'press_logos' -%}
            {%- when 'pdp_acc_wrapper' -%}
              {%- style -%}
                .pdp-acc-wrapper-{{ block.id }} {
                  {% if block.settings.background_color != blank %}background-color: {{ block.settings.background_color }};{% endif %}
                  border: {{ block.settings.border_width }}px solid {{ block.settings.border_color }};
                  border-radius: {{ block.settings.border_radius }}px;
                  padding: {{ block.settings.padding_v }}px {{ block.settings.padding_h }}px;
                }
                .pdp-acc-wrapper-{{ block.id }} .pdp-acc__section-title {
                  {% if block.settings.section_title_color != blank %}color: {{ block.settings.section_title_color }};{% endif %}
                  font-size: {{ block.settings.section_title_size_mobile }}px;
                  font-weight: {{ block.settings.section_title_weight }};
                }
                .pdp-acc-wrapper-{{ block.id }} .pdp-acc__item {
                  border-bottom: 1px solid {{ block.settings.divider_color }};
                }
                .pdp-acc-wrapper-{{ block.id }} .pdp-acc__item--last {
                  border-bottom: none;
                }
                .pdp-acc-wrapper-{{ block.id }} .pdp-acc__number {
                  width: {{ block.settings.icon_size }}px;
                  height: {{ block.settings.icon_size }}px;
                  min-width: {{ block.settings.icon_size }}px;
                  background-color: {{ block.settings.number_bg_color }};
                  color: {{ block.settings.number_color }};
                  font-size: {{ block.settings.icon_size | times: 0.375 | round: 0 }}px;
                }
                .pdp-acc-wrapper-{{ block.id }} .pdp-acc__item-icon {
                  width: {{ block.settings.icon_size }}px;
                  height: {{ block.settings.icon_size }}px;
                  min-width: {{ block.settings.icon_size }}px;
                }
                .pdp-acc-wrapper-{{ block.id }} .pdp-acc__item-title {
                  {% if block.settings.item_title_color != blank %}color: {{ block.settings.item_title_color }};{% endif %}
                  font-size: {{ block.settings.item_title_size_mobile }}px;
                  font-weight: {{ block.settings.item_title_weight }};
                }
                .pdp-acc-wrapper-{{ block.id }} .pdp-acc__item-body {
                  {% if block.settings.item_body_color != blank %}color: {{ block.settings.item_body_color }};{% endif %}
                  font-size: {{ block.settings.item_body_size_mobile }}px;
                  {% if block.settings.show_numbers %}padding-left: {{ block.settings.icon_size | plus: 12 }}px;{% else %}padding-left: 0;{% endif %}
                }
                .pdp-acc-wrapper-{{ block.id }} .pdp-acc__toggle {
                  color: {{ block.settings.toggle_color }};
                }
                @media screen and (min-width: 750px) {
                  .pdp-acc-wrapper-{{ block.id }} .pdp-acc__section-title {
                    font-size: {{ block.settings.section_title_size_desktop }}px;
                  }
                  .pdp-acc-wrapper-{{ block.id }} .pdp-acc__item-title {
                    font-size: {{ block.settings.item_title_size_desktop }}px;
                  }
                  .pdp-acc-wrapper-{{ block.id }} .pdp-acc__item-body {
                    font-size: {{ block.settings.item_body_size_desktop }}px;
                  }
                }
              {%- endstyle -%}
              <div class="pdp-acc-wrapper pdp-acc-wrapper-{{ block.id }}" {{ block.shopify_attributes }}>
                {%- if block.settings.section_title != blank -%}
                  <p class="pdp-acc__section-title">{{ block.settings.section_title | escape }}</p>
                {%- endif -%}
                <div class="pdp-acc__list">
                  {%- for i in (1..6) -%}
                    {%- assign title_key = 'item_' | append: i | append: '_title' -%}
                    {%- assign body_key  = 'item_' | append: i | append: '_body' -%}
                    {%- assign icon_key  = 'item_' | append: i | append: '_icon' -%}
                    {%- if block.settings[title_key] != blank -%}
                      {%- assign is_last = false -%}
                      {%- assign next_i = i | plus: 1 -%}
                      {%- assign next_title_key = 'item_' | append: next_i | append: '_title' -%}
                      {%- if forloop.last or block.settings[next_title_key] == blank -%}
                        {%- assign is_last = true -%}
                      {%- endif -%}
                      <details class="pdp-acc__item{% if is_last %} pdp-acc__item--last{% endif %}">
                        <summary class="pdp-acc__item-summary">
                          {%- if block.settings[icon_key] != blank or block.settings.show_numbers -%}
                          <div class="pdp-acc__item-left">
                            {%- if block.settings[icon_key] != blank -%}
                              <img
                                src="{{ block.settings[icon_key] | image_url: width: 80 }}"
                                alt=""
                                class="pdp-acc__item-icon"
                                loading="lazy"
                                width="{{ block.settings.icon_size }}"
                                height="{{ block.settings.icon_size }}"
                              >
                            {%- elsif block.settings.show_numbers -%}
                              <span class="pdp-acc__number">{{ i }}</span>
                            {%- endif -%}
                          </div>
                          {%- endif -%}
                          <span class="pdp-acc__item-title">{{ block.settings[title_key] | escape }}</span>
                          <span class="pdp-acc__toggle" aria-hidden="true">
                            <svg class="pdp-acc__icon-open" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                              <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
                            </svg>
                            <svg class="pdp-acc__icon-close" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                              <line x1="5" y1="12" x2="19" y2="12"/>
                            </svg>
                          </span>
                        </summary>
                        {%- if block.settings[body_key] != blank -%}
                          <div class="pdp-acc__item-body rte">{{ block.settings[body_key] }}</div>
                        {%- endif -%}
                      </details>
                    {%- endif -%}
                  {%- endfor -%}
                </div>
              </div>
            {%- when 'pdp_stock_pulse' -%}
              {%- style -%}
                .pdp-stock-pulse-{{ block.id }} {
                  display: flex;
                  align-items: center;
                  gap: {{ block.settings.gap }}px;
                  {%- if block.settings.alignment == 'center' -%}justify-content: center;{%- elsif block.settings.alignment == 'right' -%}justify-content: flex-end;{%- endif -%}
                }
                .pdp-stock-pulse-{{ block.id }} .pdp-stock-pulse__dot {
                  position: relative;
                  display: flex;
                  align-items: center;
                  justify-content: center;
                  width: {{ block.settings.dot_size }}px;
                  height: {{ block.settings.dot_size }}px;
                  flex-shrink: 0;
                }
                .pdp-stock-pulse-{{ block.id }} .pdp-stock-pulse__dot-ring {
                  position: absolute;
                  top: 0;
                  left: 0;
                  width: 100%;
                  height: 100%;
                  border-radius: 50%;
                  background-color: {{ block.settings.pulse_color }};
                  animation: pdp-pulse-{{ block.id }} 1.8s ease-out infinite;
                }
                .pdp-stock-pulse-{{ block.id }} .pdp-stock-pulse__dot-inner {
                  width: {{ block.settings.dot_size | times: 0.6 | round: 0 }}px;
                  height: {{ block.settings.dot_size | times: 0.6 | round: 0 }}px;
                  border-radius: 50%;
                  background-color: {{ block.settings.dot_color }};
                  position: relative;
                  z-index: 1;
                }
                @keyframes pdp-pulse-{{ block.id }} {
                  0% { transform: scale(0.65); opacity: 0.85; }
                  70% { transform: scale(1); opacity: 0.25; }
                  100% { transform: scale(0.65); opacity: 0; }
                }
                .pdp-stock-pulse-{{ block.id }} .pdp-stock-pulse__text {
                  font-size: {{ block.settings.font_size_mobile }}px;
                  font-weight: {{ block.settings.font_weight }};
                  {%- if block.settings.text_color != blank -%}color: {{ block.settings.text_color }};{%- endif -%}
                  line-height: 1.3;
                }
                @media screen and (min-width: 750px) {
                  .pdp-stock-pulse-{{ block.id }} .pdp-stock-pulse__text {
                    font-size: {{ block.settings.font_size_desktop }}px;
                  }
                }
              {%- endstyle -%}
              <div class="pdp-stock-pulse pdp-stock-pulse-{{ block.id }}" {{ block.shopify_attributes }}>
                <span class="pdp-stock-pulse__dot" aria-hidden="true">
                  <span class="pdp-stock-pulse__dot-ring"></span>
                  <span class="pdp-stock-pulse__dot-inner"></span>
                </span>
                <span class="pdp-stock-pulse__text">
                  {{- block.settings.text | default: 'Últimas unidades en stock' | escape -}}
                </span>
              </div>
            {%- when 'shipping_info_badge' -%}
              {%- style -%}
                .sib--{{ block.id }} {
                  display: flex;
                  align-items: center;
                  gap: 10px;
                  background-color: {{ block.settings.bg_color }};
                  border: {{ block.settings.border_width }}px solid {{ block.settings.border_color }};
                  border-radius: {{ block.settings.border_radius }}px;
                  padding: {{ block.settings.padding_vertical_mobile }}px {{ block.settings.padding_horizontal_mobile }}px;
                  box-sizing: border-box;
                }
                .sib--{{ block.id }} .sib__icon {
                  display: flex;
                  align-items: center;
                  flex-shrink: 0;
                  width: {{ block.settings.icon_size_mobile }}px;
                  height: {{ block.settings.icon_size_mobile }}px;
                }
                .sib--{{ block.id }} .sib__icon svg,
                .sib--{{ block.id }} .sib__icon img {
                  display: block;
                  width: {{ block.settings.icon_size_mobile }}px;
                  height: {{ block.settings.icon_size_mobile }}px;
                  fill: {{ block.settings.icon_color }};
                  object-fit: contain;
                }
                .sib--{{ block.id }} .sib__text {
                  margin: 0;
                  font-size: {{ block.settings.font_size_mobile }}px;
                  line-height: 1.4;
                  {%- if block.settings.text_color != blank -%}color: {{ block.settings.text_color }};{%- endif -%}
                }
                @media screen and (min-width: 750px) {
                  .sib--{{ block.id }} {
                    padding: {{ block.settings.padding_vertical }}px {{ block.settings.padding_horizontal }}px;
                  }
                  .sib--{{ block.id }} .sib__icon {
                    width: {{ block.settings.icon_size }}px;
                    height: {{ block.settings.icon_size }}px;
                  }
                  .sib--{{ block.id }} .sib__icon svg,
                  .sib--{{ block.id }} .sib__icon img {
                    width: {{ block.settings.icon_size }}px;
                    height: {{ block.settings.icon_size }}px;
                  }
                  .sib--{{ block.id }} .sib__text {
                    font-size: {{ block.settings.font_size }}px;
                  }
                }
              {%- endstyle -%}
              <div class="sib sib--{{ block.id }}" {{ block.shopify_attributes }}>
                <span class="sib__icon" aria-hidden="true">
                  {%- if block.settings.custom_icon != blank -%}
                    {{
                      block.settings.custom_icon
                      | image_url: width: 80
                      | image_tag:
                        loading: 'lazy',
                        widths: '20, 40, 80',
                        alt: block.settings.label | escape
                    }}
                  {%- elsif block.settings.icon != 'none' -%}
                    {%- render 'icon-accordion', icon: block.settings.icon -%}
                  {%- endif -%}
                </span>
                <p class="sib__text">
                  {%- if block.settings.label != blank -%}
                    <strong>{{ block.settings.label | escape }}</strong>
                  {%- endif -%}
                  {%- if block.settings.sublabel != blank -%}
                    <span> {{ block.settings.sublabel | escape }}</span>
                  {%- endif -%}
                </p>
              </div>
            {%- when 'product_review_card' -%}
              {%- assign prc_blocks = section.blocks | where: 'type', 'product_review_card' -%}
              {%- if prc_blocks[0].id == block.id -%}
                {%- render 'product-review-card-block', blocks: prc_blocks, section: section -%}
              {%- endif -%}
            {%- when 'review_alt' -%}
              {%- comment -%} Rendered under the product gallery, see product__media-wrapper above {%- endcomment -%}
          {%- endcase -%}
        {%- endfor -%}
        <a href="{{ product.url }}" class="link product__view-details animate-arrow">
          {{ 'products.product.view_full_details' | t }}
          {% render 'icon-arrow' %}
        </a>
      </product-info>
    </div>
    {%- if section.settings.media_position == 'right' -%}
      {% comment %} Duplicate gallery to display after product content on tablet/desktop breakpoint {% endcomment %}
      <div class="grid__item product__media-wrapper small-hide">
        {% render 'product-media-gallery', variant_images: variant_images, is_duplicate: true %}
      </div>
    {%- endif -%}
  </div>

  {% render 'product-media-modal' variant_images: variant_images %}

  {% assign popups = section.blocks | where: 'type', 'popup' %}
  {%- for block in popups -%}
    <modal-dialog id="PopupModal-{{ block.id }}" class="product-popup-modal" {{ block.shopify_attributes }}>
      <div
        role="dialog"
        aria-label="{{ block.settings.text }}"
        aria-modal="true"
        class="product-popup-modal__content"
        tabindex="-1"
      >
        <button
          id="ModalClose-{{ block.id }}"
          type="button"
          class="product-popup-modal__toggle"
          aria-label="{{ 'accessibility.close' | t }}"
        >
          {% render 'icon-close' %}
        </button>
        <div class="product-popup-modal__content-info">
          <h1 class="h2">{{ block.settings.page.title }}</h1>
          {{ block.settings.page.content }}
        </div>
      </div>
    </modal-dialog>
  {%- endfor -%}

  {%- if product.media.size > 0 -%}
    <script src="{{ 'product-modal.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'media-gallery.js' | asset_url }}" defer="defer"></script>
  {%- endif -%}

  {%- if first_3d_model -%}
    <script type="application/json" id="ProductJSON-{{ product.id }}">
      {{ product.media | where: 'media_type', 'model' | json }}
    </script>
    <script src="{{ 'product-model.js' | asset_url }}" defer></script>
  {%- endif -%}

  <script>
    document.addEventListener('DOMContentLoaded', function () {
      function isIE() {
        const ua = window.navigator.userAgent;
        const msie = ua.indexOf('MSIE ');
        const trident = ua.indexOf('Trident/');

        return msie > 0 || trident > 0;
      }

      if (!isIE()) return;
      const hiddenInput = document.querySelector('#{{ product_form_id }} input[name="id"]');
      const noScriptInputWrapper = document.createElement('div');
      const variantSwitcher =
        document.querySelector('variant-radios[data-section="{{ section.id }}"]') ||
        document.querySelector('variant-selects[data-section="{{ section.id }}"]');
      noScriptInputWrapper.innerHTML = document.querySelector(
        '.product-form__noscript-wrapper-{{ section.id }}'
      ).textContent;
      variantSwitcher.outerHTML = noScriptInputWrapper.outerHTML;

      document.querySelector('#Variants-{{ section.id }}').addEventListener('change', function (event) {
        hiddenInput.value = event.currentTarget.value;
      });
    });

    function checkATCScroll() {
      const stickyAtc = document.querySelector('.sticky-atc');
      if (!stickyAtc) return;
      const regularATC = document.querySelector('.atc-button');
      if (window.scrollY > (regularATC.offsetTop + regularATC.offsetHeight)) {
          stickyAtc.classList.add('sticky-atc--active')
      } else {
          stickyAtc.classList.remove('sticky-atc--active')
      }
    }

    checkATCScroll();
    document.addEventListener('scroll', function() {
      checkATCScroll();
    })
  </script>

  {%- liquid
    if product.selected_or_first_available_variant.featured_media
      assign seo_media = product.selected_or_first_available_variant.featured_media
    else
      assign seo_media = product.featured_media
    endif
  -%}

  <script type="application/ld+json">
    {
      "@context": "http://schema.org/",
      "@type": "Product",
      "name": {{ product.title | json }},
      "url": {{ request.origin | append: product.url | json }},
      {% if seo_media -%}
        "image": [
          {{ seo_media | image_url: width: 1920 | prepend: "https:" | json }}
        ],
      {%- endif %}
      "description": {{ product.description | strip_html | json }},
      {% if product.selected_or_first_available_variant.sku != blank -%}
        "sku": {{ product.selected_or_first_available_variant.sku | json }},
      {%- endif %}
      "brand": {
        "@type": "Brand",
        "name": {{ product.vendor | json }}
      },
      "offers": [
        {%- for variant in product.variants -%}
          {
            "@type" : "Offer",
            {%- if variant.sku != blank -%}
              "sku": {{ variant.sku | json }},
            {%- endif -%}
            {%- if variant.barcode.size == 12 -%}
              "gtin12": {{ variant.barcode }},
            {%- endif -%}
            {%- if variant.barcode.size == 13 -%}
              "gtin13": {{ variant.barcode }},
            {%- endif -%}
            {%- if variant.barcode.size == 14 -%}
              "gtin14": {{ variant.barcode }},
            {%- endif -%}
            "availability" : "http://schema.org/{% if variant.available %}InStock{% else %}OutOfStock{% endif %}",
            "price" : {{ variant.price | divided_by: 100.00 | json }},
            "priceCurrency" : {{ cart.currency.iso_code | json }},
            "url" : {{ request.origin | append: variant.url | json }}
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>
</section>

{% schema %}
{
  "name": "t:sections.main-product.name",
  "tag": "section",
  "class": "section",
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "text",
      "name": "t:sections.main-product.blocks.text.name",
      "settings": [
        {
          "type": "text",
