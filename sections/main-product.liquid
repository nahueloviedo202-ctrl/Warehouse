          "id": "price_side_text",
          "label": "Text beside price",
          "placeholder": "e.g. 0.67FL OZ / 20ml",
          "info": "Appears on the same line as the price"
        },
        {
          "type": "range",
          "id": "side_text_size_desktop",
          "label": "Font size — desktop",
          "min": 10,
          "max": 24,
          "step": 1,
          "unit": "px",
          "default": 13
        },
        {
          "type": "range",
          "id": "side_text_size_mobile",
          "label": "Font size — mobile",
          "min": 10,
          "max": 20,
          "step": 1,
          "unit": "px",
          "default": 12
        },
        {
          "type": "color",
