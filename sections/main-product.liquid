<span id="informacion-producto" class="visually-hidden" aria-hidden="true"></span>
<section
  id="MainProduct-{{ section.id }}"
  class="page-width section-{{ section.id }}-padding"
  data-section="{{ section.id }}"
>
  {{ 'section-main-product.css' | asset_url | stylesheet_tag }}
  {{ 'component-accordion.css' | asset_url | stylesheet_tag }}
  {{ 'component-price.css' | asset_url | stylesheet_tag }}
  {{ 'component-rte.css' | asset_url | stylesheet_tag }}
  {{ 'component-slider.css' | asset_url | stylesheet_tag }}
  {{ 'component-rating.css' | asset_url | stylesheet_tag }}
  {{ 'component-loading-overlay.css' | asset_url | stylesheet_tag }}
  {{ 'component-deferred-media.css' | asset_url | stylesheet_tag }}
  {{ 'component-quantity-breaks.css' | asset_url | stylesheet_tag }}
  {{ 'component-sticky-atc.css' | asset_url | stylesheet_tag }}
  {{ 'component-list-payment.css' | asset_url | stylesheet_tag }}
  {{ 'component-trust-badges.css' | asset_url | stylesheet_tag }}
  {%- assign _review_blocks = section.blocks | where: 'type', 'product_review_card' -%}
  {%- if _review_blocks.size > 0 -%}
    {{ 'section-product-review-card.css' | asset_url | stylesheet_tag }}
  {%- endif -%}

  {%- style -%}
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }

    @media screen and (min-width: 750px) {
      .section-{{ section.id }}-padding {
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
      }
    }

    {%- if section.settings.background_color != blank -%}
    #shopify-section-{{ section.id }} {
      background-color: {{ section.settings.background_color }};
    }
    {%- endif -%}
  {%- endstyle -%}

  <script src="{{ 'product-info.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
  {% if section.settings.image_zoom == 'hover' %}
    <script id="EnableZoomOnHover-main" src="{{ 'magnify.js' | asset_url }}" defer="defer"></script>
  {% endif %}
  {%- if request.design_mode -%}
    <script src="{{ 'theme-editor.js' | asset_url }}" defer="defer"></script>
  {%- endif -%}

  {%- assign first_3d_model = product.media | where: 'media_type', 'model' | first -%}
  {%- if first_3d_model -%}
    {{ 'component-product-model.css' | asset_url | stylesheet_tag }}
    <link
      id="ModelViewerStyle"
      rel="stylesheet"
      href="https://cdn.shopify.com/shopifycloud/model-viewer-ui/assets/v1.0/model-viewer-ui.css"
      media="print"
      onload="this.media='all'"
    >
    <link
      id="ModelViewerOverride"
      rel="stylesheet"
      href="{{ 'component-model-viewer-ui.css' | asset_url }}"
      media="print"
      onload="this.media='all'"
    >
  {%- endif -%}

  {% assign variant_images = product.images | where: 'attached_to_variant?', true | map: 'src' %}

  <div class="product product--{{ section.settings.media_size }} product--{{ section.settings.media_position }} product--{{ section.settings.gallery_layout }} product--mobile-{{ section.settings.mobile_thumbnails }} grid grid--1-col {% if product.media.size > 0 %}grid--2-col-tablet{% else %}product--no-media{% endif %}">
    <div class="grid__item product__media-wrapper{% if section.settings.media_position == 'right' %} medium-hide large-up-hide{% endif %}{% if section.settings.enable_sticky_info %} product__column-sticky{% endif %}">
      {% render 'product-media-gallery', variant_images: variant_images, section %}
      {%- assign press_logo_blocks = section.blocks | where: 'type', 'press_logos' -%}
      {%- for block in press_logo_blocks -%}
        {%- assign pl_opacity = block.settings.logo_opacity | divided_by: 100.0 -%}
        {%- assign mobile_img_height = block.settings.img_height | times: 0.8 | round: 0 -%}
        {%- style -%}
          .product-press-logos-{{ block.id }} {
            padding: 14px 0 0;
            margin-top: 12px;
            width: 100%;
            border-top: 1px solid {{ block.settings.border_color }};
          }
          .product-press-logos-{{ block.id }} .product-press-logos__heading {
            font-size: 0.7rem;
            text-transform: uppercase;
            letter-spacing: 0.12em;
            color: {{ block.settings.text_color }};
            opacity: {{ pl_opacity }};
            text-align: center;
            margin: 0 0 10px;
          }
          .product-press-logos-{{ block.id }} .product-press-logos__row {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: {{ block.settings.logos_gap }}px;
            flex-wrap: wrap;
          }
          .product-press-logos-{{ block.id }} .product-press-logos__item {
            display: flex;
            align-items: center;
            justify-content: center;
          }
          .product-press-logos-{{ block.id }} .product-press-logos__img {
            height: {{ block.settings.img_height }}px;
            width: auto;
            max-width: 100%;
            object-fit: contain;
            opacity: {{ pl_opacity }};
            filter: grayscale({{ block.settings.grayscale }}%);
          }
          .product-press-logos-{{ block.id }} .product-press-logos__text {
            font-size: {{ block.settings.text_size }}px;
            letter-spacing: 0.08em;
            color: {{ block.settings.text_color }};
            opacity: {{ pl_opacity }};
            white-space: nowrap;
            line-height: 1;
          }
          @media screen and (max-width: 749px) {
            .product-press-logos-{{ block.id }} {
              margin-bottom: 16px;
            }
            .product-press-logos-{{ block.id }} .product-press-logos__row {
              width: 100%;
              justify-content: space-around;
              flex-wrap: nowrap;
              gap: 2px;
            }
            .product-press-logos-{{ block.id }} .product-press-logos__item {
              flex: 1;
              min-width: 0;
              overflow: hidden;
            }
            .product-press-logos-{{ block.id }} .product-press-logos__text {
              font-size: 3vw;
              letter-spacing: 0.02em;
              text-align: center;
              display: block;
              white-space: nowrap;
              overflow: hidden;
            }
            .product-press-logos-{{ block.id }} .product-press-logos__img {
              height: auto;
              max-height: {{ mobile_img_height }}px;
              width: 100%;
              max-width: 100%;
              object-fit: contain;
            }
          }
        {%- endstyle -%}
        <div class="product-press-logos product-press-logos-{{ block.id }}" {{ block.shopify_attributes }}>
          {%- if block.settings.heading != blank -%}
            <p class="product-press-logos__heading">{{ block.settings.heading | escape }}</p>
          {%- endif -%}
          <div class="product-press-logos__row">
            {%- for i in (1..6) -%}
              {%- assign img_key = 'logo_' | append: i | append: '_image' -%}
              {%- assign txt_key = 'logo_' | append: i | append: '_text' -%}
              {%- if block.settings[img_key] != blank or block.settings[txt_key] != blank -%}
                <div class="product-press-logos__item">
                  {%- if block.settings[img_key] != blank -%}
                    <img
                      class="product-press-logos__img"
                      src="{{ block.settings[img_key] | image_url: width: 200 }}"
                      alt="{{ block.settings[txt_key] | default: '' | escape }}"
                      width="{{ block.settings[img_key].width }}"
                      height="{{ block.settings[img_key].height }}"
                      loading="lazy"
                    >
                  {%- else -%}
                    <span class="product-press-logos__text">{{ block.settings[txt_key] | escape }}</span>
                  {%- endif -%}
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>
        </div>
      {%- endfor -%}
      {%- assign review_alt_blocks = section.blocks | where: 'type', 'review_alt' -%}
      {%- for block in review_alt_blocks -%}
        {%- render 'review-alt-block', block: block -%}
      {%- endfor -%}
    </div>
    <div class="product__info-wrapper grid__item{% if settings.page_width > 1400 and section.settings.media_size == "small" %} product__info-wrapper--extra-padding{% endif %}{% if section.settings.enable_sticky_info %} product__column-sticky{% endif %}">
      <product-info
        id="ProductInfo-{{ section.id }}"
        data-section="{{ section.id }}"
        data-url="{{ product.url }}"
        class="product__info-container"
      >
        {%- assign product_form_id = 'product-form-' | append: section.id -%}

        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when '@app' -%}
              {% render block %}
            {%- when 'text' -%}
              <p
                class="product__text{% if block.settings.text_style == 'uppercase' %} caption-with-letter-spacing{% elsif block.settings.text_style == 'subtitle' %} subtitle{% endif %}"
                style="{% if block.settings.text_color != blank %}color: {{ block.settings.text_color }};{% endif %}{% if block.settings.font_size > 0 %}font-size: {{ block.settings.font_size }}px;{% endif %}{% if block.settings.font_weight != blank and block.settings.font_weight != 'theme' %}font-weight: {{ block.settings.font_weight }};{% endif %}"
                {{ block.shopify_attributes }}
              >
                {{- block.settings.text -}}
              </p>
            {%- when 'title' -%}
              {% style %}
                .section-{{ section.id }}-padding #product-title-{{ block.id }} {
                  padding-top: {{ block.settings.padding_top_mobile }}px;
                  padding-bottom: {{ block.settings.padding_bottom_mobile }}px;
                }

                #product-title-{{ block.id }} h1 {
                  {% if block.settings.font_size_mobile > 0 %}font-size: {{ block.settings.font_size_mobile }}px;{% endif %}
                }

                @media screen and (min-width: 750px) {
                  .section-{{ section.id }}-padding #product-title-{{ block.id }} {
                    padding-top: {{ block.settings.padding_top }}px;
                    padding-bottom: {{ block.settings.padding_bottom }}px;
                  }

                  #product-title-{{ block.id }} h1 {
                    {% if block.settings.font_size_desktop > 0 %}font-size: {{ block.settings.font_size_desktop }}px;{% endif %}
                  }
                }
              {% endstyle %}
              <div id="product-title-{{ block.id }}" class="product__title" {{ block.shopify_attributes }}>
                <h1 class="{{ block.settings.text_size }}{% if block.settings.uppercase_title %} product-title--uppercase{% endif %}{% if block.settings.title_alignment == 'center' %} center{% endif %}" style="{% if block.settings.title_color != blank %}color: {{ block.settings.title_color }};{% endif %}{% if block.settings.font_weight != blank and block.settings.font_weight != 'theme' %}font-weight: {{ block.settings.font_weight }};{% endif %}">
                  {{ product.title | escape }}
                </h1>
                <a href="{{ product.url }}" class="product__title">
                  <h2 class="h1">
                    {{ product.title | escape }}
                  </h2>
                </a>
              </div>
            {%- when 'price' -%}
              {%- if block.settings.center_on_mobile -%}
                <style>
                  @media screen and (max-width: 749px) {
                    #price-{{ section.id }},
                    #price-{{ section.id }} + .price-divider { justify-content: center; text-align: center; }
                  }
                </style>
              {%- endif -%}
              <div class="no-js-hidden product-page-price" id="price-{{ section.id }}" role="status" {{ block.shopify_attributes }}
                style="
                  --price-sale-size: {{ block.settings.sale_price_size_desktop }}px;
                  --price-compare-size: {{ block.settings.compare_price_size_desktop }}px;
                  --price-sale-size-mobile: {{ block.settings.sale_price_size_mobile }}px;
                  --price-compare-size-mobile: {{ block.settings.compare_price_size_mobile }}px;
                  --price-gap: {{ block.settings.price_gap }}px;
                  --price-beside-size: {{ block.settings.side_text_size_desktop }}px;
                  --price-beside-size-mobile: {{ block.settings.side_text_size_mobile }}px;
                  --price-beside-color: {{ block.settings.side_text_color }};
                "
              >
                {%- render 'price',
                  product: product,
                  use_variant: true,
                  show_badges: false,
                  price_class: 'price--large',
                  side_text: block.settings.price_side_text
                -%}
              </div>
              {%- if block.settings.show_price_divider -%}
                <div class="price-divider" style="
                  --divider-thickness: {{ block.settings.divider_thickness }}px;
                  --divider-bg: {{ block.settings.divider_color }};
                  --divider-opacity: {{ block.settings.divider_opacity | divided_by: 100.0 }};
                  --divider-mt: {{ block.settings.divider_margin_top_desktop }}px;
                  --divider-mb: {{ block.settings.divider_margin_bottom_desktop }}px;
                  --divider-mt-mobile: {{ block.settings.divider_margin_top_mobile }}px;
                  --divider-mb-mobile: {{ block.settings.divider_margin_bottom_mobile }}px;
                "></div>
              {%- endif -%}
              <div {{ block.shopify_attributes }}>
                {%- assign product_form_installment_id = 'product-form-installment-' | append: section.id -%}
                {%- form 'product', product, id: product_form_installment_id, class: 'installment caption-large' -%}
                  <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                  {{ form | payment_terms }}
                {%- endform -%}
              </div>
            {%- when 'inventory' -%}
              <p
                class="product__inventory no-js-hidden{% if block.settings.text_style == 'uppercase' %} caption-with-letter-spacing{% elsif block.settings.text_style == 'subtitle' %} subtitle{% endif %}{% if product.selected_or_first_available_variant.inventory_management != 'shopify' %} visibility-hidden{% endif %}"
                {{ block.shopify_attributes }}
                id="Inventory-{{ section.id }}"
                role="status"
              >
                {%- if product.selected_or_first_available_variant.inventory_management == 'shopify' -%}
                  {%- if product.selected_or_first_available_variant.inventory_quantity > 0 -%}
                    {%- if product.selected_or_first_available_variant.inventory_quantity <= block.settings.inventory_threshold -%}
                      <svg width="15" height="15" aria-hidden="true">
                        <circle cx="7.5" cy="7.5" r="7.5" fill="rgb(238,148,65, 0.3)"/>
                        <circle cx="7.5" cy="7.5" r="5" stroke="rgb(255, 255, 255)" stroke-width="1" fill="rgb(238,148,65)"/>
                      </svg>
                      {%- if block.settings.show_inventory_quantity -%}
                        {{- 'products.product.inventory_low_stock_show_count' | t: quantity: product.selected_or_first_available_variant.inventory_quantity -}}
                      {%- else -%}
                        {{- 'products.product.inventory_low_stock' | t -}}
                      {%- endif -%}
                    {%- else -%}
                      <svg width="15" height="15" aria-hidden="true">
                        <circle cx="7.5" cy="7.5" r="7.5" fill="rgb(62,214,96, 0.3)"/>
                        <circle cx="7.5" cy="7.5" r="5" stroke="rgb(255, 255, 255)" stroke-width="1" fill="rgb(62,214,96)"/>
                      </svg>
                      {%- if block.settings.show_inventory_quantity -%}
                        {{- 'products.product.inventory_in_stock_show_count' | t: quantity: product.selected_or_first_available_variant.inventory_quantity -}}
                      {%- else -%}
                          {{- 'products.product.inventory_in_stock' | t -}}
                      {%- endif -%}
                    {%- endif -%}
                  {%- else -%}
                    {%- if product.selected_or_first_available_variant.inventory_policy == 'continue' -%}
                      <svg width="15" height="15" aria-hidden="true">
                        <circle cx="7.5" cy="7.5" r="7.5" fill="rgb(62,214,96, 0.3)"/>
                        <circle cx="7.5" cy="7.5" r="5" stroke="rgb(255, 255, 255)" stroke-width="1" fill="rgb(62,214,96)"/>
                      </svg>
                      {{- 'products.product.inventory_out_of_stock_continue_selling' | t -}}
                    {%- else -%}
                      <svg width="15" height="15" aria-hidden="true">
                        <circle cx="7.5" cy="7.5" r="7.5" fill="rgb(200,200,200, 0.3)"/>
                        <circle cx="7.5" cy="7.5" r="5" stroke="rgb(255, 255, 255)" stroke-width="1" fill="rgb(200,200,200)"/>
                      </svg>
                      {{- 'products.product.inventory_out_of_stock' | t -}}
                    {%- endif -%}
                  {%- endif -%}
                {%- endif -%}
              </p>
            {%- when 'description' -%}
              {%- if product.description != blank -%}
                <div class="product__description rte quick-add-hidden" {{ block.shopify_attributes }}>
                  {{ product.description }}
                </div>
              {%- endif -%}
            {%- when 'sku' -%}
              <p
                class="product__sku no-js-hidden{% if block.settings.text_style == 'uppercase' %} caption-with-letter-spacing{% elsif block.settings.text_style == 'subtitle' %} subtitle{% endif %}{% if product.selected_or_first_available_variant.sku.size == 0 %} visibility-hidden{% endif %}"
                id="Sku-{{ section.id }}"
                role="status"
                {{ block.shopify_attributes }}
              >
                <span class="visually-hidden">{{ 'products.product.sku' | t }}:</span> {{- product.selected_or_first_available_variant.sku -}}
              </p>
            {%- when 'custom_liquid' -%}
              {{ block.settings.custom_liquid }}
            {%- when 'collapsible_tab' -%}
              {%- if block.settings.border_color != blank -%}
                {%- assign accordion_border_color = block.settings.border_color -%}
              {%- else -%}
                {%- assign accordion_border_color = 'rgba(var(--color-foreground), 0.08)' -%}
              {%- endif -%}
              {%- assign accordion_border_width = block.settings.border_width | default: 1 -%}
              <style>
                #Accordion-{{ block.id }}-{{ section.id }} {
                  {%- case block.settings.border_position -%}
                  {%- when 'sides' -%}
                    border-top: none;
                    border-bottom: none;
                    border-left: {{ accordion_border_width }}px solid {{ accordion_border_color }};
                    border-right: {{ accordion_border_width }}px solid {{ accordion_border_color }};
                  {%- when 'none' -%}
                    border: none;
                  {%- else -%}
                    border-top: {{ accordion_border_width }}px solid {{ accordion_border_color }};
                    border-bottom: {{ accordion_border_width }}px solid {{ accordion_border_color }};
                    border-left: none;
                    border-right: none;
                  {%- endcase -%}
                }
              </style>
              <div
                id="Accordion-{{ block.id }}-{{ section.id }}"
                class="product__accordion accordion quick-add-hidden"
                style="--accordion-pill-bg: {{ block.settings.background_color }};"
                {{ block.shopify_attributes }}
              >
                <details id="Details-{{ block.id }}-{{ section.id }}">
                  <summary>
                    <div class="summary__title">
                      {% render 'icon-accordion', icon: block.settings.icon %}
                      <h2 class="h4 accordion__title" style="{% if block.settings.heading_color != blank %}color: {{ block.settings.heading_color }};{% endif %}{% if block.settings.heading_font_size > 0 %}font-size: {{ block.settings.heading_font_size }}px;{% endif %}{% if block.settings.heading_weight != blank %}font-weight: {{ block.settings.heading_weight }};{% endif %}">
                        {{ block.settings.heading | default: block.settings.page.title }}
                      </h2>
                    </div>
                    {% render 'icon-caret' %}
                  </summary>
                  <div class="accordion__content rte" id="ProductAccordion-{{ block.id }}-{{ section.id }}">
                    {%- if block.settings.show_product_description -%}
                      {{ product.description }}
                    {%- else -%}
                      {{ block.settings.content }}
                      {{ block.settings.page.content }}
                    {%- endif -%}
                  </div>
                </details>
              </div>

            {%- when 'quantity_selector' -%}
                {%- if block.settings.enable_quantity_discounts -%}
                    <style>
                      {%- if block.settings.card_bg_color != blank or block.settings.card_border_color != blank -%}
                      #shopify-section-{{ section.id }} .quantity-break {
                        {% if block.settings.card_bg_color != blank %}background: {{ block.settings.card_bg_color }};{% endif %}
                        {% if block.settings.card_border_color != blank %}border-color: {{ block.settings.card_border_color }};{% endif %}
                      }
                      {%- endif -%}
                      {%- if block.settings.card_selected_bg_color != blank or block.settings.card_selected_border_color != blank -%}
                      #shopify-section-{{ section.id }} .quantity-breaks-container input:checked + .quantity-break,
                      #shopify-section-{{ section.id }} .quantity-break:hover {
                        {% if block.settings.card_selected_bg_color != blank %}background: {{ block.settings.card_selected_bg_color }};{% endif %}
                        {% if block.settings.card_selected_border_color != blank %}border-color: {{ block.settings.card_selected_border_color }};{% endif %}
                      }
                      {%- endif -%}
                      {%- if block.settings.card_selected_border_color != blank -%}
                      #shopify-section-{{ section.id }} .quantity-breaks-container input:checked + .quantity-break::before {
                        background: {{ block.settings.card_selected_border_color }};
                        box-shadow: 0 0 0 0.1rem {{ block.settings.card_selected_border_color }};
                      }
                      {%- endif -%}
                      {%- if block.settings.card_border_color != blank -%}
                      #shopify-section-{{ section.id }} .quantity-break::before {
                        border-color: {{ block.settings.card_border_color }};
                      }
                      #shopify-section-{{ section.id }} .quantity-breaks__title span:nth-of-type(1),
                      #shopify-section-{{ section.id }} .quantity-breaks__title span:nth-of-type(3) {
                        background: {{ block.settings.card_border_color }};
                      }
                      {%- endif -%}
                      {%- if block.settings.card_price_color != blank -%}
                      #shopify-section-{{ section.id }} .quantity-break__price {
                        color: {{ block.settings.card_price_color }};
                      }
                      {%- endif -%}
                      {%- if block.settings.badge_bg_color != blank -%}
                      #shopify-section-{{ section.id }} .quantity-break__badge {
                        background: {{ block.settings.badge_bg_color }};
                      }
                      {%- endif -%}
                      {%- if block.settings.benefit_color != blank -%}
                      #shopify-section-{{ section.id }} .quantity-break__benefit {
                        color: {{ block.settings.benefit_color }};
                        border-color: {{ block.settings.benefit_color }};
                      }
                      {%- endif -%}
                    </style>
                    <div class="quantity-breaks-container">
                        <h3 class='quantity-breaks__title' style="{% if block.settings.headline_color != blank %}color: {{ block.settings.headline_color }};{% endif %}{% if block.settings.headline_font_size > 0 %}font-size: {{ block.settings.headline_font_size }}px;{% endif %}{% if block.settings.headline_weight != blank %}font-weight: {{ block.settings.headline_weight }};{% endif %}">
                            <span></span>
                            <span>{{ block.settings.headline }}</span>
                            <span></span>
                        </h3>
                        {% if block.settings.option_1_quantity != 0 %}
                            <input id="quantity1" aria-label="Quantity" type="radio" name="quantity" value="{{ block.settings.option_1_quantity }}" form="{{ product_form_id }}" {% if block.settings.preselected == 'option_1' %} checked{% endif %} {% if product.has_only_default_variant == false and block.settings.option_1_quantity != 1 %}onchange="resetIdInputValue()"{% endif %}>
                            <label for="quantity1" class="quantity-break" data-quantity="{{ block.settings.option_1_quantity }}">
                                {% if block.settings.display_badge == "option_1" %}
                                  <p class='quantity-break__badge'>
                                    {{ block.settings.badge_text }}
                                  </p>
                                {% endif %}
                                <div class='quantity-break__content'>
                                    <div class='quantity-break__left'>
                                        <span class='quantity-break__label'>
                                            <span class='quantity-break__label-text'>
                                              {%- if block.settings.option_1_label != blank -%}
                                                  {{ block.settings.option_1_label }}
                                              {%- else -%}
                                                  Buy {{ block.settings.option_1_quantity }}
                                              {%- endif -%}
                                            </span>
                                            {% if block.settings.option_1_benefit != blank %}
                                              <span class='quantity-break__benefit'>{{ block.settings.option_1_benefit }}</span>
                                            {% endif %}
                                        </span> 
                                        {% if block.settings.option_1_caption != blank %}
                                            <span class="quantity-break__caption">
                                              {% if block.settings.option_1_caption contains "[" and block.settings.option_1_caption contains "]" %}
                                                {% liquid
                                                  assign option_1_caption_number_start = block.settings.option_1_caption | split: "[" | last
