<link rel="stylesheet" href="{{ 'component-slider.css' | asset_url }}" media="print" onload="this.media='all'">
<noscript>{{ 'component-slider.css' | asset_url | stylesheet_tag }}</noscript>

{%- style -%}
  #shopify-section-{{ section.id }} {
    --ccs-heading-color: {{ section.settings.heading_color }};
    --ccs-subheading-color: {{ section.settings.subheading_color }};
    --ccs-arrow-color: {{ section.settings.arrows_color }};
    --ccs-counter-color: {{ section.settings.counter_color }};
    --ccs-card-radius: {{ section.settings.card_border_radius }}px;
    --ccs-card-title-color: {{ section.settings.card_title_color }};
    --ccs-btn-bg: {{ section.settings.button_bg_color }};
    --ccs-btn-color: {{ section.settings.button_text_color }};
    --ccs-overlay-color: {{ section.settings.overlay_color }};
  }

  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }

  .section-{{ section.id }}-heading {
    font-size: {{ section.settings.heading_font_size_mobile }}px;
    color: var(--ccs-heading-color);
    font-weight: {{ section.settings.heading_font_weight }};
  }

  .section-{{ section.id }}-subheading {
    font-size: {{ section.settings.subheading_font_size_mobile }}px;
    color: var(--ccs-subheading-color);
    font-weight: {{ section.settings.subheading_font_weight }};
    margin-top: 0.6rem;
    margin-bottom: 0;
  }

  #shopify-section-{{ section.id }} .ccs-slider-buttons .slider-button {
    color: var(--ccs-arrow-color);
  }

  #shopify-section-{{ section.id }} .ccs-slider-buttons .slider-counter {
    color: var(--ccs-counter-color);
  }

  #shopify-section-{{ section.id }} .ccs-arrow-hidden {
    visibility: hidden;
    pointer-events: none;
    width: 0;
    min-width: 0;
    padding: 0;
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .ccs-col-card {
    position: relative;
    border-radius: var(--ccs-card-radius);
    overflow: hidden;
    aspect-ratio: {{ section.settings.card_aspect_ratio }};
    display: block;
    text-decoration: none;
  }

  #shopify-section-{{ section.id }} .ccs-col-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s ease;
  }

  #shopify-section-{{ section.id }} .ccs-col-card:hover .ccs-col-card__image {
    transform: scale(1.04);
  }

  #shopify-section-{{ section.id }} .ccs-col-card__placeholder {
    width: 100%;
    height: 100%;
    background: #d9d9d9;
  }

  #shopify-section-{{ section.id }} .ccs-col-card__overlay {
    position: absolute;
    inset: 0;
    background-color: var(--ccs-overlay-color);
    opacity: {{ section.settings.overlay_opacity | times: 0.01 }};
    pointer-events: none;
  }

  #shopify-section-{{ section.id }} .ccs-col-card__title {
    position: absolute;
    top: 1.6rem;
    right: 1.2rem;
    left: auto;
    text-align: right;
    color: var(--ccs-card-title-color);
    font-size: {{ section.settings.card_title_size_mobile }}px;
    font-weight: {{ section.settings.card_title_weight }};
    letter-spacing: 0.04em;
    margin: 0;
    text-shadow: 0 1px 6px rgba(0,0,0,0.18);
  }

  #shopify-section-{{ section.id }} .ccs-col-card__footer {
    position: absolute;
    bottom: 1.4rem;
    left: 0;
    right: 0;
    display: flex;
    justify-content: center;
    padding: 0 1rem;
  }

  #shopify-section-{{ section.id }} .ccs-col-card__btn {
    background: var(--ccs-btn-bg);
    color: var(--ccs-btn-color);
    padding: 0.75rem 2rem;
    border-radius: 50px;
    font-size: {{ section.settings.button_font_size_mobile }}px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    display: inline-block;
    transition: opacity 0.2s;
    white-space: nowrap;
  }

  #shopify-section-{{ section.id }} .ccs-col-card__btn:hover {
    opacity: 0.82;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }

    .section-{{ section.id }}-heading {
      font-size: {{ section.settings.heading_font_size_desktop }}px;
    }

    .section-{{ section.id }}-subheading {
      font-size: {{ section.settings.subheading_font_size_desktop }}px;
    }

    #shopify-section-{{ section.id }} .ccs-col-card__title {
      font-size: {{ section.settings.card_title_size_desktop }}px;
      right: 1.6rem;
    }

    #shopify-section-{{ section.id }} .ccs-col-card__btn {
      font-size: {{ section.settings.button_font_size_desktop }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign columns_mobile_int = section.settings.columns_mobile | plus: 0
  assign show_slider_controls = false
  if section.settings.show_arrows or section.settings.show_counter
    assign show_slider_controls = true
  endif
  assign excluded_handle = section.settings.exclude_handle | strip
-%}

<div
  class="color-{{ section.settings.color_scheme }} isolate gradient"
  {% if section.settings.background_color != blank %}
    style="background-color: {{ section.settings.background_color }};"
  {% endif %}
>
  <div class="collection section-{{ section.id }}-padding{% if section.settings.full_width %} collection--full-width{% endif %}">

    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="collection__title title-wrapper title-wrapper--no-top-margin page-width title-wrapper--self-padded-tablet-down collection__title--desktop-slider">
        <div>
          {%- if section.settings.heading != blank -%}
            <h2 class="title {{ section.settings.heading_size }} section-{{ section.id }}-heading">
              {{ section.settings.heading | escape }}
            </h2>
          {%- endif -%}
          {%- if section.settings.subheading != blank -%}
            <p class="section-{{ section.id }}-subheading">
              {{ section.settings.subheading | escape }}
            </p>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}

    <slider-component class="slider-mobile-gutter{% if section.settings.full_width %} slider-component-full-width{% else %} page-width-desktop{% endif %} slider-component-desktop">
      <ul
        id="Slider-{{ section.id }}"
        class="grid product-grid grid--{{ section.settings.columns_desktop }}-col-desktop grid--{{ columns_mobile_int }}-col-tablet-down slider slider--desktop slider--tablet grid--peek"
        role="list"
        aria-label="{{ 'general.slider.name' | t }}"
      >
        {%- for collection in collections -%}
          {%- if collection.handle == 'frontpage' -%}{%- continue -%}{%- endif -%}
          {%- if excluded_handle != blank and collection.handle == excluded_handle -%}{%- continue -%}{%- endif -%}
          <li
            id="Slide-{{ section.id }}-{{ forloop.index }}"
            class="grid__item slider__slide"
          >
            <a href="{{ collection.url }}" class="ccs-col-card">
              {%- if collection.featured_image -%}
                <img
                  src="{{ collection.featured_image | image_url: width: 800 }}"
                  srcset="
                    {{ collection.featured_image | image_url: width: 400 }} 400w,
                    {{ collection.featured_image | image_url: width: 600 }} 600w,
                    {{ collection.featured_image | image_url: width: 800 }} 800w,
                    {{ collection.featured_image | image_url: width: 1200 }} 1200w
                  "
                  sizes="(min-width: 750px) {{ 100 | divided_by: section.settings.columns_desktop }}vw, {{ 100 | divided_by: columns_mobile_int }}vw"
                  alt="{{ collection.featured_image.alt | default: collection.title | escape }}"
                  width="{{ collection.featured_image.width }}"
                  height="{{ collection.featured_image.height }}"
                  loading="lazy"
                  class="ccs-col-card__image"
                >
              {%- else -%}
                <div class="ccs-col-card__placeholder"></div>
              {%- endif -%}

              <div class="ccs-col-card__overlay"></div>

              <h3 class="ccs-col-card__title">{{ collection.title | escape }}</h3>

              <div class="ccs-col-card__footer">
                <span class="ccs-col-card__btn">{{ section.settings.button_label }}</span>
              </div>
            </a>
          </li>
        {%- endfor -%}
      </ul>

      {%- if show_slider_controls -%}
        <div class="slider-buttons no-js-hidden ccs-slider-buttons">
          <button
            type="button"
            class="slider-button slider-button--prev{% unless section.settings.show_arrows %} ccs-arrow-hidden{% endunless %}"
            name="previous"
            aria-label="{{ 'general.slider.previous_slide' | t }}"
            aria-controls="Slider-{{ section.id }}"
          >
            {%- render 'icon-caret' -%}
          </button>
          {%- if section.settings.show_counter -%}
            <div class="slider-counter caption">
              <span class="slider-counter--current">1</span>
              <span aria-hidden="true"> / </span>
              <span class="visually-hidden">{{ 'general.slider.of' | t }}</span>
              <span class="slider-counter--total">{{ collections.size }}</span>
            </div>
          {%- endif -%}
          <button
            type="button"
            class="slider-button slider-button--next{% unless section.settings.show_arrows %} ccs-arrow-hidden{% endunless %}"
            name="next"
            aria-label="{{ 'general.slider.next_slide' | t }}"
            aria-controls="Slider-{{ section.id }}"
          >
            {%- render 'icon-caret' -%}
          </button>
        </div>
      {%- endif -%}
    </slider-component>

  </div>
</div>

{%- if section.settings.autoplay -%}
  <script>
    (function () {
      'use strict';
      var sliderId = 'Slider-{{ section.id }}';
      var speed = {{ section.settings.autoplay_speed | times: 1000 }};
      var intervalId;

      function autoSlide(slider, component) {
        var nextBtn = component.querySelector('button[name="next"]');
        if (!nextBtn) return;
        if (nextBtn.hasAttribute('disabled')) {
          slider.scrollTo({ left: 0, behavior: 'smooth' });
        } else {
          nextBtn.click();
        }
      }

      function init() {
        var slider = document.getElementById(sliderId);
        if (!slider) return;
        var component = slider.closest('slider-component');
        if (!component) return;

        function start() {
          intervalId = setInterval(function () {
            autoSlide(slider, component);
          }, speed);
        }

        function stop() {
          clearInterval(intervalId);
        }

        component.addEventListener('mouseover', stop);
        component.addEventListener('mouseleave', start);
        component.addEventListener('focusin', stop);
        component.addEventListener('focusout', start);

        start();
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init);
      } else {
        init();
      }
    })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Slider de colecciones",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Encabezado"
    },
    {
      "type": "text",
      "id": "heading",
      "default": "Nuestras colecciones",
      "label": "Título"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "h2", "label": "Pequeño" },
        { "value": "h1", "label": "Mediano" },
        { "value": "h0", "label": "Grande" }
      ],
      "default": "h1",
      "label": "Jerarquía del título"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Color del título",
      "default": "#111111"
    },
    {
      "type": "range",
      "id": "heading_font_size_desktop",
      "min": 12,
      "max": 72,
      "step": 1,
      "unit": "px",
      "label": "Tamaño del título — escritorio",
      "default": 36
    },
    {
      "type": "range",
      "id": "heading_font_size_mobile",
      "min": 12,
      "max": 60,
      "step": 1,
      "unit": "px",
      "label": "Tamaño del título — móvil",
      "default": 26
    },
    {
      "type": "select",
      "id": "heading_font_weight",
      "label": "Peso del título",
      "options": [
        { "value": "300", "label": "Light" },
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semibold" },
        { "value": "700", "label": "Bold" },
        { "value": "800", "label": "Extrabold" }
      ],
      "default": "700"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subtítulo"
    },
    {
      "type": "color",
      "id": "subheading_color",
      "label": "Color del subtítulo",
      "default": "#666666"
    },
    {
      "type": "range",
      "id": "subheading_font_size_desktop",
      "min": 10,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "Tamaño del subtítulo — escritorio",
      "default": 16
    },
    {
      "type": "range",
      "id": "subheading_font_size_mobile",
      "min": 10,
      "max": 32,
      "step": 1,
      "unit": "px",
      "label": "Tamaño del subtítulo — móvil",
      "default": 14
    },
    {
      "type": "select",
      "id": "subheading_font_weight",
      "label": "Peso del subtítulo",
      "options": [
        { "value": "300", "label": "Light" },
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semibold" },
        { "value": "700", "label": "Bold" }
      ],
      "default": "400"
    },
    {
      "type": "header",
      "content": "Cards de colección"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Color del overlay",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 80,
      "step": 5,
