      "label": "Tamaño del texto del botón — escritorio",
      "default": 13
    },
    {
      "type": "range",
      "id": "button_font_size_mobile",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Tamaño del texto del botón — móvil",
      "default": 11
    },
    {
      "type": "header",
      "content": "Columnas"
    },
    {
      "type": "range",
