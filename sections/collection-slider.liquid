    },
    {
      "type": "checkbox",
      "id": "show_counter",
      "default": true,
      "label": "Mostrar contador de slides"
    },
    {
      "type": "color",
      "id": "counter_color",
      "label": "Color del contador",
      "default": "#111111"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "default": false,
