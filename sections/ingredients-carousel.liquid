<link rel="stylesheet" href="{{ 'component-slider.css' | asset_url }}" media="print" onload="this.media='all'">
<noscript>{{ 'component-slider.css' | asset_url | stylesheet_tag }}</noscript>

{%- liquid
  assign columns_mobile_int = section.settings.columns_mobile | plus: 0
  assign ic_blocks = section.blocks | where: 'type', 'ingredient'
  assign show_badges_row = false
  if section.settings.show_badges
    if section.settings.badge_1_text != blank or section.settings.badge_2_text != blank
      assign show_badges_row = true
    endif
  endif

  assign image_protrusion = section.settings.image_height | minus: section.settings.card_padding_top
  if image_protrusion < 0
    assign image_protrusion = 0
  endif
  assign image_protrusion_mobile = section.settings.image_height_mobile | minus: section.settings.card_padding_top_mobile
  if image_protrusion_mobile < 0
    assign image_protrusion_mobile = 0
  endif
-%}

{%- style -%}
  .section-{{ section.id }}-padding {
    background-color: {{ section.settings.background_color }};
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }

  #shopify-section-{{ section.id }} .ing-carousel__heading {
    font-size: {{ section.settings.heading_font_size_mobile }}px;
  }

  #shopify-section-{{ section.id }} .ing-carousel__heading--accent {
    color: {{ section.settings.accent_color }};
  }

  #shopify-section-{{ section.id }} .ing-carousel__heading--normal {
    color: {{ section.settings.heading_color }};
  }

  #shopify-section-{{ section.id }} .ing-carousel__card-inner {
    border-radius: {{ section.settings.card_border_radius }}px;
    padding: {{ section.settings.card_padding_top_mobile }}px 16px 16px;
  }

  #shopify-section-{{ section.id }} .ing-carousel__track {
    gap: {{ section.settings.card_gap }}px;
  }

  #shopify-section-{{ section.id }} .ing-carousel__card {
    padding-top: {{ image_protrusion_mobile }}px;
  }

  #shopify-section-{{ section.id }} .ing-carousel__image {
    top: -{{ image_protrusion_mobile }}px;
    height: {{ section.settings.image_height_mobile }}px;
  }

  #shopify-section-{{ section.id }} .ing-carousel__button {
    background: linear-gradient(180deg, {{ section.settings.button_gradient_start }}, {{ section.settings.button_gradient_end }});
    color: {{ section.settings.button_text_color }};
    border-radius: {{ section.settings.button_border_radius }}px;
  }

  #shopify-section-{{ section.id }} .ing-carousel__badge-icon {
    color: {{ section.settings.badges_icon_color }};
  }

  #shopify-section-{{ section.id }} .ing-carousel__arrow {
    color: {{ section.settings.arrows_color }};
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }

    #shopify-section-{{ section.id }} .ing-carousel__heading {
      font-size: {{ section.settings.heading_font_size_desktop }}px;
    }

    #shopify-section-{{ section.id }} .ing-carousel__card-inner {
      padding: {{ section.settings.card_padding_top }}px 16px 16px;
    }

    #shopify-section-{{ section.id }} .ing-carousel__card {
      padding-top: {{ image_protrusion }}px;
    }

    #shopify-section-{{ section.id }} .ing-carousel__image {
      top: -{{ image_protrusion }}px;
      height: {{ section.settings.image_height }}px;
    }
  }
{%- endstyle -%}

<div class="ing-carousel section-{{ section.id }}-padding">
  <div class="ing-carousel__container page-width">
    {%- if section.settings.heading_accent != blank or section.settings.heading_normal != blank -%}
      <h2 class="ing-carousel__heading">
        {%- if section.settings.heading_accent != blank -%}
          <span class="ing-carousel__heading--accent">{{ section.settings.heading_accent | escape }}</span>
        {%- endif -%}
        {%- if section.settings.heading_normal != blank -%}
          <span class="ing-carousel__heading--normal">{{ section.settings.heading_normal | escape }}</span>
        {%- endif -%}
      </h2>
    {%- endif -%}

    {%- if ic_blocks.size > 0 -%}
      <slider-component class="ing-carousel__wrapper page-width-desktop">
        <ul
          id="Slider-{{ section.id }}"
          class="ing-carousel__track grid grid--{{ section.settings.columns_desktop }}-col-desktop grid--{{ section.settings.columns_tablet }}-col-tablet grid--{{ columns_mobile_int }}-col-tablet-down slider slider--desktop slider--tablet grid--peek"
          role="list"
          aria-label="{{ 'general.slider.name' | t }}"
        >
          {%- for block in ic_blocks -%}
            <li
              id="Slide-{{ section.id }}-{{ forloop.index }}"
              class="ing-carousel__card grid__item slider__slide"
              {{ block.shopify_attributes }}
            >
              <div class="ing-carousel__card-inner" style="background-color: {{ block.settings.card_bg_color }};">
                <div class="ing-carousel__image">
                  {%- if block.settings.image != blank -%}
                    <img
                      src="{{ block.settings.image | image_url: width: 800 }}"
                      srcset="
                        {{ block.settings.image | image_url: width: 400 }} 400w,
                        {{ block.settings.image | image_url: width: 600 }} 600w,
                        {{ block.settings.image | image_url: width: 800 }} 800w
                      "
                      sizes="(min-width: 990px) {{ 100 | divided_by: section.settings.columns_desktop }}vw, (min-width: 750px) {{ 100 | divided_by: section.settings.columns_tablet }}vw, 60vw"
                      alt="{{ block.settings.image.alt | default: block.settings.title | escape }}"
                      width="{{ block.settings.image.width }}"
                      height="{{ block.settings.image.height }}"
                      loading="lazy"
                    >
                  {%- else -%}
                    {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
                  {%- endif -%}
                </div>
                <div class="ing-carousel__content">
                  {%- if block.settings.title != blank -%}
                    <h3 class="ing-carousel__title">{{ block.settings.title | escape }}</h3>
                  {%- endif -%}
                  {%- if block.settings.description != blank -%}
                    <p class="ing-carousel__description">{{ block.settings.description | escape }}</p>
                  {%- endif -%}
                </div>
              </div>
            </li>
          {%- endfor -%}
        </ul>

        {%- if section.settings.show_arrows -%}
          <div class="slider-buttons no-js-hidden">
            <button
              type="button"
              class="slider-button slider-button--prev ing-carousel__arrow"
              name="previous"
              aria-label="{{ 'general.slider.previous_slide' | t }}"
              aria-controls="Slider-{{ section.id }}"
            >
              {%- render 'icon-caret' -%}
            </button>
            <button
              type="button"
              class="slider-button slider-button--next ing-carousel__arrow"
              name="next"
              aria-label="{{ 'general.slider.next_slide' | t }}"
              aria-controls="Slider-{{ section.id }}"
            >
              {%- render 'icon-caret' -%}
            </button>
          </div>
        {%- endif -%}
      </slider-component>
    {%- endif -%}

    {%- if section.settings.button_label != blank or show_badges_row -%}
      <div class="ing-carousel__footer">
        {%- if section.settings.button_label != blank -%}
          <a href="{{ section.settings.button_link | default: '#' }}" class="ing-carousel__button">
            {{ section.settings.button_label | escape }}
          </a>
        {%- endif -%}
        {%- if show_badges_row -%}
          <div class="ing-carousel__badges">
            {%- if section.settings.badge_1_text != blank -%}
              <div class="ing-carousel__badge">
                <span class="ing-carousel__badge-icon">
                  <svg xmlns="http://www.w3.org/2000/svg" width="17" height="20" viewBox="0 0 17 20" fill="none" aria-hidden="true" focusable="false">
