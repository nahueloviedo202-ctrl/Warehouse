                </span>
                <span class="ing-carousel__badge-text">{{ section.settings.badge_2_text | escape }}</span>
              </div>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</div>

{%- style -%}
  .ing-carousel {
    width: 100%;
    overflow: hidden;
  }
  .ing-carousel__container {
    display: flex;
    flex-direction: column;
    gap: 24px;
    align-items: center;
  }
  .ing-carousel__heading {
    font-weight: 800;
    line-height: 1.2;
    text-transform: uppercase;
    text-align: center;
    margin: 0;
  }
  .ing-carousel__heading--accent {
    margin-right: 8px;
  }
  .ing-carousel__wrapper {
    width: 100%;
  }
  .ing-carousel__track {
    margin-bottom: 0;
  }
  .ing-carousel__card-inner {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
  }
  .ing-carousel__image {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    width: calc(100% - 32px);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: visible;
  }
  .ing-carousel__image img,
  .ing-carousel__image .placeholder-svg {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }
  .ing-carousel__content {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .ing-carousel__title {
    font-weight: 700;
    font-size: 18px;
    line-height: 1.44;
    margin: 0;
  }
  .ing-carousel__description {
    font-size: 16px;
    line-height: 1.25;
    margin: 0;
  }
  .ing-carousel__footer {
    display: flex;
    flex-direction: column;
    gap: 10px;
    align-items: center;
    width: 100%;
    max-width: 400px;
  }
  .ing-carousel__button {
    width: 100%;
    height: 60px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 18px;
    line-height: 1.44;
    text-transform: uppercase;
    text-decoration: none;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .ing-carousel__button:hover {
    transform: translateY(-2px);
  }
  .ing-carousel__badges {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    gap: 16px;
  }
  .ing-carousel__badge {
    display: flex;
    align-items: center;
    gap: 2px;
  }
  .ing-carousel__badge-icon {
    width: 17px;
    height: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .ing-carousel__badge-icon svg {
    width: 100%;
    height: 100%;
    display: block;
  }
  .ing-carousel__badge-text {
    font-weight: 600;
    font-size: 14px;
  }

  @media screen and (max-width: 989px) {
    .ing-carousel__footer {
      max-width: 100%;
    }
    .ing-carousel__button {
      max-width: 400px;
    }
    .ing-carousel__badges {
      max-width: 400px;
      flex-wrap: wrap;
      justify-content: center;
    }
  }

  @media screen and (max-width: 749px) {
    .ing-carousel__container {
      gap: 24px;
    }
    .ing-carousel__title {
      font-size: 16px;
    }
    .ing-carousel__description {
      font-size: 14px;
    }
    .ing-carousel__button {
      font-size: 16px;
      height: 52px;
    }
    .ing-carousel__badge-text {
      font-size: 12px;
    }
    .ing-carousel__badges {
      flex-direction: column;
      gap: 8px;
    }
  }
{%- endstyle -%}

{%- if section.settings.autoplay -%}
  <script>
    (function () {
      'use strict';
      var sliderId = 'Slider-{{ section.id }}';
      var speed = {{ section.settings.autoplay_speed | times: 1000 }};
      var intervalId;

      function autoSlide(slider, component) {
        var nextBtn = component.querySelector('button[name="next"]');
        if (!nextBtn) return;
        if (nextBtn.hasAttribute('disabled')) {
          slider.scrollTo({ left: 0, behavior: 'smooth' });
        } else {
          nextBtn.click();
        }
      }

      function init() {
        var slider = document.getElementById(sliderId);
        if (!slider) return;
        var component = slider.closest('slider-component');
        if (!component) return;

        function start() {
          intervalId = setInterval(function () {
            autoSlide(slider, component);
          }, speed);
        }

        function stop() {
          clearInterval(intervalId);
        }

        component.addEventListener('mouseover', stop);
        component.addEventListener('mouseleave', start);
        component.addEventListener('focusin', stop);
        component.addEventListener('focusout', start);

        start();
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init);
      } else {
        init();
      }
    })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Carrusel de ingredientes",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Encabezado"
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Título (color de acento)",
      "default": "Powerful Ingredients"
    },
    {
      "type": "text",
      "id": "heading_normal",
      "label": "Título (color normal)",
      "default": "for Peak Performance"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Color de acento",
      "default": "#a45b2c"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Color del título",
      "default": "#1a1a1a"
    },
    {
      "type": "range",
      "id": "heading_font_size_desktop",
      "label": "Tamaño de título (desktop)",
      "min": 18,
      "max": 48,
      "step": 1,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "heading_font_size_mobile",
      "label": "Tamaño de título (mobile)",
      "min": 16,
      "max": 36,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "header",
      "content": "Colores"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Fondo de la sección",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Espaciado (desktop)"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding superior",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding inferior",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 12
    },
    {
      "type": "header",
      "content": "Espaciado (mobile)"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding superior",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding inferior",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 12
    },
    {
      "type": "header",
      "content": "Carrusel — columnas"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Tarjetas visibles (desktop)",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "columns_tablet",
      "label": "Tarjetas visibles (tablet)",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 2
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Tarjetas visibles (mobile)",
      "options": [
        { "value": "1", "label": "1 tarjeta (con vista previa)" },
        { "value": "2", "label": "2 tarjetas" }
      ],
      "default": "1"
    },
    {
      "type": "header",
      "content": "Carrusel — comportamiento"
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Mostrar flechas de navegación",
      "default": true
    },
    {
      "type": "color",
      "id": "arrows_color",
      "label": "Color de las flechas",
      "default": "#1a1a1a"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
