                  </svg>
                </span>
                <span class="ing-carousel__badge-text">{{ section.settings.badge_1_text | escape }}</span>
              </div>
            {%- endif -%}
            {%- if section.settings.badge_2_text != blank -%}
              <div class="ing-carousel__badge">
                <span class="ing-carousel__badge-icon">
                  <svg xmlns="http://www.w3.org/2000/svg" width="17" height="20" viewBox="0 0 17 20" fill="none" aria-hidden="true" focusable="false">
