{{ 'section-why-we-love-it.css' | asset_url | stylesheet_tag }}
{{ 'component-rte.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }

  #shopify-section-{{ section.id }} {
    --why-we-love-circle-size-desktop: {{ section.settings.circle_size_desktop }}px;
    --why-we-love-circle-size-mobile: {{ section.settings.circle_size_mobile }}px;
    {%- if section.settings.circle_border_color != blank -%}
    --why-we-love-circle-border-color: {{ section.settings.circle_border_color }};
    {%- endif -%}
    {%- if section.settings.badge_icon_bg_color != blank -%}
    --why-we-love-badge-icon-bg: {{ section.settings.badge_icon_bg_color }};
    {%- endif -%}
    {%- if section.settings.badge_icon_svg_color != blank -%}
    --why-we-love-badge-icon-svg: {{ section.settings.badge_icon_svg_color }};
    {%- endif -%}
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .section-{{ section.id }}-heading {
    font-size: {{ section.settings.heading_font_size_mobile }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-heading {
      font-size: {{ section.settings.heading_font_size_desktop }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign accent_class = 'color-foreground-' | append: section.settings.accent_color_scheme
  assign feature_blocks = section.blocks | where: 'type', 'feature'
  assign badge_blocks = section.blocks | where: 'type', 'badge'
-%}

<div class="color-{{ section.settings.color_scheme }} gradient"{% if section.settings.background_color != blank %} style="background-color: {{ section.settings.background_color }};"{% endif %}>
  <div class="why-we-love page-width section-{{ section.id }}-padding">
    {%- if section.settings.heading != blank -%}
      <h2
        class="why-we-love__heading {{ section.settings.heading_size }} {{ accent_class }}{% if section.settings.heading_italic %} why-we-love__heading--italic{% endif %} section-{{ section.id }}-heading"
        style="{% if section.settings.heading_color != blank %}color: {{ section.settings.heading_color }};{% endif %}{% if section.settings.heading_font_weight != blank %}font-weight: {{ section.settings.heading_font_weight }};{% endif %}"
      >
        {{ section.settings.heading | escape }}
      </h2>
    {%- endif -%}

    <div class="why-we-love__grid{% if section.settings.text_alignment == 'center' %} why-we-love__grid--center{% endif %}">
      <div class="why-we-love__column why-we-love__column--left">
        {%- for block in feature_blocks -%}
          {%- style -%}
            .block-{{ block.id }}-heading { font-size: {{ block.settings.heading_font_size_mobile }}px; }
            .block-{{ block.id }}-text { font-size: {{ block.settings.text_font_size_mobile }}px; }
            @media screen and (min-width: 750px) {
              .block-{{ block.id }}-heading { font-size: {{ block.settings.heading_font_size_desktop }}px; }
              .block-{{ block.id }}-text { font-size: {{ block.settings.text_font_size_desktop }}px; }
            }
          {%- endstyle -%}
          {%- if block.settings.position == 'left' -%}
            <div class="why-we-love__feature" {{ block.shopify_attributes }}>
              {%- if block.settings.heading != blank -%}
                <h3 class="why-we-love__feature-heading h4 {{ accent_class }}{% if section.settings.heading_italic %} why-we-love__feature-heading--italic{% endif %} block-{{ block.id }}-heading" style="{% if block.settings.heading_color != blank %}color: {{ block.settings.heading_color }};{% endif %}{% if block.settings.heading_font_weight != blank %}font-weight: {{ block.settings.heading_font_weight }};{% endif %}">
                  {{ block.settings.heading | escape }}
                </h3>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <div class="why-we-love__feature-text rte block-{{ block.id }}-text" style="{% if block.settings.text_color != blank %}color: {{ block.settings.text_color }};{% endif %}{% if block.settings.text_font_weight != blank %}font-weight: {{ block.settings.text_font_weight }};{% endif %}">{{ block.settings.text }}</div>
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>

      <div class="why-we-love__media">
        <div class="why-we-love__media-circle {{ accent_class }}">
          {%- if section.settings.image != blank -%}
            {{
              section.settings.image
              | image_url: width: 800
              | image_tag: loading: 'lazy', sizes: '(min-width: 750px) 380px, 220px', widths: '220, 320, 440, 560, 760'
            }}
          {%- else -%}
            {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
        </div>
      </div>

      <div class="why-we-love__column why-we-love__column--right">
        {%- for block in feature_blocks -%}
          {%- if block.settings.position == 'right' -%}
            <div class="why-we-love__feature" {{ block.shopify_attributes }}>
              {%- if block.settings.heading != blank -%}
                <h3 class="why-we-love__feature-heading h4 {{ accent_class }}{% if section.settings.heading_italic %} why-we-love__feature-heading--italic{% endif %} block-{{ block.id }}-heading" style="{% if block.settings.heading_color != blank %}color: {{ block.settings.heading_color }};{% endif %}{% if block.settings.heading_font_weight != blank %}font-weight: {{ block.settings.heading_font_weight }};{% endif %}">
                  {{ block.settings.heading | escape }}
                </h3>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <div class="why-we-love__feature-text rte block-{{ block.id }}-text" style="{% if block.settings.text_color != blank %}color: {{ block.settings.text_color }};{% endif %}{% if block.settings.text_font_weight != blank %}font-weight: {{ block.settings.text_font_weight }};{% endif %}">{{ block.settings.text }}</div>
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>

    {%- if badge_blocks.size > 0 -%}
      <ul class="why-we-love__badges list-unstyled" role="list">
        {%- for block in badge_blocks -%}
          <li class="why-we-love__badge" {{ block.shopify_attributes }}>
            <div class="why-we-love__badge-icon {{ accent_class }}">
              {%- if block.settings.image != blank -%}
                <img
                  src="{{ block.settings.image | image_url: width: 160 }}"
                  {% if block.settings.image.alt != blank %}
                    alt="{{ block.settings.image.alt | escape }}"
                  {% else %}
                    role="presentation"
                  {% endif %}
                  loading="lazy"
                  width="64"
                  height="64"
                >
              {%- else -%}
                {%- render 'icon-accordion', icon: block.settings.icon -%}
              {%- endif -%}
            </div>
            {%- if block.settings.label != blank -%}
              <p class="why-we-love__badge-label caption">{{ block.settings.label | escape }}</p>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</div>

