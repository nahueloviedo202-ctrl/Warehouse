{{ 'section-results.css' | asset_url | stylesheet_tag }}
{{ 'component-rte.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }}">
  <div class="page-width section-{{ section.id }}-padding">
    <div class="content-and-results{% if section.settings.layout == 'results_first' %} content-and-results--results-first{% endif %}{% if section.settings.title == blank and section.settings.text == blank and section.settings.image == blank %} content-and-results--no-content{% endif %}">
      {%- unless section.settings.title == blank
        and section.settings.text == blank
        and section.settings.image == blank
      -%}
        <div class="content-container center">
          {%- unless section.settings.title == blank -%}
            {% style %}
              .section-{{ section.id }}-heading {
                font-size: {{ section.settings.heading_font_size_mobile }}px;
                {% if section.settings.heading_color != blank %}color: {{ section.settings.heading_color }};{% endif %}
                {% if section.settings.heading_font_weight != blank %}font-weight: {{ section.settings.heading_font_weight }};{% endif %}
              }
              @media screen and (min-width: 750px) {
                .section-{{ section.id }}-heading {
                  font-size: {{ section.settings.heading_font_size_desktop }}px;
                }
              }
            {% endstyle %}
            <h2 class="title {{ section.settings.heading_size }} section-{{ section.id }}-heading">
              {{ section.settings.title | escape }}
            </h2>
          {%- endunless -%}
          {%- unless section.settings.text == blank -%}
            {% style %}
              .section-{{ section.id }}-text {
                font-size: {{ section.settings.text_font_size_mobile }}px;
                {% if section.settings.text_color != blank %}color: {{ section.settings.text_color }};{% endif %}
                {% if section.settings.text_font_weight != blank %}font-weight: {{ section.settings.text_font_weight }};{% endif %}
              }
              @media screen and (min-width: 750px) {
                .section-{{ section.id }}-text {
                  font-size: {{ section.settings.text_font_size_desktop }}px;
                }
              }
            {% endstyle %}
            <div class="section-{{ section.id }}-text">{{ section.settings.text }}</div>
          {%- endunless -%}
          {%- unless section.settings.image == blank -%}
            <div class="content-and-results__image">
              {{ section.settings.image | image_url: width: 1000 | image_tag: loading: 'lazy', width: 600 }}
            </div>
          {%- endunless -%}
        </div>
      {%- endunless -%}
      <div class="results-container">
        <div class="results">
          {%- unless section.settings.results_headline == blank -%}
            {% style %}
              .section-{{ section.id }}-results-headline {
                font-size: {{ section.settings.results_headline_font_size_mobile }}px;
                {% if section.settings.results_headline_color != blank %}color: {{ section.settings.results_headline_color }};{% endif %}
                {% if section.settings.results_headline_font_weight != blank %}font-weight: {{ section.settings.results_headline_font_weight }};{% endif %}
              }
              @media screen and (min-width: 750px) {
                .section-{{ section.id }}-results-headline {
                  font-size: {{ section.settings.results_headline_font_size_desktop }}px;
                }
              }
            {% endstyle %}
            <h3 class="title {{ section.settings.results_headline_size }}{% if section.settings.results_headline_alignment == 'center' %} center{% endif %} section-{{ section.id }}-results-headline">
              {{ section.settings.results_headline | escape }}
            </h3>
          {%- endunless -%}
          <div class="results__rows-container">
            {%- for row in section.blocks -%}
              <div class="results__row">
                <div class="results__percentage" style="--percentage: {{ row.settings.percentage }}%">
                  <p>{{ row.settings.percentage }}%</p>
                </div>
                {% style %}
                  .block-{{ row.id }}-text {
                    font-size: {{ row.settings.row_text_font_size_mobile }}px;
                    {% if row.settings.row_text_color != blank %}color: {{ row.settings.row_text_color }};{% endif %}
                    {% if row.settings.row_text_font_weight != blank %}font-weight: {{ row.settings.row_text_font_weight }};{% endif %}
                  }
                  @media screen and (min-width: 750px) {
                    .block-{{ row.id }}-text {
                      font-size: {{ row.settings.row_text_font_size_desktop }}px;
                    }
                  }
                {% endstyle %}
                <div class="results__text block-{{ row.id }}-text">
                  {{ row.settings.row_text }}
                </div>
              </div>
            {%- endfor -%}
          </div>
          {%- unless section.settings.caption == blank -%}
            <div class="results__caption">
              {{ section.settings.caption }}
            </div>
          {%- endunless -%}
          {%- if section.settings.button_label != blank -%}
            <a
              {% if section.settings.link %}
                href="{{ section.settings.link }}"
              {% else %}
                role="link" aria-disabled="true"
              {% endif %}
              class="button btn--mt-center {% if section.settings.button_style_secondary %}button--secondary{% else %}button--primary{% endif %}"
            >
              {{- section.settings.button_label | escape -}}
            </a>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
    "name": "Results",
    "settings": [
        {
            "type": "text",
            "id": "title",
            "default": "Results",
            "label": "Heading"
        },
        {
          "type": "select",
          "id": "heading_size",
          "options": [
            {
              "value": "h2",
              "label": "t:sections.all.heading_size.options__1.label"
            },
            {
              "value": "h1",
              "label": "t:sections.all.heading_size.options__2.label"
            },
            {
              "value": "h0",
              "label": "t:sections.all.heading_size.options__3.label"
            }
          ],
          "default": "h1",
          "label": "t:sections.all.heading_size.label"
        },
        {
          "type": "header",
          "content": "Tipografía — Encabezado"
        },
        {
          "type": "color",
          "id": "heading_color",
          "label": "Color"
        },
        {
          "type": "range",
          "id": "heading_font_size_desktop",
          "min": 10,
          "max": 64,
          "step": 1,
          "unit": "px",
          "label": "Tamaño escritorio (px)",
          "default": 36
        },
        {
          "type": "range",
          "id": "heading_font_size_mobile",
          "min": 10,
          "max": 60,
          "step": 1,
          "unit": "px",
          "label": "Tamaño móvil (px)",
          "default": 28
        },
        {
          "type": "select",
          "id": "heading_font_weight",
          "label": "Peso",
          "options": [
            { "value": "300", "label": "Light" },
            { "value": "400", "label": "Regular" },
            { "value": "500", "label": "Medium" },
            { "value": "600", "label": "Semibold" },
            { "value": "700", "label": "Bold" },
            { "value": "800", "label": "Extrabold" }
          ],
          "default": "700"
        },
        {
          "type": "header",
          "content": "Tipografía — Texto"
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "Color"
        },
        {
          "type": "range",
          "id": "text_font_size_desktop",
          "min": 10,
          "max": 64,
          "step": 1,
          "unit": "px",
          "label": "Tamaño escritorio (px)",
          "default": 16
        },
        {
          "type": "range",
          "id": "text_font_size_mobile",
          "min": 10,
          "max": 60,
          "step": 1,
          "unit": "px",
          "label": "Tamaño móvil (px)",
          "default": 15
        },
        {
          "type": "select",
          "id": "text_font_weight",
          "label": "Peso",
          "options": [
            { "value": "300", "label": "Light" },
            { "value": "400", "label": "Regular" },
            { "value": "500", "label": "Medium" },
            { "value": "600", "label": "Semibold" },
            { "value": "700", "label": "Bold" },
            { "value": "800", "label": "Extrabold" }
          ],
          "default": "400"
        },
        {
            "type": "richtext",
            "id": "text",
            "default": "<p>Talk about results of your customers and how your product improved their life.</p>",
            "label": "Text"
        },
        {
            "type": "image_picker",
            "id": "image",
            "label": "Image"
        },
        {
          "type": "select",
          "id": "color_scheme",
          "options": [
            {
              "value": "accent-1",
              "label": "t:sections.all.colors.accent_1.label"
            },
            {
              "value": "accent-2",
              "label": "t:sections.all.colors.accent_2.label"
            },
            {
              "value": "background-1",
              "label": "t:sections.all.colors.background_1.label"
            },
            {
              "value": "background-2",
              "label": "t:sections.all.colors.background_2.label"
            },
            {
              "value": "inverse",
              "label": "t:sections.all.colors.inverse.label"
            }
          ],
          "default": "background-1",
          "label": "t:sections.all.colors.label"
        },
        {
            "type": "select",
            "id": "layout",
            "options": [
                {
                    "value": "results_first",
                    "label": "Results first"
                },
                {
                    "value": "results_second",
                    "label": "Results second"
                }
            ],
            "default": "results_second",
            "label": "Desktop results placement"
        },
        {
          "type": "header",
          "content": "Results"
        },
        {
            "type": "text",
            "id": "results_headline",
            "default": "Results heading",
            "label": "Results heading"
        },
        {
            "type": "select",
            "id": "results_headline_size",
            "options": [
                {
                    "value": "h3",
                    "label": "Small"
                },
                {
                    "value": "h2",
                    "label": "Medium"
                },
                {
                    "value": "h1",
                    "label": "Large"
                }
            ],
            "default": "h2",
            "label": "Results heading size"
        },
        {
            "type": "select",
            "id": "results_headline_alignment",
            "options": [
                {
                    "value": "left",
                    "label": "Left"
                },
                {
                    "value": "center",
                    "label": "Center"
                }
            ],
            "default": "left",
            "label": "Results heading alignment"
        },
        {
          "type": "header",
          "content": "Tipografía — Título de resultados"
        },
        {
          "type": "color",
          "id": "results_headline_color",
          "label": "Color"
        },
        {
          "type": "range",
          "id": "results_headline_font_size_desktop",
          "min": 10,
          "max": 64,
          "step": 1,
          "unit": "px",
          "label": "Tamaño escritorio (px)",
          "default": 28
        },
        {
          "type": "range",
          "id": "results_headline_font_size_mobile",
          "min": 10,
          "max": 60,
          "step": 1,
          "unit": "px",
          "label": "Tamaño móvil (px)",
          "default": 22
        },
        {
          "type": "select",
          "id": "results_headline_font_weight",
          "label": "Peso",
          "options": [
            { "value": "300", "label": "Light" },
            { "value": "400", "label": "Regular" },
            { "value": "500", "label": "Medium" },
            { "value": "600", "label": "Semibold" },
            { "value": "700", "label": "Bold" },
            { "value": "800", "label": "Extrabold" }
          ],
          "default": "700"
        },
        {
            "type": "richtext",
            "id": "caption",
            "default": "<p>Caption about the results and/or link for their proof.</p>",
            "label": "Caption"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "t:sections.slideshow.blocks.slide.settings.button_label.label",
          "info": "t:sections.slideshow.blocks.slide.settings.button_label.info"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:sections.slideshow.blocks.slide.settings.link.label"
        },
        {
          "type": "checkbox",
          "id": "button_style_secondary",
          "label": "t:sections.slideshow.blocks.slide.settings.secondary_style.label",
          "default": false
        },
        {
        "type": "header",
        "content": "t:sections.all.padding.section_padding_heading_desktop"
        },
        {
        "type": "range",
        "id": "padding_top",
        "min": 0,
        "max": 100,
        "step": 4,
        "unit": "px",
        "label": "t:sections.all.padding.padding_top",
        "default": 36
        },
        {
        "type": "range",
        "id": "padding_bottom",
        "min": 0,
        "max": 100,
        "step": 4,
        "unit": "px",
        "label": "t:sections.all.padding.padding_bottom",
        "default": 36
        },
        {
        "type": "header",
        "content": "t:sections.all.padding.section_padding_heading_mobile"
        },
        {
        "type": "range",
        "id": "padding_top_mobile",
        "min": 0,
        "max": 100,
        "step": 4,
        "unit": "px",
        "label": "t:sections.all.padding.padding_top_mobile",
        "default": 28
        },
        {
        "type": "range",
        "id": "padding_bottom_mobile",
        "min": 0,
        "max": 100,
        "step": 4,
        "unit": "px",
        "label": "t:sections.all.padding.padding_bottom_mobile",
        "default": 28
        }
    ],
    "blocks": [
        {
            "type": "row",
            "name": "Result row",
            "settings": [
                {
                    "type": "range",
                    "id": "percentage",
                    "min": 0,
                    "max": 100,
                    "default": 90,
                    "step": 1,
                    "label": "Percentage"
                },
                {
                    "type": "richtext",
                    "id": "row_text",
                    "default": "<p>Noticed that this product has significantly improved their life.</p>",
                    "label": "Result"
                },
                {
                    "type": "header",
                    "content": "Tipografía — Texto del resultado"
                },
                {
                    "type": "color",
                    "id": "row_text_color",
                    "label": "Color"
                },
                {
                    "type": "range",
                    "id": "row_text_font_size_desktop",
                    "min": 10,
                    "max": 64,
                    "step": 1,
                    "unit": "px",
                    "label": "Tamaño escritorio (px)",
                    "default": 15
                },
                {
                    "type": "range",
                    "id": "row_text_font_size_mobile",
                    "min": 10,
                    "max": 60,
                    "step": 1,
                    "unit": "px",
                    "label": "Tamaño móvil (px)",
                    "default": 14
                },
                {
                    "type": "select",
                    "id": "row_text_font_weight",
                    "label": "Peso",
                    "options": [
                        { "value": "300", "label": "Light" },
                        { "value": "400", "label": "Regular" },
                        { "value": "500", "label": "Medium" },
                        { "value": "600", "label": "Semibold" },
                        { "value": "700", "label": "Bold" },
                        { "value": "800", "label": "Extrabold" }
                    ],
                    "default": "400"
                }
            ]
        }
    ],
    "presets": [
        {
            "name": "Results",
            "blocks": [
                {
                "type": "row"
                },
                {
                "type": "row"
                },
                {
                "type": "row"
                }
            ]
        }
    ],
    "disabled_on": {
        "groups": ["header", "footer"]
    }
}
{% endschema %}
