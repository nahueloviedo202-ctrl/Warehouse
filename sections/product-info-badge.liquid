{{ 'section-product-info-badge.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }

  .pib--{{ section.id }} {
    background-color: {{ section.settings.bg_color }};
    border: {{ section.settings.border_width }}px solid {{ section.settings.border_color }};
    border-radius: {{ section.settings.border_radius }}px;
    padding: {{ section.settings.padding_vertical_mobile }}px {{ section.settings.padding_horizontal_mobile }}px;
    gap: {{ section.settings.items_gap_mobile }}px;
  }

  .pib--{{ section.id }} .pib__icon {
    width: {{ section.settings.icon_size_mobile }}px;
    height: {{ section.settings.icon_size_mobile }}px;
  }

  .pib--{{ section.id }} .pib__icon svg,
  .pib--{{ section.id }} .pib__icon img {
    width: {{ section.settings.icon_size_mobile }}px;
    height: {{ section.settings.icon_size_mobile }}px;
    fill: {{ section.settings.icon_color }};
  }

  .pib--{{ section.id }} .pib__label,
  .pib--{{ section.id }} .pib__sublabel {
    font-size: {{ section.settings.font_size_mobile }}px;
    color: {{ section.settings.text_color }};
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }

    .pib--{{ section.id }} {
      padding: {{ section.settings.padding_vertical }}px {{ section.settings.padding_horizontal }}px;
      gap: {{ section.settings.items_gap }}px;
    }

    .pib--{{ section.id }} .pib__icon {
      width: {{ section.settings.icon_size }}px;
      height: {{ section.settings.icon_size }}px;
    }

    .pib--{{ section.id }} .pib__icon svg,
    .pib--{{ section.id }} .pib__icon img {
      width: {{ section.settings.icon_size }}px;
      height: {{ section.settings.icon_size }}px;
    }

    .pib--{{ section.id }} .pib__label,
    .pib--{{ section.id }} .pib__sublabel {
      font-size: {{ section.settings.font_size }}px;
    }
  }
{%- endstyle -%}

<div class="pib pib--{{ section.id }} section-{{ section.id }}-padding">
  {%- for block in section.blocks -%}
    {%- if block.type == 'badge' -%}
      <div class="pib__item" {{ block.shopify_attributes }}>
        <span class="pib__icon" aria-hidden="true">
          {%- if block.settings.custom_icon != blank -%}
            {{
              block.settings.custom_icon
              | image_url: width: 80
              | image_tag:
                loading: 'lazy',
                widths: '20, 40, 80',
                alt: block.settings.custom_icon.alt | default: block.settings.label | escape
            }}
          {%- elsif block.settings.icon != 'none' -%}
            {%- render 'icon-accordion', icon: block.settings.icon -%}
          {%- endif -%}
        </span>
        <p class="pib__text">
          {%- if block.settings.label != blank -%}
            <strong class="pib__label">{{ block.settings.label | escape }}</strong>
          {%- endif -%}
          {%- if block.settings.sublabel != blank -%}
            <span class="pib__sublabel"> {{ block.settings.sublabel | escape }}</span>
          {%- endif -%}
        </p>
      </div>
    {%- endif -%}
  {%- endfor -%}
</div>

{% schema %}
{
  "name": "Badges de producto",
  "tag": "section",
  "class": "section-product-info-badge",
  "settings": [
