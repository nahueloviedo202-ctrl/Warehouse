{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  {%- assign pl_opacity = section.settings.logo_opacity | divided_by: 100.0 -%}
  {%- assign mobile_img_height = section.settings.img_height | times: 0.8 | round: 0 -%}
  .product-press-logos-{{ section.id }} {
    width: 100%;
    padding-top: 14px;
    border-top: 1px solid {{ section.settings.border_color }};
  }
  .product-press-logos-{{ section.id }} .product-press-logos__heading {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: {{ section.settings.text_color }};
    opacity: {{ pl_opacity }};
    text-align: center;
    margin: 0 0 10px;
  }
  .product-press-logos-{{ section.id }} .product-press-logos__row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: {{ section.settings.logos_gap }}px;
    flex-wrap: wrap;
  }
  .product-press-logos-{{ section.id }} .product-press-logos__item {
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .product-press-logos-{{ section.id }} .product-press-logos__img {
    height: {{ section.settings.img_height }}px;
    width: auto;
    max-width: 100%;
    object-fit: contain;
    opacity: {{ pl_opacity }};
    filter: grayscale({{ section.settings.grayscale }}%);
  }
  .product-press-logos-{{ section.id }} .product-press-logos__text {
    font-size: {{ section.settings.text_size }}px;
    letter-spacing: 0.08em;
    color: {{ section.settings.text_color }};
    opacity: {{ pl_opacity }};
    white-space: nowrap;
    line-height: 1;
  }
  @media screen and (max-width: 749px) {
    .product-press-logos-{{ section.id }} .product-press-logos__row {
      width: 100%;
      justify-content: space-around;
      flex-wrap: nowrap;
      gap: 2px;
    }
    .product-press-logos-{{ section.id }} .product-press-logos__item {
      flex: 1;
      min-width: 0;
      overflow: hidden;
    }
    .product-press-logos-{{ section.id }} .product-press-logos__text {
      font-size: 3vw;
      letter-spacing: 0.02em;
      text-align: center;
      display: block;
      white-space: nowrap;
      overflow: hidden;
    }
    .product-press-logos-{{ section.id }} .product-press-logos__img {
      height: auto;
      max-height: {{ mobile_img_height }}px;
      width: 100%;
      max-width: 100%;
      object-fit: contain;
    }
  }
{%- endstyle -%}

<div class="page-width section-{{ section.id }}-padding">
  <div class="product-press-logos product-press-logos-{{ section.id }}">
    {%- if section.settings.heading != blank -%}
      <p class="product-press-logos__heading">{{ section.settings.heading | escape }}</p>
    {%- endif -%}
    <div class="product-press-logos__row">
      {%- for i in (1..6) -%}
        {%- assign img_key = 'logo_' | append: i | append: '_image' -%}
        {%- assign txt_key = 'logo_' | append: i | append: '_text' -%}
        {%- if section.settings[img_key] != blank or section.settings[txt_key] != blank -%}
          <div class="product-press-logos__item">
            {%- if section.settings[img_key] != blank -%}
              <img
                class="product-press-logos__img"
                src="{{ section.settings[img_key] | image_url: width: 200 }}"
                alt="{{ section.settings[txt_key] | default: '' | escape }}"
                width="{{ section.settings[img_key].width }}"
                height="{{ section.settings[img_key].height }}"
                loading="lazy"
              >
            {%- else -%}
              <span class="product-press-logos__text">{{ section.settings[txt_key] | escape }}</span>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Press Logos",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Encabezado (opcional)",
      "placeholder": "Tal como se vio en:"
    },
    {
      "type": "header",
      "content": "Estilo"
    },
    {
      "type": "range",
      "id": "img_height",
      "label": "Alto de imagen",
      "min": 16,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "Tamaño de texto",
      "min": 10,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 17
    },
    {
      "type": "range",
      "id": "logos_gap",
      "label": "Espacio entre logos",
      "min": 8,
      "max": 64,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "logo_opacity",
      "label": "Opacidad",
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 40
    },
    {
      "type": "range",
      "id": "grayscale",
      "label": "Escala de grises",
      "min": 0,
      "max": 100,
      "step": 10,
      "unit": "%",
      "default": 100
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Color de texto / logos",
      "default": "#1c1c1c"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Color de línea separadora",
      "default": "#e8e8e8"
    },
    {
      "type": "header",
      "content": "Logo 1"
    },
    {
      "type": "image_picker",
      "id": "logo_1_image",
      "label": "Imagen"
    },
    {
      "type": "text",
      "id": "logo_1_text",
      "label": "Texto (si no hay imagen)",
      "default": "MUJERHOY"
    },
    {
      "type": "header",
      "content": "Logo 2"
    },
    {
      "type": "image_picker",
      "id": "logo_2_image",
      "label": "Imagen"
    },
    {
      "type": "text",
      "id": "logo_2_text",
      "label": "Texto (si no hay imagen)",
      "default": "ELLE"
    },
    {
      "type": "header",
      "content": "Logo 3"
    },
    {
      "type": "image_picker",
      "id": "logo_3_image",
      "label": "Imagen"
    },
    {
      "type": "text",
      "id": "logo_3_text",
      "label": "Texto (si no hay imagen)",
      "default": "VOGUE"
    },
    {
      "type": "header",
      "content": "Logo 4"
    },
    {
      "type": "image_picker",
      "id": "logo_4_image",
      "label": "Imagen"
    },
    {
      "type": "text",
      "id": "logo_4_text",
      "label": "Texto (si no hay imagen)",
      "default": "Women's Health"
    },
    {
      "type": "header",
      "content": "Logo 5"
    },
    {
      "type": "image_picker",
      "id": "logo_5_image",
      "label": "Imagen"
    },
    {
      "type": "text",
      "id": "logo_5_text",
      "label": "Texto (si no hay imagen)"
    },
    {
      "type": "header",
      "content": "Logo 6"
    },
    {
      "type": "image_picker",
      "id": "logo_6_image",
      "label": "Imagen"
    },
    {
      "type": "text",
      "id": "logo_6_text",
      "label": "Texto (si no hay imagen)"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading_desktop"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
