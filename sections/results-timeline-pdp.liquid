{%- liquid
  assign timeline_blocks = section.blocks | where: 'type', 'timeline_item'
-%}

{%- style -%}
  .section-{{ section.id }}-padding {
    background-color: {{ section.settings.background_color }};
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }

  #shopify-section-{{ section.id }} .results-timeline__heading {
    color: {{ section.settings.heading_color }};
    font-size: {{ section.settings.heading_font_size_mobile }}px;
  }

  #shopify-section-{{ section.id }} .results-timeline__period,
  #shopify-section-{{ section.id }} .results-timeline__subtitle,
  #shopify-section-{{ section.id }} .results-timeline__bullets {
    color: {{ section.settings.text_color }};
  }

  #shopify-section-{{ section.id }} .results-timeline__period {
    font-size: {{ section.settings.period_font_size_mobile }}px;
    font-weight: {{ section.settings.period_font_weight }};
  }

  #shopify-section-{{ section.id }} .results-timeline__bullets {
    font-size: {{ section.settings.bullets_font_size_mobile }}px;
  }

  #shopify-section-{{ section.id }} .results-timeline__separator {
    position: relative;
    width: 100%;
    height: 1px;
    background-color: {{ section.settings.separator_color }};
  }
  #shopify-section-{{ section.id }} .results-timeline__separator::before,
  #shopify-section-{{ section.id }} .results-timeline__separator::after {
    content: "";
    position: absolute;
    width: 8px;
    height: 8px;
    top: 50%;
    border-radius: 50%;
    background-color: {{ section.settings.separator_color }};
  }
  #shopify-section-{{ section.id }} .results-timeline__separator::before {
    left: 0;
    transform: translate(-50%, -50%);
  }
  #shopify-section-{{ section.id }} .results-timeline__separator::after {
    right: 0;
    transform: translate(50%, -50%);
  }

  #shopify-section-{{ section.id }} .results-timeline__icon {
    width: {{ section.settings.icon_size }}px;
    height: {{ section.settings.icon_size }}px;
    color: {{ section.settings.icon_color }};
    background: linear-gradient(to bottom, {{ section.settings.icon_gradient_start }}, {{ section.settings.icon_gradient_end }});
  }

  @media screen and (min-width: 990px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }

    #shopify-section-{{ section.id }} .results-timeline__heading {
      font-size: {{ section.settings.heading_font_size }}px;
    }

    #shopify-section-{{ section.id }} .results-timeline__period {
      font-size: {{ section.settings.period_font_size }}px;
    }

    #shopify-section-{{ section.id }} .results-timeline__bullets {
      font-size: {{ section.settings.bullets_font_size }}px;
    }
  }
{%- endstyle -%}

<div class="results-timeline section-{{ section.id }}-padding">
  <div class="results-timeline__container">
    {%- if section.settings.heading != blank -%}
      <h2 class="results-timeline__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}

    {%- if timeline_blocks.size > 0 -%}
      <div class="results-timeline__content">
        {%- if section.settings.show_separator -%}
          <div class="results-timeline__separator"></div>
        {%- endif -%}
        <div class="results-timeline__list">
          {%- for block in timeline_blocks -%}
            {%- assign bullet_lines = block.settings.bullets | newline_to_br | split: '<br />' -%}
            {%- assign icon_alt = block.settings.period | default: '' -%}
            <div class="results-timeline__item" {{ block.shopify_attributes }}>
              <div class="results-timeline__item-header">
                <div class="results-timeline__icon">
                  {%- if block.settings.custom_icon != blank -%}
                    {{
                      block.settings.custom_icon
                      | image_url: width: 128
                      | image_tag: loading: 'lazy', width: 64, height: 64, alt: icon_alt
                    }}
                  {%- else -%}
                    {%- render 'results-timeline-icon', icon: block.settings.icon -%}
                  {%- endif -%}
                </div>
                <div class="results-timeline__item-labels">
                  {%- if block.settings.period != blank -%}
                    <span class="results-timeline__period"><p>{{ block.settings.period | escape }}</p></span>
                  {%- endif -%}
                  {%- if block.settings.subtitle != blank -%}
                    <span class="results-timeline__subtitle">{{ block.settings.subtitle | escape }}</span>
                  {%- endif -%}
                </div>
              </div>
              {%- if block.settings.bullets != blank -%}
                <div class="results-timeline__bullets">
                  <ul>
                    {%- for line in bullet_lines -%}
                      {%- assign trimmed_line = line | strip -%}
                      {%- if trimmed_line != blank -%}
                        <li>{{ trimmed_line | escape }}</li>
                      {%- endif -%}
                    {%- endfor -%}
                  </ul>
                </div>
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</div>

{%- style -%}
  .results-timeline {
    width: 100%;
  }
  .results-timeline__container {
    max-width: 1440px;
    margin-inline: auto;
    padding-inline: 16px;
  }
  .results-timeline__heading {
    font-weight: 800;
    text-align: center;
    text-transform: uppercase;
    line-height: 1.2;
    margin: 0 0 24px;
  }
  .results-timeline__content {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .results-timeline__list {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .results-timeline__item {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .results-timeline__item-header {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .results-timeline__icon {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    overflow: hidden;
    padding: 10px;
    box-sizing: border-box;
  }
  .results-timeline__icon img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }
  .results-timeline__item-labels {
    display: flex;
    flex-direction: column;
  }
  .results-timeline__period {
    display: block;
    text-transform: uppercase;
    line-height: 1.44;
  }
  .results-timeline__period p {
    margin: 0;
  }
  .results-timeline__subtitle {
    display: block;
    font-weight: 700;
    font-size: 18px;
    line-height: 1.44;
  }
  .results-timeline__bullets ul {
    list-style: disc;
    padding-left: 21px;
    margin: 0;
  }
  .results-timeline__bullets li {
    line-height: 1.3;
    margin-bottom: 4px;
  }
  .results-timeline__bullets li:last-child {
    margin-bottom: 0;
  }

  @media screen and (min-width: 990px) {
    .results-timeline__container {
      padding-inline: 120px;
    }
    .results-timeline__heading {
      margin-bottom: 40px;
      max-width: 94%;
      margin-left: auto;
      margin-right: auto;
    }
    .results-timeline__list {
      flex-direction: row;
      align-items: flex-start;
      gap: 0;
    }
    .results-timeline__item {
      flex: 1 0 0;
      min-width: 0;
      padding-right: 32px;
    }
    .results-timeline__item:last-child {
      padding-right: 0;
    }
    .results-timeline__bullets ul {
      padding-left: 24px;
    }
    .results-timeline__bullets li {
      margin-bottom: 8px;
    }
  }

  @media screen and (max-width: 375px) {
    .results-timeline__heading {
      font-size: 20px;
    }
  }
{%- endstyle -%}

