{{ 'section-product-review-card.css' | asset_url | stylesheet_tag }}
<link rel="stylesheet" href="{{ 'component-slider.css' | asset_url }}" media="print" onload="this.media='all'">
<noscript>{{ 'component-slider.css' | asset_url | stylesheet_tag }}</noscript>

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }

  #shopify-section-{{ section.id }} {
    --prc-card-bg: {{ section.settings.card_bg }};
    --prc-card-border-color: {{ section.settings.card_border_color }};
    --prc-card-border-width: {{ section.settings.card_border_width }}px;
    --prc-card-radius: {{ section.settings.card_radius }}px;
    --prc-text-color: {{ section.settings.text_color }};
    --prc-author-color: {{ section.settings.author_color }};
    --prc-star-color: {{ section.settings.star_color }};
    --prc-arrow-color: {{ section.settings.arrow_color }};
    --prc-arrow-bg: {{ section.settings.arrow_bg }};
    --prc-avatar-size-mobile: {{ section.settings.avatar_size_mobile }}px;
    --prc-avatar-size: {{ section.settings.avatar_size }}px;
    --prc-text-size-mobile: {{ section.settings.text_size_mobile }}px;
    --prc-text-size: {{ section.settings.text_size }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div
  class="prc color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding"
  {%- if section.settings.section_bg != blank %}
    style="background-color: {{ section.settings.section_bg }};"
  {%- endif %}
>
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <h2 class="prc__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}

    <slider-component class="prc__wrapper">
      <button
        type="button"
        class="prc__arrow slider-button slider-button--prev{% unless section.settings.show_arrows %} prc__arrow--hidden{% endunless %}"
        name="previous"
        aria-label="{{ 'general.slider.previous_slide' | t }}"
      >
        {%- render 'icon-caret' -%}
      </button>

      <ul
        id="Slider-{{ section.id }}"
        class="prc__list slider slider--everywhere"
        role="list"
      >
        {%- for block in section.blocks -%}
          {%- if block.type == 'review' -%}
            <li
              id="Slide-{{ section.id }}-{{ forloop.index }}"
              class="prc__item slider__slide"
              {{ block.shopify_attributes }}
            >
              <div class="prc__card">
                <div class="prc__row-top">
                  <div class="prc__avatar">
                    {%- if block.settings.avatar != blank -%}
                      {{
                        block.settings.avatar
                        | image_url: width: 240
                        | image_tag:
                          loading: 'lazy',
                          width: 120,
                          height: 120,
                          sizes: '120px',
                          alt: block.settings.author | default: ''
                      }}
                    {%- else -%}
                      {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg prc__avatar-placeholder' }}
                    {%- endif -%}
                  </div>
                  {%- if block.settings.text != blank -%}
                    <p class="prc__text">"{{ block.settings.text | escape }}"</p>
                  {%- endif -%}
                </div>
                <div class="prc__footer">
                  {%- if block.settings.author != blank -%}
                    <span class="prc__author">{{ block.settings.author | escape }}</span>
                  {%- endif -%}
                  <div class="prc__stars" aria-label="{{ block.settings.rating }} de 5 estrellas">
                    {%- for i in (1..5) -%}
                      <span class="prc__star{% if i <= block.settings.rating %} prc__star--filled{% endif %}">★</span>
                    {%- endfor -%}
                  </div>
                </div>
              </div>
            </li>
          {%- endif -%}
        {%- else -%}
          <li class="prc__item slider__slide">
            <div class="prc__card">
              <div class="prc__row-top">
                <div class="prc__avatar">
                  {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg prc__avatar-placeholder' }}
                </div>
                <p class="prc__text">"Me sorprendió la cobertura. Con muy poca cantidad pude cubrir las marcas de acné sin que se sintiera pesada."</p>
              </div>
              <div class="prc__footer">
                <span class="prc__author">Laura G.</span>
                <div class="prc__stars">
                  <span class="prc__star prc__star--filled">★</span>
                  <span class="prc__star prc__star--filled">★</span>
                  <span class="prc__star prc__star--filled">★</span>
                  <span class="prc__star prc__star--filled">★</span>
                  <span class="prc__star prc__star--filled">★</span>
                </div>
              </div>
            </div>
          </li>
        {%- endfor -%}
      </ul>

      <button
        type="button"
        class="prc__arrow slider-button slider-button--next{% unless section.settings.show_arrows %} prc__arrow--hidden{% endunless %}"
        name="next"
        aria-label="{{ 'general.slider.next_slide' | t }}"
      >
        {%- render 'icon-caret' -%}
      </button>
    </slider-component>
  </div>
</div>

{% schema %}
{
  "name": "Reseña de producto",
  "class": "section",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Título de la sección",
      "default": "Lo que dicen nuestros clientes"
    },
    {
      "type": "header",
      "content": "Tarjeta"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Color de fondo de la tarjeta",
      "default": "#fff9f6"
    },
    {
      "type": "color",
      "id": "card_border_color",
      "label": "Color del borde",
      "default": "#854700"
    },
    {
      "type": "range",
      "id": "card_border_width",
      "label": "Grosor del borde",
      "min": 0,
      "max": 4,
      "step": 1,
      "unit": "px",
      "default": 1
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Radio de esquinas",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 5
    },
    {
      "type": "header",
      "content": "Texto de la reseña"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Color del texto",
      "default": "#434343"
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "Tamaño de texto (desktop)",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "text_size_mobile",
      "label": "Tamaño de texto (mobile)",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 13
    },
    {
      "type": "color",
      "id": "author_color",
      "label": "Color del nombre del autor",
      "default": "#1e1e1e"
    },
    {
      "type": "color",
      "id": "star_color",
      "label": "Color de las estrellas",
      "default": "#f5a623"
    },
    {
      "type": "header",
      "content": "Avatar (desktop)"
    },
    {
      "type": "range",
      "id": "avatar_size",
      "label": "Tamaño del avatar",
      "min": 50,
      "max": 120,
      "step": 5,
      "unit": "px",
      "default": 90
    },
    {
      "type": "header",
      "content": "Avatar (mobile)"
    },
    {
      "type": "range",
      "id": "avatar_size_mobile",
      "label": "Tamaño del avatar",
      "min": 40,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 60
    },
    {
      "type": "header",
      "content": "Flechas de navegación"
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Mostrar flechas",
      "default": true
    },
    {
      "type": "color",
      "id": "arrow_color",
      "label": "Color de las flechas",
      "default": "#854700"
    },
    {
      "type": "color",
      "id": "arrow_bg",
      "label": "Fondo de las flechas",
      "default": "#fff9f6"
    },
    {
      "type": "header",
      "content": "Fondo de la sección"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "options": [
        { "value": "accent-1", "label": "t:sections.all.colors.accent_1.label" },
        { "value": "accent-2", "label": "t:sections.all.colors.accent_2.label" },
        { "value": "background-1", "label": "t:sections.all.colors.background_1.label" },
        { "value": "background-2", "label": "t:sections.all.colors.background_2.label" },
        { "value": "inverse", "label": "t:sections.all.colors.inverse.label" }
      ],
      "default": "background-1",
      "label": "t:sections.all.colors.label"
    },
    {
      "type": "color",
      "id": "section_bg",
      "label": "Color de fondo personalizado",
      "info": "Sobrescribe el esquema de color."
    },
    {
      "type": "header",
      "content": "Espaciado (desktop)"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding superior",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding inferior",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 36
    },
    {
      "type": "header",
      "content": "Espaciado (mobile)"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding superior",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding inferior",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 24
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Reseña",
      "settings": [
        {
          "type": "textarea",
          "id": "text",
          "label": "Texto de la reseña",
          "default": "Me sorprendió la cobertura. Con muy poca cantidad pude cubrir las marcas de acné sin que se sintiera pesada."
        },
        {
          "type": "image_picker",
          "id": "avatar",
          "label": "Foto del cliente"
        },
        {
          "type": "text",
          "id": "author",
          "label": "Nombre del cliente",
          "default": "Laura G."
        },
        {
          "type": "range",
          "id": "rating",
          "label": "Calificación (estrellas)",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        }
      ]
    }
  ],
  "max_blocks": 20,
  "presets": [
    {
      "name": "Reseña de producto",
      "blocks": [
        {
          "type": "review",
          "settings": {
            "text": "Me sorprendió la cobertura. Con muy poca cantidad pude cubrir las marcas de acné sin que se sintiera pesada.",
            "author": "Laura G.",
            "rating": 5
          }
        },
        {
          "type": "review",
          "settings": {
            "text": "La textura es increíble y huele delicioso. Mi piel quedó hidratada todo el día sin sensación grasosa.",
            "author": "Valentina R.",
            "rating": 5
          }
        },
        {
          "type": "review",
          "settings": {
            "text": "Llevo tres semanas usándolo y ya noto la diferencia en mis manchas. Recomiendo mucho este producto.",
            "author": "Camila S.",
            "rating": 5
          }
        }
      ]
    }
  ]
}
{% endschema %}
