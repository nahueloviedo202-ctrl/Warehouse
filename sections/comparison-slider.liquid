{{ 'section-comparison-slider.css' | asset_url | stylesheet_tag }}
{{ 'component-rte.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

{%- endstyle -%}

{%- liquid
  assign text_block = section.blocks | where: 'type', 'text_content' | first
-%}

<div class="color-{{ section.settings.color_scheme }}"{% if section.settings.background_color != blank %} style="background-color: {{ section.settings.background_color }};"{% endif %}>
  <div class="page-width section-{{ section.id }}-padding">
    <div class="content-and-comparison-slider{% if text_block == blank %} content-and-comparison-slider--no-content{% endif %}">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'text_content' -%}
            {%- liquid
              assign accent_class = 'color-foreground-' | append: block.settings.accent_color_scheme
            -%}
            {% style %}
              .block-{{ block.id }}-heading {
                font-size: {{ block.settings.heading_font_size_mobile }}px;
                {% if block.settings.heading_color != blank %}color: {{ block.settings.heading_color }};{% endif %}
                {% if block.settings.heading_font_weight != blank %}font-weight: {{ block.settings.heading_font_weight }};{% endif %}
              }
              .block-{{ block.id }}-text {
                font-size: {{ block.settings.text_font_size_mobile }}px;
                {% if block.settings.text_color != blank %}color: {{ block.settings.text_color }};{% endif %}
                {% if block.settings.text_font_weight != blank %}font-weight: {{ block.settings.text_font_weight }};{% endif %}
              }
              .block-{{ block.id }}-feature-heading {
                font-size: {{ block.settings.feature_heading_font_size_mobile }}px;
                {% if block.settings.feature_heading_color != blank %}color: {{ block.settings.feature_heading_color }};{% endif %}
                {% if block.settings.feature_heading_font_weight != blank %}font-weight: {{ block.settings.feature_heading_font_weight }};{% endif %}
              }
              .block-{{ block.id }}-feature-text {
                font-size: {{ block.settings.feature_text_font_size_mobile }}px;
                {% if block.settings.feature_text_color != blank %}color: {{ block.settings.feature_text_color }};{% endif %}
                {% if block.settings.feature_text_font_weight != blank %}font-weight: {{ block.settings.feature_text_font_weight }};{% endif %}
              }
              @media screen and (min-width: 750px) {
                .block-{{ block.id }}-heading {
                  font-size: {{ block.settings.heading_font_size_desktop }}px;
                }
                .block-{{ block.id }}-text {
                  font-size: {{ block.settings.text_font_size_desktop }}px;
                }
                .block-{{ block.id }}-feature-heading {
                  font-size: {{ block.settings.feature_heading_font_size_desktop }}px;
                }
                .block-{{ block.id }}-feature-text {
                  font-size: {{ block.settings.feature_text_font_size_desktop }}px;
                }
              }
            {% endstyle %}
            <div
              class="content-container content-and-comparison-slider__content content-and-comparison-slider__content--desktop-{{ block.settings.desktop_content_alignment }} content-and-comparison-slider__content--mobile-{{ block.settings.mobile_content_alignment }}"
              {{ block.shopify_attributes }}
            >
              {%- unless block.settings.title == blank -%}
                <h2 class="title {{ block.settings.heading_size }} {{ accent_class }}{% if block.settings.heading_italic %} comparison-slider__title--italic{% endif %} block-{{ block.id }}-heading">
                  {{ block.settings.title | escape }}
                </h2>
              {%- endunless -%}
              {%- unless block.settings.text == blank -%}
                <div class="block-{{ block.id }}-text">{{ block.settings.text }}</div>
              {%- endunless -%}
              {%- unless block.settings.feature_1_heading == blank and block.settings.feature_1_text == blank -%}
                <div class="comparison-slider__feature">
                  {%- unless block.settings.feature_1_heading == blank -%}
                    <h3 class="comparison-slider__feature-heading h4 {{ accent_class }}{% if block.settings.heading_italic %} comparison-slider__title--italic{% endif %} block-{{ block.id }}-feature-heading">
                      {{ block.settings.feature_1_heading | escape }}
                    </h3>
                  {%- endunless -%}
                  {%- unless block.settings.feature_1_text == blank -%}
                    <div class="comparison-slider__feature-text rte block-{{ block.id }}-feature-text">{{ block.settings.feature_1_text }}</div>
                  {%- endunless -%}
                </div>
              {%- endunless -%}
              {%- unless block.settings.feature_2_heading == blank and block.settings.feature_2_text == blank -%}
                <div class="comparison-slider__feature">
                  {%- unless block.settings.feature_2_heading == blank -%}
                    <h3 class="comparison-slider__feature-heading h4 {{ accent_class }}{% if block.settings.heading_italic %} comparison-slider__title--italic{% endif %} block-{{ block.id }}-feature-heading">
                      {{ block.settings.feature_2_heading | escape }}
                    </h3>
                  {%- endunless -%}
                  {%- unless block.settings.feature_2_text == blank -%}
                    <div class="comparison-slider__feature-text rte block-{{ block.id }}-feature-text">{{ block.settings.feature_2_text }}</div>
                  {%- endunless -%}
                </div>
              {%- endunless -%}
              {% render 'icon-badges', block: block %}
              {%- if block.settings.button_label != blank -%}
                {%- liquid
                  assign btn_style = ''
                  if block.settings.button_bg_color != blank
                    assign btn_style = btn_style | append: 'background-color:' | append: block.settings.button_bg_color | append: ';'
                  endif
                  if block.settings.button_text_color != blank
                    assign btn_style = btn_style | append: 'color:' | append: block.settings.button_text_color | append: ';'
                  endif
                  if block.settings.button_border_radius > 0
                    assign btn_style = btn_style | append: 'border-radius:' | append: block.settings.button_border_radius | append: 'px;'
                  endif
                  if block.settings.button_font_size > 0
                    assign btn_style = btn_style | append: 'font-size:' | append: block.settings.button_font_size | append: 'px;'
                  endif
                  if block.settings.button_font_weight != 'inherit'
                    assign btn_style = btn_style | append: 'font-weight:' | append: block.settings.button_font_weight | append: ';'
                  endif
                  if block.settings.button_padding_v > 0 or block.settings.button_padding_h > 0
                    assign btn_style = btn_style | append: 'padding:' | append: block.settings.button_padding_v | append: 'px ' | append: block.settings.button_padding_h | append: 'px;'
                  endif
                  if block.settings.button_full_width
                    assign btn_style = btn_style | append: 'width:100%;display:block;text-align:center;'
                  endif
                  assign btn_border_width = block.settings.button_border_width
                  if btn_border_width == 0 and block.settings.button_border_color != blank
                    assign btn_border_width = 2
                  endif
                -%}
                {%- if block.settings.button_border_color != blank -%}
                <style>
                  #comparison-btn-{{ block.id }}::after,
                  #comparison-btn-{{ block.id }}:hover::after {
                    box-shadow: 0 0 0 {{ btn_border_width }}px {{ block.settings.button_border_color }};
                  }
                </style>
                {%- endif -%}
                <a
                  id="comparison-btn-{{ block.id }}"
                  {% if block.settings.link %}
                    href="{{ block.settings.link }}"
                  {% else %}
                    role="link" aria-disabled="true"
                  {% endif %}
                  class="button mb-1em comparison-slider__button {% if block.settings.button_style_secondary %}button--secondary{% else %}button--primary{% endif %}"
                  {% if btn_style != '' %}style="{{ btn_style }}"{% endif %}
                >
                  {{- block.settings.button_label | escape -}}
                </a>
              {%- endif -%}
            </div>
          {%- when 'simple_image' -%}
            <div
              class="comparison-simple-image"
              {{ block.shopify_attributes }}
              style="--simple-img-width: {{ block.settings.image_width }}px; --simple-img-height: {{ block.settings.image_height }}px; --simple-img-height-mobile: {{ block.settings.image_height_mobile }}px; --simple-img-fit: {{ block.settings.object_fit }}; --simple-img-border-radius: {{ block.settings.image_border_radius }}px;"
            >
              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: block.settings.image_width | image_tag: loading: 'lazy', alt: block.settings.image_alt }}
              {%- else -%}
                {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </div>
          {%- when 'image_comparison' -%}
            <div class="comparison-slider" {{ block.shopify_attributes }}>
              {% unless block.settings.before_label == blank %}
                <div class="comparison-slider__before-text color-{{ block.settings.labels_color_scheme }}">
                  <h3>{{ block.settings.before_label }}</h3>
                </div>
              {% endunless %}
              <div class="comparison-slider__overlay{% if block.settings.before_image != blank %} color-{{ section.settings.color_scheme }}{% endif %}">
                {%- if block.settings.before_image != blank -%}
                  {{ block.settings.before_image | image_url: width: 1000 | image_tag: loading: 'lazy', width: 450 }}
                {%- endif -%}
              </div>
              <div class="comparison-slider__overlay-under{% if block.settings.after_image != blank %} color-{{ section.settings.color_scheme }}{% endif %}">
                {%- if block.settings.after_image != blank -%}
                  {{ block.settings.after_image | image_url: width: 1000 | image_tag: loading: 'lazy', width: 450 }}
                {%- endif -%}
              </div>
              <div class="comparison-slider__line color-{{ block.settings.line_color }}">
                <div class="comparison-slider__arrow-left color-{{ block.settings.line_color }}"></div>
                <div class="comparison-slider__arrow-right color-{{ block.settings.line_color }}"></div>
              </div>
              <input type="range" class="comparison-slider__input" min="0" max="100" value="50">
              <div class="comparison-slider__underlay">
                {%- if block.settings.after_image != blank -%}
                  {{ block.settings.after_image | image_url: width: 1000 | image_tag: loading: 'lazy', width: 450 }}
                {%- else -%}
                  {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                {%- endif -%}
              </div>
              {% unless block.settings.after_label == blank %}
                <div class="comparison-slider__after-text color-{{ block.settings.labels_color_scheme }}">
                  <h3>{{ block.settings.after_label }}</h3>
                </div>
              {% endunless %}
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</div>

<script>
  document.querySelectorAll('#shopify-section-{{ section.id }} .comparison-slider__button').forEach(function (link) {
    var href = link.getAttribute('href') || '';
    if (href.charAt(0) !== '#' || href.length < 2) return;
    link.addEventListener('click', function (event) {
      var target = document.getElementById(href.slice(1));
      if (!target) return;
      event.preventDefault();
      target.scrollIntoView({ behavior: 'smooth' });
    });
  });
</script>

{% schema %}
{
    "name": "Before & After slider",
    "settings": [
        {
            "type": "select",
            "id": "color_scheme",
            "options": [
            {
                "value": "accent-1",
                "label": "t:sections.all.colors.accent_1.label"
            },
            {
                "value": "accent-2",
                "label": "t:sections.all.colors.accent_2.label"
            },
            {
                "value": "background-1",
                "label": "t:sections.all.colors.background_1.label"
            },
            {
                "value": "background-2",
                "label": "t:sections.all.colors.background_2.label"
            },
            {
                "value": "inverse",
                "label": "t:sections.all.colors.inverse.label"
            }
            ],
            "default": "background-1",
            "label": "t:sections.all.colors.label"
        },
        {
            "type": "color",
            "id": "background_color",
            "label": "Color de fondo personalizado",
            "info": "Sobrescribe el esquema de color de la sección."
        },
        {
        "type": "header",
        "content": "t:sections.all.padding.section_padding_heading_desktop"
        },
        {
        "type": "range",
        "id": "padding_top",
        "min": 0,
        "max": 100,
        "step": 4,
        "unit": "px",
        "label": "t:sections.all.padding.padding_top",
        "default": 36
        },
        {
        "type": "range",
        "id": "padding_bottom",
        "min": 0,
        "max": 100,
        "step": 4,
        "unit": "px",
        "label": "t:sections.all.padding.padding_bottom",
        "default": 36
        },
        {
        "type": "header",
        "content": "t:sections.all.padding.section_padding_heading_mobile"
        },
        {
        "type": "range",
        "id": "padding_top_mobile",
        "min": 0,
        "max": 100,
        "step": 4,
        "unit": "px",
        "label": "t:sections.all.padding.padding_top_mobile",
        "default": 28
        },
        {
        "type": "range",
        "id": "padding_bottom_mobile",
        "min": 0,
        "max": 100,
        "step": 4,
        "unit": "px",
        "label": "t:sections.all.padding.padding_bottom_mobile",
        "default": 28
        }
    ],
    "blocks": [
        {
            "type": "simple_image",
            "name": "Imagen simple",
            "settings": [
                {
                    "type": "image_picker",
                    "id": "image",
                    "label": "Imagen"
                },
                {
                    "type": "text",
                    "id": "image_alt",
                    "label": "Texto alternativo (alt)"
                },
                {
                    "type": "range",
                    "id": "image_width",
                    "min": 100,
                    "max": 1000,
                    "step": 10,
                    "unit": "px",
                    "default": 450,
                    "label": "Ancho máximo"
                },
                {
                    "type": "range",
                    "id": "image_height",
                    "min": 100,
                    "max": 1000,
                    "step": 10,
                    "unit": "px",
                    "default": 600,
                    "label": "Alto (escritorio)"
                },
                {
                    "type": "range",
                    "id": "image_height_mobile",
                    "min": 100,
                    "max": 800,
                    "step": 10,
                    "unit": "px",
                    "default": 400,
                    "label": "Alto (móvil)"
                },
                {
                    "type": "select",
                    "id": "object_fit",
                    "options": [
                        { "value": "cover", "label": "Recortar (cover)" },
                        { "value": "contain", "label": "Contener (contain)" },
                        { "value": "fill", "label": "Estirar (fill)" }
                    ],
                    "default": "cover",
                    "label": "Ajuste de imagen"
                },
                {
                    "type": "range",
                    "id": "image_border_radius",
                    "min": 0,
                    "max": 100,
                    "step": 2,
                    "unit": "px",
                    "default": 0,
                    "label": "Radio del borde (redondeado)"
                }
            ]
        },
        {
            "type": "image_comparison",
            "name": "Bloque: Antes y Después",
            "limit": 1,
            "settings": [
                {
                    "type": "paragraph",
                    "content": "Imagen comparativa deslizable. Arrastra este bloque en la lista para colocarlo antes o después del bloque de texto."
                },
                {
                    "type": "image_picker",
                    "id": "before_image",
                    "label": "Imagen \"Antes\""
                },
                {
                "type": "range",
                    "id": "image_width",
                    "min": 100,
                    "max": 1000,
                    "step": 10,
                    "unit": "px",
                    "default": 450,
                    "label": "Ancho máximo"
                },
                {
                    "type": "range",
                    "id": "image_height",
                    "min": 100,
                    "max": 1000,
                    "step": 10,
                    "unit": "px",
                    "default": 600,
                    "label": "Alto (escritorio)"
                },
                {
                    "type": "range",
                    "id": "image_height_mobile",
                    "min": 100,
                    "max": 800,
                    "step": 10,
                    "unit": "px",
                    "default": 400,
                    "label": "Alto (móvil)"
                },
                {
                    "type": "image_picker",
                    "id": "after_image",
                    "label": "Imagen \"Después\""
                },
                {
                    "type": "text",
                    "id": "before_label",
                    "label": "Etiqueta \"Antes\"",
                    "default": "Antes"
                },
                {
                    "type": "text",
                    "id": "after_label",
                    "label": "Etiqueta \"Después\"",
                    "default": "Después"
                },
                {
                    "type": "select",
                    "id": "labels_color_scheme",
                    "options": [
                    {
                        "value": "accent-1",
                        "label": "t:sections.all.colors.accent_1.label"
                    },
                    {
                        "value": "accent-2",
                        "label": "t:sections.all.colors.accent_2.label"
                    },
                    {
                        "value": "background-1",
                        "label": "t:sections.all.colors.background_1.label"
                    },
                    {
                        "value": "background-2",
                        "label": "t:sections.all.colors.background_2.label"
                    },
                    {
                        "value": "inverse",
                        "label": "t:sections.all.colors.inverse.label"
                    }
                    ],
                    "default": "accent-1",
                    "label": "Color de las etiquetas"
                },
                {
                    "type": "select",
                    "id": "line_color",
                    "options": [
                    {
                        "value": "accent-1",
                        "label": "t:sections.all.colors.accent_1.label"
                    },
                    {
                        "value": "accent-2",
                        "label": "t:sections.all.colors.accent_2.label"
                    },
                    {
                        "value": "background-1",
                        "label": "t:sections.all.colors.background_1.label"
                    },
                    {
                        "value": "background-2",
                        "label": "t:sections.all.colors.background_2.label"
                    },
                    {
                        "value": "inverse",
                        "label": "t:sections.all.colors.inverse.label"
                    }
