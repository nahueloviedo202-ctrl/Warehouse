                    "label": "Color de la línea separadora"
                }
            ]
        },
        {
            "type": "text_content",
            "name": "Contenido de texto",
            "limit": 1,
            "settings": [
                {
                    "type": "paragraph",
                    "content": "Arrastra este bloque en la lista para colocarlo antes o después del bloque de imagen comparativa."
                },
