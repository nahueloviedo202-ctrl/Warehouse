{{ 'section-cambios-reales.css' | asset_url | stylesheet_tag }}
<link rel="stylesheet" href="{{ 'component-slider.css' | asset_url }}" media="print" onload="this.media='all'">
<noscript>{{ 'component-slider.css' | asset_url | stylesheet_tag }}</noscript>

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }

  #shopify-section-{{ section.id }} {
    --cr-heading-color: {{ section.settings.heading_color }};
    --cr-subheading-color: {{ section.settings.subheading_color }};
    --cr-card-bg: {{ section.settings.card_background_color }};
    --cr-border-color: {{ section.settings.card_border_color }};
    --cr-border-width: {{ section.settings.card_border_width }}px;
    --cr-radius: {{ section.settings.card_corner_radius }}px;
    --cr-text-color: {{ section.settings.text_color }};
    --cr-author-color: {{ section.settings.author_color }};
    --cr-star-color: {{ section.settings.star_color }};
    --cr-arrow-color-desktop: {{ section.settings.arrows_color_desktop }};
    --cr-arrow-bg-desktop: {{ section.settings.arrows_bg_color_desktop }};
    --cr-arrow-border-desktop: {{ section.settings.arrows_border_color_desktop }};
    --cr-arrow-color-mobile: {{ section.settings.arrows_color_mobile }};
    --cr-arrow-bg-mobile: {{ section.settings.arrows_bg_color_mobile }};
    --cr-arrow-border-mobile: {{ section.settings.arrows_border_color_mobile }};
    --cr-gap: {{ section.settings.card_gap }}px;
    --cr-cards-desktop: {{ section.settings.cards_per_row_desktop }};
    --cr-cards-tablet: {{ section.settings.cards_per_row_tablet }};
    --cr-cards-mobile: {{ section.settings.cards_per_row_mobile }};
    --cr-image-height-desktop: {{ section.settings.image_height_desktop }}px;
    --cr-image-height-mobile: {{ section.settings.image_height_mobile }}px;
  }

  .section-{{ section.id }}-image {
    height: {{ section.settings.image_height_mobile }}px;
  }

  .section-{{ section.id }}-heading {
    font-size: {{ section.settings.heading_font_size_mobile }}px;
  }

  .section-{{ section.id }}-subheading {
    font-size: {{ section.settings.subheading_font_size_mobile }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }

    .section-{{ section.id }}-heading {
      font-size: {{ section.settings.heading_font_size_desktop }}px;
    }

    .section-{{ section.id }}-subheading {
      font-size: {{ section.settings.subheading_font_size_desktop }}px;
    }

    .section-{{ section.id }}-image {
      height: {{ section.settings.image_height_desktop }}px;
    }
  }

  {% unless section.settings.show_arrows_desktop %}
    @media screen and (min-width: 750px) {
      #shopify-section-{{ section.id }} .cambios-reales__arrow { display: none; }
    }
  {% endunless %}
  {% unless section.settings.show_arrows_mobile %}
    @media screen and (max-width: 749px) {
      #shopify-section-{{ section.id }} .cambios-reales__arrow { display: none; }
    }
  {% endunless %}
{%- endstyle -%}

<div
  class="cambios-reales section-{{ section.id }}-padding"
  style="background-color: {{ section.settings.background_color }};"
>
  <div class="page-width">

    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="cambios-reales__heading-wrapper">
        {%- if section.settings.heading != blank -%}
          <h2 class="cambios-reales__heading section-{{ section.id }}-heading">
            {{ section.settings.heading | escape }}
          </h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="cambios-reales__subheading section-{{ section.id }}-subheading">
            {{ section.settings.subheading | escape }}
          </p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <slider-component class="cambios-reales__wrapper">

      <button
        type="button"
        class="cambios-reales__arrow cambios-reales__arrow--prev slider-button slider-button--prev"
        name="previous"
        aria-label="{{ 'general.slider.previous_slide' | t }}"
      >
        <svg viewBox="0 0 16 16" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
          <path d="M10 3L6 8L10 13" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>

      <ul
        id="Slider-{{ section.id }}"
        class="cambios-reales__list slider slider--everywhere"
        role="list"
      >
        {%- for block in section.blocks -%}
          <li
            id="Slide-{{ section.id }}-{{ forloop.index }}"
            class="cambios-reales__item slider__slide"
            {{ block.shopify_attributes }}
          >
            <div class="cambios-reales__card">

              {%- if block.settings.image != blank -%}
                <div class="cambios-reales__image-block section-{{ section.id }}-image">
                  {{
                    block.settings.image
                    | image_url: width: 800
                    | image_tag:
                      class: 'cambios-reales__img',
                      loading: 'lazy',
                      widths: '400, 600, 800',
                      sizes: '(min-width: 990px) calc((100vw - 13rem) / 3), (min-width: 750px) calc((100vw - 10rem) / 2), calc(100vw - 5rem)'
                  }}
                </div>
              {%- else -%}
                <div class="cambios-reales__image-placeholder section-{{ section.id }}-image">
                  {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                </div>
              {%- endif -%}

              {%- if block.settings.text != blank -%}
                <p class="cambios-reales__text">{{ block.settings.text | escape }}</p>
              {%- endif -%}

              <div class="cambios-reales__footer">
                {%- if block.settings.author != blank -%}
                  <p class="cambios-reales__author">{{ block.settings.author | escape }}</p>
                {%- endif -%}

                <div class="cambios-reales__stars" aria-label="Calificación: {{ block.settings.rating }} de 5 estrellas">
                  {%- for i in (1..5) -%}
                    <span class="cambios-reales__star{% if i <= block.settings.rating %} cambios-reales__star--filled{% endif %}" aria-hidden="true">
                      <svg viewBox="0 0 14 14" xmlns="http://www.w3.org/2000/svg">
                        <path d="M7 1L8.854 5.17H13.364L9.755 7.779L11.109 12L7 9.301L2.891 12L4.245 7.779L0.636 5.17H5.146L7 1Z"/>
                      </svg>
                    </span>
                  {%- endfor -%}
                </div>
              </div>

            </div>
          </li>
        {%- else -%}
          {%- for i in (1..3) -%}
            <li class="cambios-reales__item slider__slide">
              <div class="cambios-reales__card">
                <div class="cambios-reales__image-placeholder section-{{ section.id }}-image">
                  {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                </div>
                <p class="cambios-reales__text">Agrega bloques de reseña para mostrar opiniones de tus clientes.</p>
                <div class="cambios-reales__footer">
                  <p class="cambios-reales__author">Cliente</p>
                  <div class="cambios-reales__stars">
                    {%- for i in (1..5) -%}
                      <span class="cambios-reales__star cambios-reales__star--filled" aria-hidden="true">
                        <svg viewBox="0 0 14 14" xmlns="http://www.w3.org/2000/svg">
                          <path d="M7 1L8.854 5.17H13.364L9.755 7.779L11.109 12L7 9.301L2.891 12L4.245 7.779L0.636 5.17H5.146L7 1Z"/>
                        </svg>
                      </span>
                    {%- endfor -%}
                  </div>
                </div>
              </div>
            </li>
          {%- endfor -%}
        {%- endfor -%}
      </ul>

      <button
        type="button"
        class="cambios-reales__arrow cambios-reales__arrow--next slider-button slider-button--next"
        name="next"
        aria-label="{{ 'general.slider.next_slide' | t }}"
      >
        <svg viewBox="0 0 16 16" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
          <path d="M6 3L10 8L6 13" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>

    </slider-component>

  </div>
</div>

{% schema %}
{
  "name": "Cambios reales",
  "class": "section",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Encabezado"
    },
    {
      "type": "text",
      "id": "heading",
      "default": "Cambios reales",
      "label": "Título"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Color del título",
      "default": "#070809"
    },
    {
      "type": "range",
      "id": "heading_font_size_desktop",
      "min": 16,
      "max": 72,
      "step": 1,
      "unit": "px",
      "label": "Tamaño del titulo escritorio",
      "default": 36
    },
    {
      "type": "range",
      "id": "heading_font_size_mobile",
      "min": 14,
      "max": 48,
      "step": 1,
      "unit": "px",
      "label": "Tamaño del titulo movil",
      "default": 36
    },
    {
      "type": "text",
      "id": "subheading",
      "default": "Más que una base",
      "label": "Subtítulo"
    },
    {
      "type": "color",
      "id": "subheading_color",
      "label": "Color del subtítulo",
      "default": "#4a3329"
    },
    {
      "type": "range",
      "id": "subheading_font_size_desktop",
      "min": 12,
      "max": 36,
      "step": 1,
      "unit": "px",
      "label": "Tamaño del subtitulo escritorio",
      "default": 20
    },
    {
      "type": "range",
      "id": "subheading_font_size_mobile",
      "min": 12,
      "max": 28,
      "step": 1,
      "unit": "px",
      "label": "Tamaño del subtitulo movil",
      "default": 20
    },
    {
      "type": "header",
      "content": "Imagen de la tarjeta"
    },
    {
      "type": "range",
      "id": "image_height_desktop",
      "min": 150,
      "max": 500,
      "step": 10,
      "unit": "px",
      "label": "Alto de la imagen escritorio",
      "default": 350
    },
    {
      "type": "range",
      "id": "image_height_mobile",
      "min": 120,
      "max": 400,
      "step": 10,
      "unit": "px",
      "label": "Alto de la imagen movil",
      "default": 300
    },
    {
      "type": "header",
      "content": "Tarjetas"
    },
    {
      "type": "color",
      "id": "card_background_color",
      "label": "Color de fondo de la tarjeta",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "card_border_color",
      "label": "Color del borde",
      "default": "#854700"
    },
    {
      "type": "range",
      "id": "card_border_width",
      "min": 0,
      "max": 6,
      "step": 1,
      "unit": "px",
      "default": 1,
      "label": "Grosor del borde"
    },
    {
      "type": "range",
      "id": "card_corner_radius",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 5,
      "label": "Redondeo de esquinas"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Color del texto de la reseña",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "author_color",
      "label": "Color del nombre del autor",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "star_color",
      "label": "Color de las estrellas",
      "default": "#f5a623"
    },
    {
      "type": "header",
      "content": "Diseño del slider"
    },
    {
      "type": "range",
      "id": "cards_per_row_desktop",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 3,
      "label": "Tarjetas visibles escritorio"
    },
    {
      "type": "range",
      "id": "cards_per_row_tablet",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 2,
      "label": "Tarjetas visibles tablet"
    },
    {
      "type": "range",
      "id": "cards_per_row_mobile",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 1,
      "label": "Tarjetas visibles movil"
    },
    {
      "type": "range",
      "id": "card_gap",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 10,
      "label": "Espacio entre tarjetas"
    },
    {
      "type": "header",
      "content": "Flechas de navegación"
    },
    {
      "type": "checkbox",
      "id": "show_arrows_desktop",
      "default": true,
      "label": "Mostrar flechas escritorio"
    },
    {
      "type": "checkbox",
      "id": "show_arrows_mobile",
      "default": true,
      "label": "Mostrar flechas movil"
    },
    {
      "type": "header",
      "content": "Flecha - Escritorio"
    },
    {
      "type": "color",
      "id": "arrows_color_desktop",
      "label": "Color del icono",
      "default": "#854700"
    },
    {
      "type": "color",
      "id": "arrows_bg_color_desktop",
      "label": "Color de fondo",
      "default": "#f1e9e3"
    },
    {
      "type": "color",
      "id": "arrows_border_color_desktop",
      "label": "Color de borde",
      "default": "#f1e9e3"
    },
    {
      "type": "header",
      "content": "Flecha - Movil"
    },
    {
      "type": "color",
      "id": "arrows_color_mobile",
      "label": "Color del icono",
      "default": "#854700"
    },
    {
      "type": "color",
      "id": "arrows_bg_color_mobile",
      "label": "Color de fondo",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "arrows_border_color_mobile",
      "label": "Color de borde",
      "default": "#854700"
    },
    {
      "type": "header",
      "content": "Fondo de la sección"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Color de fondo",
      "default": "#f1e9e3"
    },
    {
      "type": "header",
      "content": "Espaciado escritorio"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Padding superior",
      "default": 30
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Padding inferior",
      "default": 40
    },
    {
      "type": "header",
      "content": "Espaciado movil"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Padding superior",
      "default": 30
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Padding inferior",
      "default": 30
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Reseña con imagen",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Imagen (antes/después)"
        },
        {
          "type": "textarea",
          "id": "text",
          "default": "La usé para cubrir un tatuaje y quedé sorprendida. Con poca cantidad logré una cobertura excelente y en las fotos se veía completamente natural.",
          "label": "Texto de la reseña"
        },
        {
          "type": "text",
          "id": "author",
          "default": "María D.",
          "label": "Nombre del cliente"
        },
        {
          "type": "range",
          "id": "rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5,
          "label": "Calificación (estrellas)"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Cambios reales",
      "blocks": [
        {
          "type": "review",
          "settings": {
            "text": "La usé para cubrir un tatuaje y quedé sorprendida. Con poca cantidad logré una cobertura excelente y en las fotos se veía completamente natural.",
            "author": "María D.",
            "rating": 5
          }
        },
        {
          "type": "review",
          "settings": {
            "text": "Me daba miedo que no encontrara mi tono, pero quedó perfecto. La textura es ligera, se difumina fácil.",
            "author": "Sofía P.",
            "rating": 5
          }
        },
        {
          "type": "review",
          "settings": {
            "text": "Tengo marcas de acné muy pronunciadas. Esta base unifica el tono de mi piel sin dejar efecto máscara.",
            "author": "Camila M.",
            "rating": 5
          }
        }
      ]
    }
  ]
}
{% endschema %}
