{{ 'section-custom-image-footer.css' | asset_url | stylesheet_tag }}

{%- assign overlay_r = section.settings.overlay_color | color_extract: 'red' -%}
{%- assign overlay_g = section.settings.overlay_color | color_extract: 'green' -%}
{%- assign overlay_b = section.settings.overlay_color | color_extract: 'blue' -%}
{%- assign overlay_a = section.settings.overlay_opacity | divided_by: 100.0 -%}

{%- style -%}
  .cif-footer--{{ section.id }} {
    min-height: {{ section.settings.min_height | times: 0.7 | round: 0 }}px;
    border-radius: {{ section.settings.top_radius }}px {{ section.settings.top_radius }}px 0 0;
  }

  .cif-footer--{{ section.id }} .cif-footer__inner {
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    padding-left: {{ section.settings.padding_horizontal_mobile }}px;
    padding-right: {{ section.settings.padding_horizontal_mobile }}px;
  }

  .cif-footer--{{ section.id }} .cif-footer__logo {
    width: {{ section.settings.logo_width_mobile }}px;
    max-width: 60%;
  }

  .cif-footer--{{ section.id }} .cif-footer__brand {
    font-size: {{ section.settings.brand_size_mobile }}px;
  }

  .cif-footer--{{ section.id }} .cif-footer__col-heading {
    font-size: {{ section.settings.heading_size_mobile }}px;
  }

  .cif-footer--{{ section.id }} .cif-footer__link {
    font-size: {{ section.settings.link_size_mobile }}px;
  }

  .cif-footer--{{ section.id }} .cif-footer__copyright,
  .cif-footer--{{ section.id }} .cif-footer__copyright small {
    font-size: {{ section.settings.copyright_size_mobile }}px;
  }

  @media screen and (min-width: 750px) {
    .cif-footer--{{ section.id }} {
      min-height: {{ section.settings.min_height }}px;
    }

    .cif-footer--{{ section.id }} .cif-footer__inner {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
      padding-left: {{ section.settings.padding_horizontal }}px;
      padding-right: {{ section.settings.padding_horizontal }}px;
    }

    .cif-footer--{{ section.id }} .cif-footer__logo {
      width: {{ section.settings.logo_width }}px;
      max-width: 40%;
    }

    .cif-footer--{{ section.id }} .cif-footer__brand {
      font-size: {{ section.settings.brand_size }}px;
    }

    .cif-footer--{{ section.id }} .cif-footer__col-heading {
      font-size: {{ section.settings.heading_size }}px;
    }

    .cif-footer--{{ section.id }} .cif-footer__link {
      font-size: {{ section.settings.link_size }}px;
    }

    .cif-footer--{{ section.id }} .cif-footer__copyright,
    .cif-footer--{{ section.id }} .cif-footer__copyright small {
      font-size: {{ section.settings.copyright_size }}px;
    }
  }
{%- endstyle -%}

<footer class="cif-footer cif-footer--{{ section.id }}" style="--cif-overlay-color: rgba({{ overlay_r }}, {{ overlay_g }}, {{ overlay_b }}, {{ overlay_a }});">

  <div class="cif-footer__bg">
    {%- if section.settings.background_image != blank -%}
      {{
        section.settings.background_image
        | image_url: width: 2400
        | image_tag:
          loading: 'lazy',
          widths: '750, 1100, 1500, 1780, 2000, 2400',
          class: 'cif-footer__bg-img',
          alt: section.settings.background_image.alt | escape
      }}
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'cif-footer__bg-img placeholder-svg' }}
    {%- endif -%}
  </div>

  <div class="cif-footer__inner">

    <div class="cif-footer__header">
      {%- if section.settings.logo_image != blank -%}
        <div class="cif-footer__logo">
          {{
            section.settings.logo_image
            | image_url: width: section.settings.logo_width
            | image_tag:
              loading: 'lazy',
              widths: '80, 120, 150, 200, 250, 300, 400',
              alt: section.settings.logo_image.alt | default: shop.name | escape
          }}
        </div>
      {%- elsif section.settings.brand_name != blank -%}
        <span class="cif-footer__brand">{{ section.settings.brand_name }}</span>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <nav class="cif-footer__nav" aria-label="{{ 'general.footer.footer_menu_label' | t | default: 'Footer' }}">
        {%- for block in section.blocks -%}
          {%- if block.type == 'link_list' -%}
            <div class="cif-footer__col" {{ block.shopify_attributes }}>
              {%- if block.settings.heading != blank -%}
                <h3 class="cif-footer__col-heading">{{ block.settings.heading | escape }}</h3>
              {%- endif -%}
              {%- if block.settings.menu != blank -%}
                <ul class="cif-footer__col-links">
                  {%- for link in block.settings.menu.links -%}
                    <li>
                      <a
                        href="{{ link.url }}"
                        class="cif-footer__link{% if link.active %} cif-footer__link--active{% endif %}"
                        {% if link.active %}aria-current="page"{% endif %}
                      >
                        {{ link.title }}
                      </a>
                    </li>
                  {%- endfor -%}
                </ul>
              {%- endif -%}
            </div>
          {%- elsif block.type == 'custom_links' -%}
            <div class="cif-footer__col" {{ block.shopify_attributes }}>
              {%- if block.settings.heading != blank -%}
                <h3 class="cif-footer__col-heading">{{ block.settings.heading | escape }}</h3>
              {%- endif -%}
              <ul class="cif-footer__col-links">
                {%- for i in (1..6) -%}
                  {%- assign link_label = 'link_' | append: i | append: '_label' -%}
                  {%- assign link_url = 'link_' | append: i | append: '_url' -%}
                  {%- assign link_label_value = block.settings[link_label] -%}
                  {%- assign link_url_value = block.settings[link_url] -%}
                  {%- if link_label_value != blank -%}
                    <li>
                      <a href="{{ link_url_value | default: '#' }}" class="cif-footer__link">
                        {{ link_label_value }}
                      </a>
                    </li>
                  {%- endif -%}
                {%- endfor -%}
              </ul>
            </div>
          {%- elsif block.type == 'text' -%}
            <div class="cif-footer__col" {{ block.shopify_attributes }}>
              {%- if block.settings.heading != blank -%}
                <h3 class="cif-footer__col-heading">{{ block.settings.heading | escape }}</h3>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <div class="cif-footer__col-text">{{ block.settings.text }}</div>
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </nav>
    {%- else -%}
      <div class="cif-footer__nav"></div>
    {%- endif -%}

    <div class="cif-footer__bottom">
      <div class="cif-footer__copyright">
        {%- if section.settings.copyright_text != blank -%}
          <small>&copy; {{ 'now' | date: '%Y' }}, {{ section.settings.copyright_text }}</small>
        {%- else -%}
          <small>&copy; {{ 'now' | date: '%Y' }}, {{ shop.name | link_to: routes.root_url }}</small>
        {%- endif -%}
      </div>

      {%- if section.settings.show_payment -%}
        {%- assign has_icons = false -%}
        {%- if section.settings.pay_visa or section.settings.pay_master or section.settings.pay_amex or section.settings.pay_paypal or section.settings.pay_apple or section.settings.pay_google or section.settings.pay_shop or section.settings.pay_discover or section.settings.pay_diners or section.settings.pay_maestro or section.settings.pay_jcb or section.settings.pay_klarna -%}
          {%- assign has_icons = true -%}
        {%- endif -%}
        {%- if has_icons -%}
          <div class="cif-footer__payment">
            <ul class="cif-footer__payment-list" role="list">
              {%- if section.settings.pay_visa -%}<li>{{ 'visa' | payment_type_svg_tag: class: 'icon icon--full-color' }}</li>{%- endif -%}
              {%- if section.settings.pay_master -%}<li>{{ 'master' | payment_type_svg_tag: class: 'icon icon--full-color' }}</li>{%- endif -%}
              {%- if section.settings.pay_amex -%}<li>{{ 'american_express' | payment_type_svg_tag: class: 'icon icon--full-color' }}</li>{%- endif -%}
              {%- if section.settings.pay_paypal -%}<li>{{ 'paypal' | payment_type_svg_tag: class: 'icon icon--full-color' }}</li>{%- endif -%}
              {%- if section.settings.pay_apple -%}<li>{{ 'apple_pay' | payment_type_svg_tag: class: 'icon icon--full-color' }}</li>{%- endif -%}
              {%- if section.settings.pay_google -%}<li>{{ 'google_pay' | payment_type_svg_tag: class: 'icon icon--full-color' }}</li>{%- endif -%}
              {%- if section.settings.pay_shop -%}<li>{{ 'shopify_pay' | payment_type_svg_tag: class: 'icon icon--full-color' }}</li>{%- endif -%}
              {%- if section.settings.pay_discover -%}<li>{{ 'discover' | payment_type_svg_tag: class: 'icon icon--full-color' }}</li>{%- endif -%}
              {%- if section.settings.pay_diners -%}<li>{{ 'diners_club' | payment_type_svg_tag: class: 'icon icon--full-color' }}</li>{%- endif -%}
              {%- if section.settings.pay_maestro -%}<li>{{ 'maestro' | payment_type_svg_tag: class: 'icon icon--full-color' }}</li>{%- endif -%}
              {%- if section.settings.pay_jcb -%}<li>{{ 'jcb' | payment_type_svg_tag: class: 'icon icon--full-color' }}</li>{%- endif -%}
              {%- if section.settings.pay_klarna -%}<li>{{ 'klarna' | payment_type_svg_tag: class: 'icon icon--full-color' }}</li>{%- endif -%}
            </ul>
          </div>
        {%- endif -%}
      {%- endif -%}
    </div>

  </div>
</footer>

