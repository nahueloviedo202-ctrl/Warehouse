      <path d="M3 9 L9 4.5 L20 4.5 L14 9 Z"/>
      <path d="M14 9 L20 4.5 L20 16 L14 20 Z"/>
      <rect x="5" y="13" width="4" height="4"/>
      <line x1="10" y1="18" x2="10" y2="12"/>
      <polyline points="8.5,13.5 10,12 11.5,13.5"/>
    </svg>
  {%- else -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="width:100%;height:100%;display:block;">
      <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/>
