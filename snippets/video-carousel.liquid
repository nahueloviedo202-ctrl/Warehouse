{%- comment -%}
  Renders a responsive autoplay video carousel for the product information area,
  matching a "see it in action" style block: a heading followed by a sneak-peek
  carousel of short vertical videos.

  Accepts:
  - block: {Object} block of type 'video_carousel'
{%- endcomment -%}
{{ 'component-video-carousel.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign video_count = 0
  for i in (1..4)
    assign video_key = 'video_' | append: i
    if block.settings[video_key] != blank
      assign video_count = video_count | plus: 1
    endif
  endfor
-%}

{%- if video_count > 0 -%}
  <div
    class="video-carousel color-{{ block.settings.color_scheme }}"
    style="
      --vc-items-desktop: {{ block.settings.items_desktop }};
      --vc-items-mobile: {{ block.settings.items_mobile }};
      --vc-gap: {{ block.settings.gap }}px;
      --vc-radius: {{ block.settings.corner_radius }}px;
      --vc-aspect: {{ block.settings.aspect_ratio }};
      --vc-heading-font-size-desktop: {{ block.settings.heading_font_size_desktop }}px;
      --vc-heading-font-size-mobile: {{ block.settings.heading_font_size_mobile }}px;
    "
    {{ block.shopify_attributes }}
  >
    {%- if block.settings.heading != blank -%}
      <h2 class="video-carousel__heading {{ block.settings.heading_size }}" style="{% if block.settings.heading_color != blank %}color: {{ block.settings.heading_color }};{% endif %}{% if block.settings.heading_weight != blank %}font-weight: {{ block.settings.heading_weight }};{% endif %}">
        {{ block.settings.heading | escape }}
      </h2>
    {%- endif -%}

    <slider-component class="video-carousel__wrapper">
      <ul id="Slider-{{ block.id }}" class="video-carousel__track" role="list">
        {%- for i in (1..4) -%}
          {%- assign video_key = 'video_' | append: i -%}
          {%- assign poster_key = 'poster_' | append: i -%}
          {%- assign video_url = block.settings[video_key] -%}
          {%- assign poster = block.settings[poster_key] -%}
          {%- if video_url != blank -%}
            <li
              id="Slide-{{ block.id }}-{{ forloop.index }}"
              class="video-carousel__slide"
              role="group"
              aria-roledescription="{{ 'sections.slideshow.slide' | t }}"
              aria-label="{{ forloop.index }} {{ 'general.slider.of' | t }} {{ video_count }}"
              tabindex="-1"
            >
              <div class="video-carousel__media">
                <video
                  class="video-carousel__video"
                  src="{{ video_url }}"
                  {%- if poster != blank %}
                    poster="{{ poster | image_url: width: 800 }}"
                  {%- endif %}
                  muted
                  autoplay
                  loop
                  playsinline
                  preload="metadata"
                  {%- if block.settings.show_controls %}
                    controls
                  {%- endif %}
                ></video>
              </div>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>

      {%- if block.settings.show_arrows and video_count > 1 -%}
        <button type="button" class="video-carousel__button video-carousel__button--prev" name="previous">
          <span class="visually-hidden">{{ 'general.slider.previous_slide' | t }}</span>
          {%- render 'icon-caret' -%}
        </button>
        <button type="button" class="video-carousel__button video-carousel__button--next" name="next">
          <span class="visually-hidden">{{ 'general.slider.next_slide' | t }}</span>
          {%- render 'icon-caret' -%}
        </button>
      {%- endif -%}
    </slider-component>
  </div>
{%- endif -%}
